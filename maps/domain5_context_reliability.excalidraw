eId":null,"roundness":{"type":3},"seed":119,"version":1,"versionNonce":120,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-121","type":"text","x":16,"y":552,"width":670,"height":24,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":122,"version":1,"versionNonce":123,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"Sidebar 'Flashcards' section","rawText":"Sidebar 'Flashcards' section","fontSize":12.5,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":12.5,"containerId":null,"originalText":"Sidebar 'Flashcards' section","lineHeight":1.25},{"id":"t-124","type":"text","x":700,"y":552,"width":980,"height":24,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":125,"version":1,"versionNonce":126,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"Flashcards at the bottom (37 cards) — compare with the official course flashcards","rawText":"Flashcards at the bottom (37 cards) — compare with your course's own flashcards","fontSize":12.5,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":12.5,"containerId":null,"originalText":"Flashcards at the bottom (37 cards) — compare with the official course flashcards","lineHeight":1.25},{"id":"t-127","type":"text","x":1700,"y":552,"width":620,"height":24,"angle":0,"strokeColor":"#b4590c","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":128,"version":1,"versionNonce":129,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"These are built from the study guide, not from the official course cards","rawText":"Mine are built from the guide, not from your course's cards","fontSize":12.5,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":12.5,"containerId":null,"originalText":"These are built from the study guide, not from the official course cards","lineHeight":1.25},{"id":"r-130","type":"rectangle","x":0,"y":584,"width":2340,"height":44,"angle":0,"strokeColor":"#c7d2e8","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":131,"version":1,"versionNonce":132,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-133","type":"text","x":16,"y":596,"width":670,"height":24,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":134,"version":1,"versionNonce":135,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"Numbers to verify in your course","rawText":"Numbers to verify in your course","fontSize":12.5,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":12.5,"containerId":null,"originalText":"Numbers to verify in your course","lineHeight":1.25},{"id":"t-136","type":"text","x":700,"y":596,"width":980,"height":24,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":137,"version":1,"versionNonce":138,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"/compact auto-fires ≈95% of 200K window · ~2% stratified audit sample · 40+ fields vs ~5 · ≈200 vs ≈50K tokens examples","rawText":"/compact auto-fires ≈95% of 200K window · ~2% stratified audit sample · 40+ fields vs ~5 · ≈200 vs ≈50K tokens examples","fontSize":12.5,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":12.5,"containerId":null,"originalText":"/compact auto-fires ≈95% of 200K window · ~2% stratified audit sample · 40+ fields vs ~5 · ≈200 vs ≈50K tokens examples","lineHeight":1.25},{"id":"t-139","type":"text","x":1700,"y":596,"width":620,"height":24,"angle":0,"strokeColor":"#b4590c","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":140,"version":1,"versionNonce":141,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"Illustrative figures from the guide","rawText":"Illustrative figures from the guide","fontSize":12.5,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":12.5,"containerId":null,"originalText":"Illustrative figures from the guide","lineHeight":1.25},{"id":"t-142","type":"text","x":0,"y":658,"width":2400,"height":36,"angle":0,"strokeColor":"#0f3d8a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":143,"version":1,"versionNonce":144,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"CORE CONCEPTS — FULL DEPTH","rawText":"CORE CONCEPTS — FULL DEPTH","fontSize":26,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":26,"containerId":null,"originalText":"CORE CONCEPTS — FULL DEPTH","lineHeight":1.25},{"id":"r-145","type":"rectangle","x":0,"y":706,"width":1150,"height":424.36,"angle":0,"strokeColor":"#2457c5","backgroundColor":"#f1f3f9","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":146,"version":1,"versionNonce":147,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-148","type":"text","x":16,"y":718,"width":1118,"height":24,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":149,"version":1,"versionNonce":150,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"01 · 5.1 — WHY CONTEXT GOES WRONG: LOSSY SUMMARIES, LOST IN THE MIDDLE, STATELESS API","rawText":"01 · 5.1 — WHY CONTEXT GOES WRONG: LOSSY SUMMARIES, LOST IN THE MIDDLE, STATELESS API","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":18,"containerId":null,"originalText":"01 · 5.1 — WHY CONTEXT GOES WRONG: LOSSY SUMMARIES, LOST IN THE MIDDLE, STATELESS API","lineHeight":1.25},{"id":"t-151","type":"text","x":16,"y":750,"width":1118,"height":360.36,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":152,"version":1,"versionNonce":153,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"THE API IS STATELESS: Claude remembers nothing between calls. You resend the full conversation history every turn. Silently trimming earlier turns destroys\ncoherence.\n\nPROGRESSIVE SUMMARIZATION = LOSSY. Compressing history turns PRECISE values into vague paraphrases. The usual casualties: amounts, percentages, dates, order\nnumbers, and what the customer said they expected. 'Refund of $127.45 requested on Oct 3' becomes 'customer wants a refund'.\n\n★ 'LOST IN THE MIDDLE' (Liu et al., 2024): models use information at the START and END of a long input reliably, but may omit what sits in the MIDDLE.\nAnthropic's long-context guidance agrees.\n\nCONTEXT ROT: accuracy falls as raw token count grows. A bigger window is NOT the fix; curation is.\n\nWHAT TO REMEMBER:\n• Precise facts must live somewhere summarization can't touch (panel 02).\n• Verbose tool output must be trimmed before it enters history (panel 03).\n• Put key findings at the START of long inputs, under explicit section headers.\n\nEXAMPLE: After 30 turns, a rolling summary says 'customer was upset about a late order'. The $127.45 amount and the Oct 3 date are gone, so the agent now\nquotes the wrong refund.\n\nEXAM TELLS: 'agent forgets amounts/dates after a long conversation' → pin facts in a case-facts block, not a better summary. 'accuracy drops on long inputs'\n→ curate, don't just enlarge the window.","rawText":"THE API IS STATELESS: Claude remembers nothing between calls. You resend the full conversation history every turn. Silently trimming earlier turns destroys\ncoherence.\n\nPROGRESSIVE SUMMARIZATION = LOSSY. Compressing history turns PRECISE values into vague paraphrases. The usual casualties: amounts, percentages, dates, order\nnumbers, and what the customer said they expected. 'Refund of $127.45 requested on Oct 3' becomes 'customer wants a refund'.\n\n★ 'LOST IN THE MIDDLE' (Liu et al., 2024): models use information at the START and END of a long input reliably, but may omit what sits in the MIDDLE.\nAnthropic's long-context guidance agrees.\n\nCONTEXT ROT: accuracy falls as raw token count grows. A bigger window is NOT the fix; curation is.\n\nWHAT TO REMEMBER:\n• Precise facts must live somewhere summarization can't touch (panel 02).\n• Verbose tool output must be trimmed before it enters history (panel 03).\n• Put key findings at the START of long inputs, under explicit section headers.\n\nEXAMPLE: After 30 turns, a rolling summary says 'customer was upset about a late order'. The $127.45 amount and the Oct 3 date are gone, so the agent now\nquotes the wrong refund.\n\nEXAM TELLS: 'agent forgets amounts/dates after a long conversation' → pin facts in a case-facts block, not a better summary. 'accuracy drops on long inputs'\n→ curate, don't just enlarge the window.","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"THE API IS STATELESS: Claude remembers nothing between calls. You resend the full conversation history every turn. Silently trimming earlier turns destroys\ncoherence.\n\nPROGRESSIVE SUMMARIZATION = LOSSY. Compressing history turns PRECISE values into vague paraphrases. The usual casualties: amounts, percentages, dates, order\nnumbers, and what the customer said they expected. 'Refund of $127.45 requested on Oct 3' becomes 'customer wants a refund'.\n\n★ 'LOST IN THE MIDDLE' (Liu et al., 2024): models use information at the START and END of a long input reliably, but may omit what sits in the MIDDLE.\nAnthropic's long-context guidance agrees.\n\nCONTEXT ROT: accuracy falls as raw token count grows. A bigger window is NOT the fix; curation is.\n\nWHAT TO REMEMBER:\n• Precise facts must live somewhere summarization can't touch (panel 02).\n• Verbose tool output must be trimmed before it enters history (panel 03).\n• Put key findings at the START of long inputs, under explicit section headers.\n\nEXAMPLE: After 30 turns, a rolling summary says 'customer was upset about a late order'. The $127.45 amount and the Oct 3 date are gone, so the agent now\nquotes the wrong refund.\n\nEXAM TELLS: 'agent forgets amounts/dates after a long conversation' → pin facts in a case-facts block, not a better summary. 'accuracy drops on long inputs'\n→ curate, don't just enlarge the window.","lineHeight":1.25},{"id":"r-154","type":"rectangle","x":1190,"y":706,"width":1150,"height":407.2,"angle":0,"strokeColor":"#2457c5","backgroundColor":"#f1f3f9","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":155,"version":1,"versionNonce":156,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-157","type":"text","x":1206,"y":718,"width":1118,"height":24,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":158,"version":1,"versionNonce":159,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"02 · 5.1 — PATTERN: THE CASE-FACTS BLOCK","rawText":"02 · 5.1 — PATTERN: THE CASE-FACTS BLOCK","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":18,"containerId":null,"originalText":"02 · 5.1 — PATTERN: THE CASE-FACTS BLOCK","lineHeight":1.25},{"id":"t-160","type":"text","x":1206,"y":750,"width":1118,"height":343.2,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":161,"version":1,"versionNonce":162,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"WHAT: a separate, structured, APPEND-ONLY record of VERIFIED facts that rides along with every prompt, OUTSIDE the summarized history.\n\nWHAT GOES IN IT: case and customer IDs (and how each was verified) · order records (status, totals, dates) · the customer's stated expectations kept\nVERBATIM with the turn they were stated · policy decisions with approval status · open questions.\n\nHOW IT BEHAVES:\n• Sits at the TOP of the user message on EVERY turn, under a header marking it authoritative and not to be summarized.\n• Changes only when a new VERIFIED fact is added. The model never rewrites it.\n\n★ WHY AT THE TOP: (1) start-of-context recall beats the middle (lost-in-the-middle); (2) PROMPT CACHING needs stable content BEFORE volatile content (render\norder: tools → system → messages), and an append-only block is a good cache target.\n\nCONNECTS TO DOMAIN 1: the verified customer ID from the identity-verification hook lands in this block, so every downstream tool call uses a verified value.\n\nEXAMPLE: Case facts — customer C-1042 (verified via hook, turn 2) · order 88213 shipped Oct 3, total $127.45 · customer expectation (turn 4, verbatim): 'I\nwant the refund before Friday' · policy: refund approved up to $500.\n\nEXAM TRAPS: 'a rolling summary that rewrites numbers, dates or quotes' · 'trim earlier turns to save tokens'. Pin facts instead.\n\nEXAM TELLS: 'precise values lost across a long conversation' → case-facts block included in every prompt.","rawText":"WHAT: a separate, structured, APPEND-ONLY record of VERIFIED facts that rides along with every prompt, OUTSIDE the summarized history.\n\nWHAT GOES IN IT: case and customer IDs (and how each was verified) · order records (status, totals, dates) · the customer's stated expectations kept\nVERBATIM with the turn they were stated · policy decisions with approval status · open questions.\n\nHOW IT BEHAVES:\n• Sits at the TOP of the user message on EVERY turn, under a header marking it authoritative and not to be summarized.\n• Changes only when a new VERIFIED fact is added. The model never rewrites it.\n\n★ WHY AT THE TOP: (1) start-of-context recall beats the middle (lost-in-the-middle); (2) PROMPT CACHING needs stable content BEFORE volatile content (render\norder: tools → system → messages), and an append-only block is a good cache target.\n\nCONNECTS TO DOMAIN 1: the verified customer ID from the identity-verification hook lands in this block, so every downstream tool call uses a verified value.\n\nEXAMPLE: Case facts — customer C-1042 (verified via hook, turn 2) · order 88213 shipped Oct 3, total $127.45 · customer expectation (turn 4, verbatim): 'I\nwant the refund before Friday' · policy: refund approved up to $500.\n\nEXAM TRAPS: 'a rolling summary that rewrites numbers, dates or quotes' · 'trim earlier turns to save tokens'. Pin facts instead.\n\nEXAM TELLS: 'precise values lost across a long conversation' → case-facts block included in every prompt.","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"WHAT: a separate, structured, APPEND-ONLY record of VERIFIED facts that rides along with every prompt, OUTSIDE the summarized history.\n\nWHAT GOES IN IT: case and customer IDs (and how each was verified) · order records (status, totals, dates) · the customer's stated expectations kept\nVERBATIM with the turn they were stated · policy decisions with approval status · open questions.\n\nHOW IT BEHAVES:\n• Sits at the TOP of the user message on EVERY turn, under a header marking it authoritative and not to be summarized.\n• Changes only when a new VERIFIED fact is added. The model never rewrites it.\n\n★ WHY AT THE TOP: (1) start-of-context recall beats the middle (lost-in-the-middle); (2) PROMPT CACHING needs stable content BEFORE volatile content (render\norder: tools → system → messages), and an append-only block is a good cache target.\n\nCONNECTS TO DOMAIN 1: the verified customer ID from the identity-verification hook lands in this block, so every downstream tool call uses a verified value.\n\nEXAMPLE: Case facts — customer C-1042 (verified via hook, turn 2) · order 88213 shipped Oct 3, total $127.45 · customer expectation (turn 4, verbatim): 'I\nwant the refund before Friday' · policy: refund approved up to $500.\n\nEXAM TRAPS: 'a rolling summary that rewrites numbers, dates or quotes' · 'trim earlier turns to save tokens'. Pin facts instead.\n\nEXAM TELLS: 'precise values lost across a long conversation' → case-facts block included in every prompt.","lineHeight":1.25},{"id":"r-163","type":"rectangle","x":0,"y":1158.3600000000001,"width":1150,"height":407.2,"angle":0,"strokeColor":"#2457c5","backgroundColor":"#f1f3f9","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":164,"version":1,"versionNonce":165,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-166","type":"text","x":16,"y":1170.3600000000001,"width":1118,"height":24,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":167,"version":1,"versionNonce":168,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"03 · 5.1 — TRIM TOOL OUTPUT, ORDER THE INPUT, KEEP SUBAGENT METADATA","rawText":"03 · 5.1 — TRIM TOOL OUTPUT, ORDER THE INPUT, KEEP SUBAGENT METADATA","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":18,"containerId":null,"originalText":"03 · 5.1 — TRIM TOOL OUTPUT, ORDER THE INPUT, KEEP SUBAGENT METADATA","lineHeight":1.25},{"id":"t-169","type":"text","x":16,"y":1202.3600000000001,"width":1118,"height":343.2,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":170,"version":1,"versionNonce":171,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"★ TRIM TOOL OUTPUT AT THE WRAPPER. One order lookup can return 40+ fields when only ~5 matter. Normalize each tool response to the fields downstream\nreasoning actually uses — e.g., order ID, status, delivery date, total, item count, returnable flag — and drop addresses, audit logs, internal flags,\nwarehouse metadata.\n\nWHY IN THE WRAPPER: once verbose output is in history it CANNOT be removed. Trim before it enters.\n\nAGGREGATED INPUTS: put KEY FINDINGS FIRST, under explicit section headers (counters lost-in-the-middle).\n\nSUBAGENTS: require them to return structured outputs WITH metadata — dates, source locations, methodology — so the coordinator can reason and cite later\n(links to 5.6).\n\nWHEN DOWNSTREAM CONTEXT IS TIGHT: have upstream agents return STRUCTURED DATA, not long reasoning chains.\n\nANTI-PATTERN: treating a bigger CLAUDE.md or lots of @imports as a context-saving move. They EXPAND context. Use scratchpads, subagent isolation and path-\nscoped rules instead (Domain 3).\n\nEXAMPLE: lookup_order returns 43 fields. The wrapper returns 6. The conversation stays small and the model stays accurate.\n\nEXAM TELLS: 'tool results are huge and accuracy falls' → trim at the wrapper. 'summary at the end of a long input is ignored' → move key findings to the\ntop.","rawText":"★ TRIM TOOL OUTPUT AT THE WRAPPER. One order lookup can return 40+ fields when only ~5 matter. Normalize each tool response to the fields downstream\nreasoning actually uses — e.g., order ID, status, delivery date, total, item count, returnable flag — and drop addresses, audit logs, internal flags,\nwarehouse metadata.\n\nWHY IN THE WRAPPER: once verbose output is in history it CANNOT be removed. Trim before it enters.\n\nAGGREGATED INPUTS: put KEY FINDINGS FIRST, under explicit section headers (counters lost-in-the-middle).\n\nSUBAGENTS: require them to return structured outputs WITH metadata — dates, source locations, methodology — so the coordinator can reason and cite later\n(links to 5.6).\n\nWHEN DOWNSTREAM CONTEXT IS TIGHT: have upstream agents return STRUCTURED DATA, not long reasoning chains.\n\nANTI-PATTERN: treating a bigger CLAUDE.md or lots of @imports as a context-saving move. They EXPAND context. Use scratchpads, subagent isolation and path-\nscoped rules instead (Domain 3).\n\nEXAMPLE: lookup_order returns 43 fields. The wrapper returns 6. The conversation stays small and the model stays accurate.\n\nEXAM TELLS: 'tool results are huge and accuracy falls' → trim at the wrapper. 'summary at the end of a long input is ignored' → move key findings to the\ntop.","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"★ TRIM TOOL OUTPUT AT THE WRAPPER. One order lookup can return 40+ fields when only ~5 matter. Normalize each tool response to the fields downstream\nreasoning actually uses — e.g., order ID, status, delivery date, total, item count, returnable flag — and drop addresses, audit logs, internal flags,\nwarehouse metadata.\n\nWHY IN THE WRAPPER: once verbose output is in history it CANNOT be removed. Trim before it enters.\n\nAGGREGATED INPUTS: put KEY FINDINGS FIRST, under explicit section headers (counters lost-in-the-middle).\n\nSUBAGENTS: require them to return structured outputs WITH metadata — dates, source locations, methodology — so the coordinator can reason and cite later\n(links to 5.6).\n\nWHEN DOWNSTREAM CONTEXT IS TIGHT: have upstream agents return STRUCTURED DATA, not long reasoning chains.\n\nANTI-PATTERN: treating a bigger CLAUDE.md or lots of @imports as a context-saving move. They EXPAND context. Use scratchpads, subagent isolation and path-\nscoped rules instead (Domain 3).\n\nEXAMPLE: lookup_order returns 43 fields. The wrapper returns 6. The conversation stays small and the model stays accurate.\n\nEXAM TELLS: 'tool results are huge and accuracy falls' → trim at the wrapper. 'summary at the end of a long input is ignored' → move key findings to the\ntop.","lineHeight":1.25},{"id":"r-172","type":"rectangle","x":1190,"y":1158.3600000000001,"width":1150,"height":407.2,"angle":0,"strokeColor":"#2457c5","backgroundColor":"#f1f3f9","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":173,"version":1,"versionNonce":174,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-175","type":"text","x":1206,"y":1170.3600000000001,"width":1118,"height":24,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":176,"version":1,"versionNonce":177,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"04 · 5.2 — WHEN TO ESCALATE: THE FOUR LEGITIMATE TRIGGERS","rawText":"04 · 5.2 — WHEN TO ESCALATE: THE FOUR LEGITIMATE TRIGGERS","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":18,"containerId":null,"originalText":"04 · 5.2 — WHEN TO ESCALATE: THE FOUR LEGITIMATE TRIGGERS","lineHeight":1.25},{"id":"t-178","type":"text","x":1206,"y":1202.3600000000001,"width":1118,"height":343.2,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":179,"version":1,"versionNonce":180,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"FOUR TRIGGERS (memorize):\n1) EXPLICIT CUSTOMER REQUEST for a human.\n2) POLICY EXCEPTION or POLICY GAP. ('Complex case' alone does NOT qualify.)\n3) INABILITY TO MAKE MEANINGFUL PROGRESS.\n4) MULTI-MATCH AMBIGUITY that needs more identifiers (panel 05).\n\n★ IMMEDIATE vs OFFERED:\n• Customer EXPLICITLY demands a human → escalate IMMEDIATELY, without investigating first.\n• Customer is FRUSTRATED but the case is straightforward → acknowledge the frustration, OFFER to resolve, and escalate only if they REPEAT the demand.\n\nPOLICY GAP EXAMPLE: a customer asks for a competitor price-match, but the policy only covers the company's own-site adjustments. The policy is silent →\nescalate; don't improvise.\n\nSKILLS TESTED: write explicit escalation criteria + few-shot examples (Domain 4.1/4.2) · honor explicit human requests immediately · escalate on policy\nambiguity.\n\nEXAMPLE: 'Let me talk to a person.' → hand off now. 'This is ridiculous, my package is late!' (tracking shows it's just delayed) → apologize, offer to fix,\ndon't auto-escalate.\n\nEXAM TELLS: 'customer asks for a human' → immediate. 'policy doesn't cover this' → escalate. 'angry but simple' → acknowledge and offer.","rawText":"FOUR TRIGGERS (memorize):\n1) EXPLICIT CUSTOMER REQUEST for a human.\n2) POLICY EXCEPTION or POLICY GAP. ('Complex case' alone does NOT qualify.)\n3) INABILITY TO MAKE MEANINGFUL PROGRESS.\n4) MULTI-MATCH AMBIGUITY that needs more identifiers (panel 05).\n\n★ IMMEDIATE vs OFFERED:\n• Customer EXPLICITLY demands a human → escalate IMMEDIATELY, without investigating first.\n• Customer is FRUSTRATED but the case is straightforward → acknowledge the frustration, OFFER to resolve, and escalate only if they REPEAT the demand.\n\nPOLICY GAP EXAMPLE: a customer asks for a competitor price-match, but the policy only covers the company's own-site adjustments. The policy is silent →\nescalate; don't improvise.\n\nSKILLS TESTED: write explicit escalation criteria + few-shot examples (Domain 4.1/4.2) · honor explicit human requests immediately · escalate on policy\nambiguity.\n\nEXAMPLE: 'Let me talk to a person.' → hand off now. 'This is ridiculous, my package is late!' (tracking shows it's just delayed) → apologize, offer to fix,\ndon't auto-escalate.\n\nEXAM TELLS: 'customer asks for a human' → immediate. 'policy doesn't cover this' → escalate. 'angry but simple' → acknowledge and offer.","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"FOUR TRIGGERS (memorize):\n1) EXPLICIT CUSTOMER REQUEST for a human.\n2) POLICY EXCEPTION or POLICY GAP. ('Complex case' alone does NOT qualify.)\n3) INABILITY TO MAKE MEANINGFUL PROGRESS.\n4) MULTI-MATCH AMBIGUITY that needs more identifiers (panel 05).\n\n★ IMMEDIATE vs OFFERED:\n• Customer EXPLICITLY demands a human → escalate IMMEDIATELY, without investigating first.\n• Customer is FRUSTRATED but the case is straightforward → acknowledge the frustration, OFFER to resolve, and escalate only if they REPEAT the demand.\n\nPOLICY GAP EXAMPLE: a customer asks for a competitor price-match, but the policy only covers the company's own-site adjustments. The policy is silent →\nescalate; don't improvise.\n\nSKILLS TESTED: write explicit escalation criteria + few-shot examples (Domain 4.1/4.2) · honor explicit human requests immediately · escalate on policy\nambiguity.\n\nEXAMPLE: 'Let me talk to a person.' → hand off now. 'This is ridiculous, my package is late!' (tracking shows it's just delayed) → apologize, offer to fix,\ndon't auto-escalate.\n\nEXAM TELLS: 'customer asks for a human' → immediate. 'policy doesn't cover this' → escalate. 'angry but simple' → acknowledge and offer.","lineHeight":1.25},{"id":"r-181","type":"rectangle","x":0,"y":1593.5600000000002,"width":1150,"height":424.36,"angle":0,"strokeColor":"#2457c5","backgroundColor":"#f1f3f9","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":182,"version":1,"versionNonce":183,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-184","type":"text","x":16,"y":1605.5600000000002,"width":1118,"height":24,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":185,"version":1,"versionNonce":186,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"05 · 5.2 — BAD PROXIES, AMBIGUITY HANDLING, HANDOFF, THE DECISION TREE","rawText":"05 · 5.2 — BAD PROXIES, AMBIGUITY HANDLING, HANDOFF, THE DECISION TREE","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":18,"containerId":null,"originalText":"05 · 5.2 — BAD PROXIES, AMBIGUITY HANDLING, HANDOFF, THE DECISION TREE","lineHeight":1.25},{"id":"t-187","type":"text","x":16,"y":1637.5600000000002,"width":1118,"height":360.36,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":188,"version":1,"versionNonce":189,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"★ TWO UNRELIABLE PROXIES (don't route on them):\n• SENTIMENT: frustration ≠ complexity. An angry customer may have an easy problem; a calm one may have a policy gap.\n• SELF-REPORTED CONFIDENCE: the model is confidently wrong on exactly the hard cases you most want to catch.\n(Sample Question 3's wrong answers: sentiment-based escalation, confidence scores, a separate classifier. Right answer: explicit criteria + few-shot\nexamples.)\n\nMULTI-MATCH AMBIGUITY: a lookup returns several plausible customers/orders. ASK FOR ADDITIONAL IDENTIFIERS. Never pick a match heuristically.\n\nHANDOFF SUMMARY: when escalating on a policy gap or stalled progress, pass the human a summary: CASE FACTS (panel 02), WHAT WAS TRIED, and the AMBIGUITY.\n\nDECISION TREE:\n• Explicit human request → escalate immediately.\n• Policy gap/exception → escalate with a handoff summary.\n• Unsure / multiple plausible matches → request identifiers.\n• No meaningful progress → escalate with what was tried.\n• Frustration alone → acknowledge + offer, don't escalate.\n• Otherwise → keep resolving.\n\nEXAMPLE: two customers named 'J. Patel' match. The agent asks 'can you confirm the email or order number?' instead of guessing.\n\nEXAM TELLS: 'sentiment score triggers escalation' → trap. 'two records match' → ask for identifiers.","rawText":"★ TWO UNRELIABLE PROXIES (don't route on them):\n• SENTIMENT: frustration ≠ complexity. An angry customer may have an easy problem; a calm one may have a policy gap.\n• SELF-REPORTED CONFIDENCE: the model is confidently wrong on exactly the hard cases you most want to catch.\n(Sample Question 3's wrong answers: sentiment-based escalation, confidence scores, a separate classifier. Right answer: explicit criteria + few-shot\nexamples.)\n\nMULTI-MATCH AMBIGUITY: a lookup returns several plausible customers/orders. ASK FOR ADDITIONAL IDENTIFIERS. Never pick a match heuristically.\n\nHANDOFF SUMMARY: when escalating on a policy gap or stalled progress, pass the human a summary: CASE FACTS (panel 02), WHAT WAS TRIED, and the AMBIGUITY.\n\nDECISION TREE:\n• Explicit human request → escalate immediately.\n• Policy gap/exception → escalate with a handoff summary.\n• Unsure / multiple plausible matches → request identifiers.\n• No meaningful progress → escalate with what was tried.\n• Frustration alone → acknowledge + offer, don't escalate.\n• Otherwise → keep resolving.\n\nEXAMPLE: two customers named 'J. Patel' match. The agent asks 'can you confirm the email or order number?' instead of guessing.\n\nEXAM TELLS: 'sentiment score triggers escalation' → trap. 'two records match' → ask for identifiers.","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"★ TWO UNRELIABLE PROXIES (don't route on them):\n• SENTIMENT: frustration ≠ complexity. An angry customer may have an easy problem; a calm one may have a policy gap.\n• SELF-REPORTED CONFIDENCE: the model is confidently wrong on exactly the hard cases you most want to catch.\n(Sample Question 3's wrong answers: sentiment-based escalation, confidence scores, a separate classifier. Right answer: explicit criteria + few-shot\nexamples.)\n\nMULTI-MATCH AMBIGUITY: a lookup returns several plausible customers/orders. ASK FOR ADDITIONAL IDENTIFIERS. Never pick a match heuristically.\n\nHANDOFF SUMMARY: when escalating on a policy gap or stalled progress, pass the human a summary: CASE FACTS (panel 02), WHAT WAS TRIED, and the AMBIGUITY.\n\nDECISION TREE:\n• Explicit human request → escalate immediately.\n• Policy gap/exception → escalate with a handoff summary.\n• Unsure / multiple plausible matches → request identifiers.\n• No meaningful progress → escalate with what was tried.\n• Frustration alone → acknowledge + offer, don't escalate.\n• Otherwise → keep resolving.\n\nEXAMPLE: two customers named 'J. Patel' match. The agent asks 'can you confirm the email or order number?' instead of guessing.\n\nEXAM TELLS: 'sentiment score triggers escalation' → trap. 'two records match' → ask for identifiers.","lineHeight":1.25},{"id":"r-190","type":"rectangle","x":1190,"y":1593.5600000000002,"width":1150,"height":390.04,"angle":0,"strokeColor":"#2457c5","backgroundColor":"#f1f3f9","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":191,"version":1,"versionNonce":192,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-193","type":"text","x":1206,"y":1605.5600000000002,"width":1118,"height":24,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":194,"version":1,"versionNonce":195,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"06 · 5.3 — STRUCTURED ERROR CONTEXT: THE ERROR ENVELOPE","rawText":"06 · 5.3 — STRUCTURED ERROR CONTEXT: THE ERROR ENVELOPE","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":18,"containerId":null,"originalText":"06 · 5.3 — STRUCTURED ERROR CONTEXT: THE ERROR ENVELOPE","lineHeight":1.25},{"id":"t-196","type":"text","x":1206,"y":1637.5600000000002,"width":1118,"height":326.04,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":197,"version":1,"versionNonce":198,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"WHY: when a subagent fails, the coordinator needs enough information to RECOVER. A generic 'search unavailable' hides everything it needs.\n\nTHE ENVELOPE (structured error) carries:\n• status: error · failure type (e.g., timeout) · is-transient flag.\n• which agent failed.\n• an 'attempted' block: the query, the timeout setting, the retry count.\n• PARTIAL RESULTS gathered so far.\n• ALTERNATIVES the coordinator could try: a shorter query, a different subagent, or proceed with partial data while annotating the gap.\n• a coverage-gap description.\n\n★ SAMPLE QUESTION 8 LOGIC: Option A (structured envelope) is right because it lets the coordinator recover. B ('search unavailable after retries') hides\nwhat was attempted. C marks an empty result as success, destroying recoverability. D kills subagents that succeeded.\n\nLINK TO DOMAIN 2: same idea as structured MCP errors (errorCategory, isRetryable) — a distinct, informative failure beats a generic one.\n\nEXAMPLE: {status:error, failure_type:timeout, transient:true, agent:market-search, attempted:{query:'EV battery market share 2025', timeout_s:30,\nretries:2}, partial_results:[...3 items...], alternatives:['shorter query','use news-search subagent']}.\n\nEXAM TELLS: 'coordinator can't decide how to recover' → structured error with attempted query, partial results, alternatives.","rawText":"WHY: when a subagent fails, the coordinator needs enough information to RECOVER. A generic 'search unavailable' hides everything it needs.\n\nTHE ENVELOPE (structured error) carries:\n• status: error · failure type (e.g., timeout) · is-transient flag.\n• which agent failed.\n• an 'attempted' block: the query, the timeout setting, the retry count.\n• PARTIAL RESULTS gathered so far.\n• ALTERNATIVES the coordinator could try: a shorter query, a different subagent, or proceed with partial data while annotating the gap.\n• a coverage-gap description.\n\n★ SAMPLE QUESTION 8 LOGIC: Option A (structured envelope) is right because it lets the coordinator recover. B ('search unavailable after retries') hides\nwhat was attempted. C marks an empty result as success, destroying recoverability. D kills subagents that succeeded.\n\nLINK TO DOMAIN 2: same idea as structured MCP errors (errorCategory, isRetryable) — a distinct, informative failure beats a generic one.\n\nEXAMPLE: {status:error, failure_type:timeout, transient:true, agent:market-search, attempted:{query:'EV battery market share 2025', timeout_s:30,\nretries:2}, partial_results:[...3 items...], alternatives:['shorter query','use news-search subagent']}.\n\nEXAM TELLS: 'coordinator can't decide how to recover' → structured error with attempted query, partial results, alternatives.","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"WHY: when a subagent fails, the coordinator needs enough information to RECOVER. A generic 'search unavailable' hides everything it needs.\n\nTHE ENVELOPE (structured error) carries:\n• status: error · failure type (e.g., timeout) · is-transient flag.\n• which agent failed.\n• an 'attempted' block: the query, the timeout setting, the retry count.\n• PARTIAL RESULTS gathered so far.\n• ALTERNATIVES the coordinator could try: a shorter query, a different subagent, or proceed with partial data while annotating the gap.\n• a coverage-gap description.\n\n★ SAMPLE QUESTION 8 LOGIC: Option A (structured envelope) is right because it lets the coordinator recover. B ('search unavailable after retries') hides\nwhat was attempted. C marks an empty result as success, destroying recoverability. D kills subagents that succeeded.\n\nLINK TO DOMAIN 2: same idea as structured MCP errors (errorCategory, isRetryable) — a distinct, informative failure beats a generic one.\n\nEXAMPLE: {status:error, failure_type:timeout, transient:true, agent:market-search, attempted:{query:'EV battery market share 2025', timeout_s:30,\nretries:2}, partial_results:[...3 items...], alternatives:['shorter query','use news-search subagent']}.\n\nEXAM TELLS: 'coordinator can't decide how to recover' → structured error with attempted query, partial results, alternatives.","lineHeight":1.25},{"id":"r-199","type":"rectangle","x":0,"y":2045.92,"width":1150,"height":407.2,"angle":0,"strokeColor":"#2457c5","backgroundColor":"#f1f3f9","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":200,"version":1,"versionNonce":201,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-202","type":"text","x":16,"y":2057.92,"width":1118,"height":24,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":203,"version":1,"versionNonce":204,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"07 · 5.3 — ACCESS FAILURE vs EMPTY RESULT, LOCAL RECOVERY, ANTI-PATTERNS","rawText":"07 · 5.3 — ACCESS FAILURE vs EMPTY RESULT, LOCAL RECOVERY, ANTI-PATTERNS","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":18,"containerId":null,"originalText":"07 · 5.3 — ACCESS FAILURE vs EMPTY RESULT, LOCAL RECOVERY, ANTI-PATTERNS","lineHeight":1.25},{"id":"t-205","type":"text","x":16,"y":2089.92,"width":1118,"height":343.2,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":206,"version":1,"versionNonce":207,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"★ ACCESS FAILURE vs VALID EMPTY RESULT:\n• ACCESS FAILURE (timeout, permission denial, 5xx) → the query didn't run properly → RETRY candidate. failure type: access.\n• VALID EMPTY RESULT → the query SUCCEEDED and nothing matched → status ok with an empty results list → NOT an error, do NOT retry. Treating it as an error\nwastes work.\n\nLOCAL RECOVERY vs PROPAGATION:\n• Subagents retry TRANSIENT failures THEMSELVES — typically one or two attempts with backoff.\n• Only UNRECOVERABLE failures go UP to the coordinator, always with the attempted query and partial results.\n\nSYNTHESIS COVERAGE ANNOTATIONS: the final output sorts claims into WELL-SUPPORTED, PARTIALLY SUPPORTED (e.g., one analyst note) and GAPS (e.g., an uncovered\nindustry).\n\n★ ANTI-PATTERNS:\n• Silently suppressing errors — returning empty results as success when the call actually failed.\n• Terminating the WHOLE workflow because one subagent failed.\n\nEXAMPLE: a regional-news subagent times out. It retries twice, then returns an error envelope with partial results. The coordinator proceeds with the other\nsources and labels the region a coverage gap.\n\nEXAM TELLS: 'search found nothing' → valid empty, not an error. 'one subagent timed out' → recover/propagate with context; don't kill the run or hide it.","rawText":"★ ACCESS FAILURE vs VALID EMPTY RESULT:\n• ACCESS FAILURE (timeout, permission denial, 5xx) → the query didn't run properly → RETRY candidate. failure type: access.\n• VALID EMPTY RESULT → the query SUCCEEDED and nothing matched → status ok with an empty results list → NOT an error, do NOT retry. Treating it as an error\nwastes work.\n\nLOCAL RECOVERY vs PROPAGATION:\n• Subagents retry TRANSIENT failures THEMSELVES — typically one or two attempts with backoff.\n• Only UNRECOVERABLE failures go UP to the coordinator, always with the attempted query and partial results.\n\nSYNTHESIS COVERAGE ANNOTATIONS: the final output sorts claims into WELL-SUPPORTED, PARTIALLY SUPPORTED (e.g., one analyst note) and GAPS (e.g., an uncovered\nindustry).\n\n★ ANTI-PATTERNS:\n• Silently suppressing errors — returning empty results as success when the call actually failed.\n• Terminating the WHOLE workflow because one subagent failed.\n\nEXAMPLE: a regional-news subagent times out. It retries twice, then returns an error envelope with partial results. The coordinator proceeds with the other\nsources and labels the region a coverage gap.\n\nEXAM TELLS: 'search found nothing' → valid empty, not an error. 'one subagent timed out' → recover/propagate with context; don't kill the run or hide it.","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"★ ACCESS FAILURE vs VALID EMPTY RESULT:\n• ACCESS FAILURE (timeout, permission denial, 5xx) → the query didn't run properly → RETRY candidate. failure type: access.\n• VALID EMPTY RESULT → the query SUCCEEDED and nothing matched → status ok with an empty results list → NOT an error, do NOT retry. Treating it as an error\nwastes work.\n\nLOCAL RECOVERY vs PROPAGATION:\n• Subagents retry TRANSIENT failures THEMSELVES — typically one or two attempts with backoff.\n• Only UNRECOVERABLE failures go UP to the coordinator, always with the attempted query and partial results.\n\nSYNTHESIS COVERAGE ANNOTATIONS: the final output sorts claims into WELL-SUPPORTED, PARTIALLY SUPPORTED (e.g., one analyst note) and GAPS (e.g., an uncovered\nindustry).\n\n★ ANTI-PATTERNS:\n• Silently suppressing errors — returning empty results as success when the call actually failed.\n• Terminating the WHOLE workflow because one subagent failed.\n\nEXAMPLE: a regional-news subagent times out. It retries twice, then returns an error envelope with partial results. The coordinator proceeds with the other\nsources and labels the region a coverage gap.\n\nEXAM TELLS: 'search found nothing' → valid empty, not an error. 'one subagent timed out' → recover/propagate with context; don't kill the run or hide it.","lineHeight":1.25},{"id":"r-208","type":"rectangle","x":1190,"y":2045.92,"width":1150,"height":407.2,"angle":0,"strokeColor":"#2457c5","backgroundColor":"#f1f3f9","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":209,"version":1,"versionNonce":210,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-211","type":"text","x":1206,"y":2057.92,"width":1118,"height":24,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":212,"version":1,"versionNonce":213,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"08 · 5.4 — CONTEXT IN BIG CODEBASES: DEGRADATION, SUBAGENT ISOLATION, SCRATCHPADS","rawText":"08 · 5.4 — CONTEXT IN BIG CODEBASES: DEGRADATION, SUBAGENT ISOLATION, SCRATCHPADS","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":18,"containerId":null,"originalText":"08 · 5.4 — CONTEXT IN BIG CODEBASES: DEGRADATION, SUBAGENT ISOLATION, SCRATCHPADS","lineHeight":1.25},{"id":"t-214","type":"text","x":1206,"y":2089.92,"width":1118,"height":343.2,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":215,"version":1,"versionNonce":216,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"CONTEXT DEGRADATION: in long exploration sessions the model gives inconsistent answers and falls back on 'TYPICAL PATTERNS' instead of the specific classes\nit found earlier.\n\n★ SUBAGENT ISOLATION: do the verbose work in a subagent, which returns a SHORT SUMMARY (~200 tokens in the guide's example) instead of RAW OUTPUT (~50K\ntokens of grep results). Same idea as Domain 3's Explore subagent and context: fork.\n\nSCRATCHPAD FILES: write findings to files on disk so they persist across context boundaries, and reference them in later questions.\n\nSKILLS TESTED:\n• spawn subagents for specific questions (find all test files; trace refund-flow dependencies);\n• keep scratchpads and reference them later;\n• SUMMARIZE before starting the next phase of subagents;\n• design crash recovery through structured state exports (panel 09);\n• use /compact when verbose discovery output fills the context.\n\nEXAMPLE: 'Where is refund logic?' → an Explore subagent searches 300 files and returns 'refund flow: RefundService → LedgerClient; tests in /tests/refunds'.\nThe main chat gets ~200 tokens, not 50K.\n\nEXAM TELLS: 'late in a long session the agent forgets what it found / uses generic patterns' → scratchpad + subagent isolation, with /compact as the mid-\nsession lever.","rawText":"CONTEXT DEGRADATION: in long exploration sessions the model gives inconsistent answers and falls back on 'TYPICAL PATTERNS' instead of the specific classes\nit found earlier.\n\n★ SUBAGENT ISOLATION: do the verbose work in a subagent, which returns a SHORT SUMMARY (~200 tokens in the guide's example) instead of RAW OUTPUT (~50K\ntokens of grep results). Same idea as Domain 3's Explore subagent and context: fork.\n\nSCRATCHPAD FILES: write findings to files on disk so they persist across context boundaries, and reference them in later questions.\n\nSKILLS TESTED:\n• spawn subagents for specific questions (find all test files; trace refund-flow dependencies);\n• keep scratchpads and reference them later;\n• SUMMARIZE before starting the next phase of subagents;\n• design crash recovery through structured state exports (panel 09);\n• use /compact when verbose discovery output fills the context.\n\nEXAMPLE: 'Where is refund logic?' → an Explore subagent searches 300 files and returns 'refund flow: RefundService → LedgerClient; tests in /tests/refunds'.\nThe main chat gets ~200 tokens, not 50K.\n\nEXAM TELLS: 'late in a long session the agent forgets what it found / uses generic patterns' → scratchpad + subagent isolation, with /compact as the mid-\nsession lever.","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"CONTEXT DEGRADATION: in long exploration sessions the model gives inconsistent answers and falls back on 'TYPICAL PATTERNS' instead of the specific classes\nit found earlier.\n\n★ SUBAGENT ISOLATION: do the verbose work in a subagent, which returns a SHORT SUMMARY (~200 tokens in the guide's example) instead of RAW OUTPUT (~50K\ntokens of grep results). Same idea as Domain 3's Explore subagent and context: fork.\n\nSCRATCHPAD FILES: write findings to files on disk so they persist across context boundaries, and reference them in later questions.\n\nSKILLS TESTED:\n• spawn subagents for specific questions (find all test files; trace refund-flow dependencies);\n• keep scratchpads and reference them later;\n• SUMMARIZE before starting the next phase of subagents;\n• design crash recovery through structured state exports (panel 09);\n• use /compact when verbose discovery output fills the context.\n\nEXAMPLE: 'Where is refund logic?' → an Explore subagent searches 300 files and returns 'refund flow: RefundService → LedgerClient; tests in /tests/refunds'.\nThe main chat gets ~200 tokens, not 50K.\n\nEXAM TELLS: 'late in a long session the agent forgets what it found / uses generic patterns' → scratchpad + subagent isolation, with /compact as the mid-\nsession lever.","lineHeight":1.25},{"id":"r-217","type":"rectangle","x":0,"y":2481.12,"width":1150,"height":372.88,"angle":0,"strokeColor":"#2457c5","backgroundColor":"#f1f3f9","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":218,"version":1,"versionNonce":219,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-220","type":"text","x":16,"y":2493.12,"width":1118,"height":24,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":221,"version":1,"versionNonce":222,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"09 · 5.4 — MANIFESTS, CRASH RECOVERY AND /compact","rawText":"09 · 5.4 — MANIFESTS, CRASH RECOVERY AND /compact","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":18,"containerId":null,"originalText":"09 · 5.4 — MANIFESTS, CRASH RECOVERY AND /compact","lineHeight":1.25},{"id":"t-223","type":"text","x":16,"y":2525.12,"width":1118,"height":308.88,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":224,"version":1,"versionNonce":225,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"PATTERN: SCRATCHPADS + MANIFESTS. Under a .claude/scratch directory keep: a MANIFEST · a one-page architecture summary · a traced subgraph (e.g., refund\nflow) · a test inventory from a subagent · an ADR-style decisions log.\n\nTHE MANIFEST HOLDS: session ID · current phase · completed steps · open questions · each scratchpad file with a RESUME SUMMARY · subagent statuses with\noutput locations.\n\nRESUME PROCEDURE: load the manifest → re-inject each resume summary → re-read a scratchpad file ONLY when a question needs it.\n\nWHY: each agent exports its state to a known location, so the coordinator can RESUME AFTER A CRASH (ties to Domain 1.7 sessions).\n\n★ /compact: PRESERVES in-progress tasks, file operations and architectural decisions. LOSES detailed tool output. Auto-compact fires near 95% of the 200K\nwindow by default.\n• Run it MANUALLY BEFORE the threshold, and tell it what to keep (file paths, open questions, the manifest path).\n• Anything already in a scratchpad SURVIVES compaction because it lives on disk — that makes mid-investigation compaction safe.\n\nEXAMPLE: the session crashes at phase 3. A new session loads manifest.json, sees phases 1–2 complete, re-injects the resume summaries, and continues.\n\nEXAM TELLS: 'recover after a crash' → manifest. 'context nearly full mid-task' → /compact with instructions, after writing findings to scratchpads.","rawText":"PATTERN: SCRATCHPADS + MANIFESTS. Under a .claude/scratch directory keep: a MANIFEST · a one-page architecture summary · a traced subgraph (e.g., refund\nflow) · a test inventory from a subagent · an ADR-style decisions log.\n\nTHE MANIFEST HOLDS: session ID · current phase · completed steps · open questions · each scratchpad file with a RESUME SUMMARY · subagent statuses with\noutput locations.\n\nRESUME PROCEDURE: load the manifest → re-inject each resume summary → re-read a scratchpad file ONLY when a question needs it.\n\nWHY: each agent exports its state to a known location, so the coordinator can RESUME AFTER A CRASH (ties to Domain 1.7 sessions).\n\n★ /compact: PRESERVES in-progress tasks, file operations and architectural decisions. LOSES detailed tool output. Auto-compact fires near 95% of the 200K\nwindow by default.\n• Run it MANUALLY BEFORE the threshold, and tell it what to keep (file paths, open questions, the manifest path).\n• Anything already in a scratchpad SURVIVES compaction because it lives on disk — that makes mid-investigation compaction safe.\n\nEXAMPLE: the session crashes at phase 3. A new session loads manifest.json, sees phases 1–2 complete, re-injects the resume summaries, and continues.\n\nEXAM TELLS: 'recover after a crash' → manifest. 'context nearly full mid-task' → /compact with instructions, after writing findings to scratchpads.","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"PATTERN: SCRATCHPADS + MANIFESTS. Under a .claude/scratch directory keep: a MANIFEST · a one-page architecture summary · a traced subgraph (e.g., refund\nflow) · a test inventory from a subagent · an ADR-style decisions log.\n\nTHE MANIFEST HOLDS: session ID · current phase · completed steps · open questions · each scratchpad file with a RESUME SUMMARY · subagent statuses with\noutput locations.\n\nRESUME PROCEDURE: load the manifest → re-inject each resume summary → re-read a scratchpad file ONLY when a question needs it.\n\nWHY: each agent exports its state to a known location, so the coordinator can RESUME AFTER A CRASH (ties to Domain 1.7 sessions).\n\n★ /compact: PRESERVES in-progress tasks, file operations and architectural decisions. LOSES detailed tool output. Auto-compact fires near 95% of the 200K\nwindow by default.\n• Run it MANUALLY BEFORE the threshold, and tell it what to keep (file paths, open questions, the manifest path).\n• Anything already in a scratchpad SURVIVES compaction because it lives on disk — that makes mid-investigation compaction safe.\n\nEXAMPLE: the session crashes at phase 3. A new session loads manifest.json, sees phases 1–2 complete, re-injects the resume summaries, and continues.\n\nEXAM TELLS: 'recover after a crash' → manifest. 'context nearly full mid-task' → /compact with instructions, after writing findings to scratchpads.","lineHeight":1.25},{"id":"r-226","type":"rectangle","x":1190,"y":2481.12,"width":1150,"height":407.2,"angle":0,"strokeColor":"#2457c5","backgroundColor":"#f1f3f9","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":227,"version":1,"versionNonce":228,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-229","type":"text","x":1206,"y":2493.12,"width":1118,"height":24,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":230,"version":1,"versionNonce":231,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"10 · 5.5 — HUMAN REVIEW: WHY AGGREGATE ACCURACY LIES, AND FIELD-LEVEL CONFIDENCE","rawText":"10 · 5.5 — HUMAN REVIEW: WHY AGGREGATE ACCURACY LIES, AND FIELD-LEVEL CONFIDENCE","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":18,"containerId":null,"originalText":"10 · 5.5 — HUMAN REVIEW: WHY AGGREGATE ACCURACY LIES, AND FIELD-LEVEL CONFIDENCE","lineHeight":1.25},{"id":"t-232","type":"text","x":1206,"y":2525.12,"width":1118,"height":343.2,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":233,"version":1,"versionNonce":234,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"★ AGGREGATE ACCURACY CAN HIDE FAILURES. Example: 99.5% on invoices and 65% on contracts averages to a respectable number while the contracts pipeline\ncorrupts data. 97% overall is NOT enough to justify auto-approval.\n\nMODEL CONFIDENCE IS POORLY CALIBRATED, and NOVEL error patterns can slip into the high-confidence stream unnoticed.\n\n★ CONFIDENCE SHOULD BE FIELD-LEVEL, not document-level. A total amount can score high while payment terms score low.\n\nCALIBRATION PROCESS:\n1) Build a LABELED VALIDATION SET.\n2) BUCKET predictions by raw confidence and measure ACTUAL accuracy in each bucket.\n3) Pick the THRESHOLD where the auto-approved stream meets your ERROR BUDGET.\n4) RECALIBRATE per document type, when a new type ships, and when the model changes.\n\nLINK TO DOMAIN 4: self-reported confidence ≠ calibrated confidence; calibrate against labeled data.\n\nEXAMPLE: invoices at 'confidence ≥ 0.9' are 99% right, but contracts at 'confidence ≥ 0.9' are only 80% right. One global threshold would be wrong for\ncontracts.\n\nEXAM TELLS: 'overall accuracy is high but one document type is failing' → measure per type and per field. 'is the model's confidence trustworthy?' → only\nafter calibration on a labeled set.","rawText":"★ AGGREGATE ACCURACY CAN HIDE FAILURES. Example: 99.5% on invoices and 65% on contracts averages to a respectable number while the contracts pipeline\ncorrupts data. 97% overall is NOT enough to justify auto-approval.\n\nMODEL CONFIDENCE IS POORLY CALIBRATED, and NOVEL error patterns can slip into the high-confidence stream unnoticed.\n\n★ CONFIDENCE SHOULD BE FIELD-LEVEL, not document-level. A total amount can score high while payment terms score low.\n\nCALIBRATION PROCESS:\n1) Build a LABELED VALIDATION SET.\n2) BUCKET predictions by raw confidence and measure ACTUAL accuracy in each bucket.\n3) Pick the THRESHOLD where the auto-approved stream meets your ERROR BUDGET.\n4) RECALIBRATE per document type, when a new type ships, and when the model changes.\n\nLINK TO DOMAIN 4: self-reported confidence ≠ calibrated confidence; calibrate against labeled data.\n\nEXAMPLE: invoices at 'confidence ≥ 0.9' are 99% right, but contracts at 'confidence ≥ 0.9' are only 80% right. One global threshold would be wrong for\ncontracts.\n\nEXAM TELLS: 'overall accuracy is high but one document type is failing' → measure per type and per field. 'is the model's confidence trustworthy?' → only\nafter calibration on a labeled set.","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"★ AGGREGATE ACCURACY CAN HIDE FAILURES. Example: 99.5% on invoices and 65% on contracts averages to a respectable number while the contracts pipeline\ncorrupts data. 97% overall is NOT enough to justify auto-approval.\n\nMODEL CONFIDENCE IS POORLY CALIBRATED, and NOVEL error patterns can slip into the high-confidence stream unnoticed.\n\n★ CONFIDENCE SHOULD BE FIELD-LEVEL, not document-level. A total amount can score high while payment terms score low.\n\nCALIBRATION PROCESS:\n1) Build a LABELED VALIDATION SET.\n2) BUCKET predictions by raw confidence and measure ACTUAL accuracy in each bucket.\n3) Pick the THRESHOLD where the auto-approved stream meets your ERROR BUDGET.\n4) RECALIBRATE per document type, when a new type ships, and when the model changes.\n\nLINK TO DOMAIN 4: self-reported confidence ≠ calibrated confidence; calibrate against labeled data.\n\nEXAMPLE: invoices at 'confidence ≥ 0.9' are 99% right, but contracts at 'confidence ≥ 0.9' are only 80% right. One global threshold would be wrong for\ncontracts.\n\nEXAM TELLS: 'overall accuracy is high but one document type is failing' → measure per type and per field. 'is the model's confidence trustworthy?' → only\nafter calibration on a labeled set.","lineHeight":1.25},{"id":"r-235","type":"rectangle","x":0,"y":2916.3199999999997,"width":1150,"height":372.88,"angle":0,"strokeColor":"#2457c5","backgroundColor":"#f1f3f9","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":236,"version":1,"versionNonce":237,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-238","type":"text","x":16,"y":2928.3199999999997,"width":1118,"height":24,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":239,"version":1,"versionNonce":240,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"11 · 5.5 — ROUTING, STRATIFIED SAMPLING AND REVIEWER CAPACITY","rawText":"11 · 5.5 — ROUTING, STRATIFIED SAMPLING AND REVIEWER CAPACITY","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":18,"containerId":null,"originalText":"11 · 5.5 — ROUTING, STRATIFIED SAMPLING AND REVIEWER CAPACITY","lineHeight":1.25},{"id":"t-241","type":"text","x":16,"y":2960.3199999999997,"width":1118,"height":308.88,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":242,"version":1,"versionNonce":243,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"ROUTING:\n• LOW-confidence items → human review.\n• AMBIGUOUS-SOURCE items → human review.\n• HIGH-confidence items → auto-approve, BUT send a STRATIFIED RANDOM SAMPLE (~2% in the guide) to human AUDIT, stratified by DOCUMENT TYPE and FIELD. The\naudit queue is what catches NOVEL errors.\n\n★ STRATIFIED SAMPLING = sample from each segment (type × field) rather than one random pile, so small risky segments are not drowned out by big easy ones.\n\nREVIEWER TIME IS LIMITED: prioritize review by RISK (low confidence, high-impact fields, historically weak document types).\n\nSKILLS TESTED: stratified sampling · accuracy by document type AND field · field-level calibrated confidence · routing low-confidence and ambiguous-source\nitems · prioritizing limited reviewer capacity.\n\nEXAMPLE: 10,000 documents/day. Low-confidence ones go to reviewers. Of the auto-approved, 2% — spread across invoices, contracts, receipts and across fields\n— gets audited. A new error pattern in contract payment terms shows up there.\n\nEXAM TELLS: 'how to catch errors the model is confident about' → stratified audit sample of the high-confidence stream. 'limited reviewers' → prioritize by\nrisk.","rawText":"ROUTING:\n• LOW-confidence items → human review.\n• AMBIGUOUS-SOURCE items → human review.\n• HIGH-confidence items → auto-approve, BUT send a STRATIFIED RANDOM SAMPLE (~2% in the guide) to human AUDIT, stratified by DOCUMENT TYPE and FIELD. The\naudit queue is what catches NOVEL errors.\n\n★ STRATIFIED SAMPLING = sample from each segment (type × field) rather than one random pile, so small risky segments are not drowned out by big easy ones.\n\nREVIEWER TIME IS LIMITED: prioritize review by RISK (low confidence, high-impact fields, historically weak document types).\n\nSKILLS TESTED: stratified sampling · accuracy by document type AND field · field-level calibrated confidence · routing low-confidence and ambiguous-source\nitems · prioritizing limited reviewer capacity.\n\nEXAMPLE: 10,000 documents/day. Low-confidence ones go to reviewers. Of the auto-approved, 2% — spread across invoices, contracts, receipts and across fields\n— gets audited. A new error pattern in contract payment terms shows up there.\n\nEXAM TELLS: 'how to catch errors the model is confident about' → stratified audit sample of the high-confidence stream. 'limited reviewers' → prioritize by\nrisk.","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"ROUTING:\n• LOW-confidence items → human review.\n• AMBIGUOUS-SOURCE items → human review.\n• HIGH-confidence items → auto-approve, BUT send a STRATIFIED RANDOM SAMPLE (~2% in the guide) to human AUDIT, stratified by DOCUMENT TYPE and FIELD. The\naudit queue is what catches NOVEL errors.\n\n★ STRATIFIED SAMPLING = sample from each segment (type × field) rather than one random pile, so small risky segments are not drowned out by big easy ones.\n\nREVIEWER TIME IS LIMITED: prioritize review by RISK (low confidence, high-impact fields, historically weak document types).\n\nSKILLS TESTED: stratified sampling · accuracy by document type AND field · field-level calibrated confidence · routing low-confidence and ambiguous-source\nitems · prioritizing limited reviewer capacity.\n\nEXAMPLE: 10,000 documents/day. Low-confidence ones go to reviewers. Of the auto-approved, 2% — spread across invoices, contracts, receipts and across fields\n— gets audited. A new error pattern in contract payment terms shows up there.\n\nEXAM TELLS: 'how to catch errors the model is confident about' → stratified audit sample of the high-confidence stream. 'limited reviewers' → prioritize by\nrisk.","lineHeight":1.25},{"id":"r-244","type":"rectangle","x":1190,"y":2916.3199999999997,"width":1150,"height":390.04,"angle":0,"strokeColor":"#2457c5","backgroundColor":"#f1f3f9","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":245,"version":1,"versionNonce":246,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-247","type":"text","x":1206,"y":2928.3199999999997,"width":1118,"height":24,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":248,"version":1,"versionNonce":249,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"12 · 5.6 — PROVENANCE: KEEPING CLAIM → SOURCE MAPPINGS THROUGH SYNTHESIS","rawText":"12 · 5.6 — PROVENANCE: KEEPING CLAIM → SOURCE MAPPINGS THROUGH SYNTHESIS","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":18,"containerId":null,"originalText":"12 · 5.6 — PROVENANCE: KEEPING CLAIM → SOURCE MAPPINGS THROUGH SYNTHESIS","lineHeight":1.25},{"id":"t-250","type":"text","x":1206,"y":2960.3199999999997,"width":1118,"height":326.04,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":251,"version":1,"versionNonce":252,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"PROBLEM: SUMMARIZATION DESTROYS SOURCE ATTRIBUTION unless the claim-to-source mappings are kept as STRUCTURED DATA. Once lost, they can only be rebuilt by\nsearching again.\n\nPATTERN: subagents emit a CLAIMS ARRAY. Each claim has:\n• the claim text;\n• a SUPPORT list — each entry: source URL/name, an EXCERPT, and a PUBLICATION DATE;\n• a CONFLICT object when sources disagree — the values and the reason they differ (e.g., survey methodology vs payroll data);\n• a CONFIDENCE label such as well-supported or contested.\n\nWHO OWNS IT: in Anthropic's multi-agent research design, parallel subagents with separate context windows return structured findings to a lead agent; the\nLEAD agent composes the report and OWNS CITATION INTEGRITY.\n\nLINK TO 5.1: require subagents to return dates, source locations and methodology (panel 03).\n\nLINK TO SAMPLE QUESTION 9: a scoped verification tool assumes this pattern — you cannot verify a claim you cannot trace to a source.\n\nEXAMPLE: claim 'EV sales grew 24% in 2025' → support: [{source:'IEA report', excerpt:'…24%…', date:'2026-03-01'}] → confidence: well-supported.\n\nEXAM TELLS: 'the final report can't say where a number came from' → keep claim→source mappings as structured data through synthesis.","rawText":"PROBLEM: SUMMARIZATION DESTROYS SOURCE ATTRIBUTION unless the claim-to-source mappings are kept as STRUCTURED DATA. Once lost, they can only be rebuilt by\nsearching again.\n\nPATTERN: subagents emit a CLAIMS ARRAY. Each claim has:\n• the claim text;\n• a SUPPORT list — each entry: source URL/name, an EXCERPT, and a PUBLICATION DATE;\n• a CONFLICT object when sources disagree — the values and the reason they differ (e.g., survey methodology vs payroll data);\n• a CONFIDENCE label such as well-supported or contested.\n\nWHO OWNS IT: in Anthropic's multi-agent research design, parallel subagents with separate context windows return structured findings to a lead agent; the\nLEAD agent composes the report and OWNS CITATION INTEGRITY.\n\nLINK TO 5.1: require subagents to return dates, source locations and methodology (panel 03).\n\nLINK TO SAMPLE QUESTION 9: a scoped verification tool assumes this pattern — you cannot verify a claim you cannot trace to a source.\n\nEXAMPLE: claim 'EV sales grew 24% in 2025' → support: [{source:'IEA report', excerpt:'…24%…', date:'2026-03-01'}] → confidence: well-supported.\n\nEXAM TELLS: 'the final report can't say where a number came from' → keep claim→source mappings as structured data through synthesis.","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"PROBLEM: SUMMARIZATION DESTROYS SOURCE ATTRIBUTION unless the claim-to-source mappings are kept as STRUCTURED DATA. Once lost, they can only be rebuilt by\nsearching again.\n\nPATTERN: subagents emit a CLAIMS ARRAY. Each claim has:\n• the claim text;\n• a SUPPORT list — each entry: source URL/name, an EXCERPT, and a PUBLICATION DATE;\n• a CONFLICT object when sources disagree — the values and the reason they differ (e.g., survey methodology vs payroll data);\n• a CONFIDENCE label such as well-supported or contested.\n\nWHO OWNS IT: in Anthropic's multi-agent research design, parallel subagents with separate context windows return structured findings to a lead agent; the\nLEAD agent composes the report and OWNS CITATION INTEGRITY.\n\nLINK TO 5.1: require subagents to return dates, source locations and methodology (panel 03).\n\nLINK TO SAMPLE QUESTION 9: a scoped verification tool assumes this pattern — you cannot verify a claim you cannot trace to a source.\n\nEXAMPLE: claim 'EV sales grew 24% in 2025' → support: [{source:'IEA report', excerpt:'…24%…', date:'2026-03-01'}] → confidence: well-supported.\n\nEXAM TELLS: 'the final report can't say where a number came from' → keep claim→source mappings as structured data through synthesis.","lineHeight":1.25},{"id":"r-253","type":"rectangle","x":0,"y":3334.3599999999997,"width":1150,"height":372.88,"angle":0,"strokeColor":"#2457c5","backgroundColor":"#f1f3f9","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":254,"version":1,"versionNonce":255,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-256","type":"text","x":16,"y":3346.3599999999997,"width":1118,"height":24,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":257,"version":1,"versionNonce":258,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"13 · 5.6 — CONFLICTS, DATES AND RENDERING FORMATS","rawText":"13 · 5.6 — CONFLICTS, DATES AND RENDERING FORMATS","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":18,"containerId":null,"originalText":"13 · 5.6 — CONFLICTS, DATES AND RENDERING FORMATS","lineHeight":1.25},{"id":"t-259","type":"text","x":16,"y":3378.3599999999997,"width":1118,"height":308.88,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":260,"version":1,"versionNonce":261,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"★ WHEN CREDIBLE SOURCES CONFLICT: ANNOTATE BOTH ATTRIBUTIONS. Do NOT resolve the conflict arbitrarily by picking one value or averaging.\n\nEXAMPLE: one source says unemployment is 4.1% (survey), another says 3.8% (payroll data). Report both, with the methodology reason, and mark the claim as\ncontested.\n\n★ ALWAYS CARRY DATES. Temporal data needs publication/collection dates; without them a time series can look like a contradiction (2023: 12%, 2025: 18% are\nnot conflicting — they are different years).\n\nRENDER CONTENT TYPES APPROPRIATELY: financial data as TABLES · news as PROSE · technical content as STRUCTURED LISTS. Forcing everything through one prose\nformat destroys source structure.\n\nSYNTHESIS COVERAGE (from 5.3): sort claims into well-supported / partially supported / gaps.\n\nHOW TO TELL CONFLICT FROM TIME DIFFERENCE: check the dates. Same period, different values → conflict (annotate both). Different periods → not a conflict\n(carry the dates).\n\nEXAM TELLS: 'two sources report different numbers' → annotate both with attribution and reason. 'numbers seem to contradict' → check whether the dates\ndiffer.","rawText":"★ WHEN CREDIBLE SOURCES CONFLICT: ANNOTATE BOTH ATTRIBUTIONS. Do NOT resolve the conflict arbitrarily by picking one value or averaging.\n\nEXAMPLE: one source says unemployment is 4.1% (survey), another says 3.8% (payroll data). Report both, with the methodology reason, and mark the claim as\ncontested.\n\n★ ALWAYS CARRY DATES. Temporal data needs publication/collection dates; without them a time series can look like a contradiction (2023: 12%, 2025: 18% are\nnot conflicting — they are different years).\n\nRENDER CONTENT TYPES APPROPRIATELY: financial data as TABLES · news as PROSE · technical content as STRUCTURED LISTS. Forcing everything through one prose\nformat destroys source structure.\n\nSYNTHESIS COVERAGE (from 5.3): sort claims into well-supported / partially supported / gaps.\n\nHOW TO TELL CONFLICT FROM TIME DIFFERENCE: check the dates. Same period, different values → conflict (annotate both). Different periods → not a conflict\n(carry the dates).\n\nEXAM TELLS: 'two sources report different numbers' → annotate both with attribution and reason. 'numbers seem to contradict' → check whether the dates\ndiffer.","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"★ WHEN CREDIBLE SOURCES CONFLICT: ANNOTATE BOTH ATTRIBUTIONS. Do NOT resolve the conflict arbitrarily by picking one value or averaging.\n\nEXAMPLE: one source says unemployment is 4.1% (survey), another says 3.8% (payroll data). Report both, with the methodology reason, and mark the claim as\ncontested.\n\n★ ALWAYS CARRY DATES. Temporal data needs publication/collection dates; without them a time series can look like a contradiction (2023: 12%, 2025: 18% are\nnot conflicting — they are different years).\n\nRENDER CONTENT TYPES APPROPRIATELY: financial data as TABLES · news as PROSE · technical content as STRUCTURED LISTS. Forcing everything through one prose\nformat destroys source structure.\n\nSYNTHESIS COVERAGE (from 5.3): sort claims into well-supported / partially supported / gaps.\n\nHOW TO TELL CONFLICT FROM TIME DIFFERENCE: check the dates. Same period, different values → conflict (annotate both). Different periods → not a conflict\n(carry the dates).\n\nEXAM TELLS: 'two sources report different numbers' → annotate both with attribution and reason. 'numbers seem to contradict' → check whether the dates\ndiffer.","lineHeight":1.25},{"id":"r-262","type":"rectangle","x":1190,"y":3334.3599999999997,"width":1150,"height":372.88,"angle":0,"strokeColor":"#2457c5","backgroundColor":"#f1f3f9","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":263,"version":1,"versionNonce":264,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-265","type":"text","x":1206,"y":3346.3599999999997,"width":1118,"height":24,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":266,"version":1,"versionNonce":267,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"14 · CROSS-CUTTING: ANTI-PATTERNS, INTEGRATION WITH OTHER DOMAINS, EXAM CHECKLIST","rawText":"14 · CROSS-CUTTING: ANTI-PATTERNS, INTEGRATION WITH OTHER DOMAINS, EXAM CHECKLIST","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":18,"containerId":null,"originalText":"14 · CROSS-CUTTING: ANTI-PATTERNS, INTEGRATION WITH OTHER DOMAINS, EXAM CHECKLIST","lineHeight":1.25},{"id":"t-268","type":"text","x":1206,"y":3378.3599999999997,"width":1118,"height":308.88,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":269,"version":1,"versionNonce":270,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"ANTI-PATTERNS TO MEMORIZE:\n• sentiment-based auto-escalation · self-reported confidence as a routing signal\n• generic 'operation failed' errors · empty results returned as success when the call failed\n• terminating the workflow on one subagent failure\n• reporting aggregate accuracy without a per-segment breakdown\n• summarizing claims without keeping the claim-to-source mapping\n• letting a rolling summary rewrite numbers, dates or quotes · burying key findings in the middle of a long input\n• treating a large CLAUDE.md or @imports as a context-saving measure (it expands context)\n\nINTEGRATION: Customer-support scenario (Q3 escalation; Q1's identity-verification hook feeds the case-facts block) · Multi-agent research (Q8 = error\nenvelope; Q9 presumes provenance; 'save the plan to memory' = the manifest pattern) · Code generation (scratchpad + subagent + /compact pair with path-\nscoped rules from Domain 3).\n\nPROMPT CACHING NOTE: stable content before volatile content. A case-facts block is a good cache target if appended to, not rewritten.\n\nCHECKLIST: 4 escalation triggers + 2 bad proxies · envelope fields and the timeout answer shape · access failure (retry) vs empty success (no retry) · case-\nfacts block every turn · trim at the wrapper · scratchpads + subagents + /compact · per-type per-field accuracy + stratified audit · calibrate confidence on\nlabeled data · annotate conflicts, carry dates, top-load key findings.","rawText":"ANTI-PATTERNS TO MEMORIZE:\n• sentiment-based auto-escalation · self-reported confidence as a routing signal\n• generic 'operation failed' errors · empty results returned as success when the call failed\n• terminating the workflow on one subagent failure\n• reporting aggregate accuracy without a per-segment breakdown\n• summarizing claims without keeping the claim-to-source mapping\n• letting a rolling summary rewrite numbers, dates or quotes · burying key findings in the middle of a long input\n• treating a large CLAUDE.md or @imports as a context-saving measure (it expands context)\n\nINTEGRATION: Customer-support scenario (Q3 escalation; Q1's identity-verification hook feeds the case-facts block) · Multi-agent research (Q8 = error\nenvelope; Q9 presumes provenance; 'save the plan to memory' = the manifest pattern) · Code generation (scratchpad + subagent + /compact pair with path-\nscoped rules from Domain 3).\n\nPROMPT CACHING NOTE: stable content before volatile content. A case-facts block is a good cache target if appended to, not rewritten.\n\nCHECKLIST: 4 escalation triggers + 2 bad proxies · envelope fields and the timeout answer shape · access failure (retry) vs empty success (no retry) · case-\nfacts block every turn · trim at the wrapper · scratchpads + subagents + /compact · per-type per-field accuracy + stratified audit · calibrate confidence on\nlabeled data · annotate conflicts, carry dates, top-load key findings.","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"ANTI-PATTERNS TO MEMORIZE:\n• sentiment-based auto-escalation · self-reported confidence as a routing signal\n• generic 'operation failed' errors · empty results returned as success when the call failed\n• terminating the workflow on one subagent failure\n• reporting aggregate accuracy without a per-segment breakdown\n• summarizing claims without keeping the claim-to-source mapping\n• letting a rolling summary rewrite numbers, dates or quotes · burying key findings in the middle of a long input\n• treating a large CLAUDE.md or @imports as a context-saving measure (it expands context)\n\nINTEGRATION: Customer-support scenario (Q3 escalation; Q1's identity-verification hook feeds the case-facts block) · Multi-agent research (Q8 = error\nenvelope; Q9 presumes provenance; 'save the plan to memory' = the manifest pattern) · Code generation (scratchpad + subagent + /compact pair with path-\nscoped rules from Domain 3).\n\nPROMPT CACHING NOTE: stable content before volatile content. A case-facts block is a good cache target if appended to, not rewritten.\n\nCHECKLIST: 4 escalation triggers + 2 bad proxies · envelope fields and the timeout answer shape · access failure (retry) vs empty success (no retry) · case-\nfacts block every turn · trim at the wrapper · scratchpads + subagents + /compact · per-type per-field accuracy + stratified audit · calibrate confidence on\nlabeled data · annotate conflicts, carry dates, top-load key findings.","lineHeight":1.25},{"id":"t-271","type":"text","x":0,"y":3760.24,"width":2400,"height":36,"angle":0,"strokeColor":"#0f3d8a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":272,"version":1,"versionNonce":273,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"THREE JOBS OF RELIABILITY — KEEP FACTS · ROUTE WHEN UNSURE · TRACE CLAIMS","rawText":"THREE JOBS OF RELIABILITY — KEEP FACTS · ROUTE WHEN UNSURE · TRACE CLAIMS","fontSize":26,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":26,"containerId":null,"originalText":"THREE JOBS OF RELIABILITY — KEEP FACTS · ROUTE WHEN UNSURE · TRACE CLAIMS","lineHeight":1.25},{"id":"r-274","type":"rectangle","x":0,"y":3808.24,"width":745,"height":215.44,"angle":0,"strokeColor":"#2457c5","backgroundColor":"#a5d8ff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":275,"version":1,"versionNonce":276,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-277","type":"text","x":16,"y":3820.24,"width":713,"height":21,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":278,"version":1,"versionNonce":279,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"KEEP FACTS STRAIGHT (5.1 · 5.4)","rawText":"KEEP FACTS STRAIGHT (5.1 · 5.4)","fontSize":15,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":15,"containerId":null,"originalText":"KEEP FACTS STRAIGHT (5.1 · 5.4)","lineHeight":1.25},{"id":"t-280","type":"text","x":16,"y":3849.24,"width":713,"height":154.44,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":281,"version":1,"versionNonce":282,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"PROBLEM: summaries blur numbers; middle gets lost; tool output bloats; long sessions degrade.\nFIX: case-facts block every turn; trim at the wrapper; key findings first.\nFOR BIG CODEBASES: subagent isolation + scratchpads + manifest + /compact.\nSTATELESS: resend full history; never silently trim.\nNOT A FIX: bigger window, bigger CLAUDE.md, rolling summary.\nLINKS: Domain 3 Explore/fork; Domain 1 sessions.\nEXAMPLE: pin '$127.45, Oct 3' in the facts block.\nMISTAKE: let the summary rewrite numbers.\nONE WORD: PIN","rawText":"PROBLEM: summaries blur numbers; middle gets lost; tool output bloats; long sessions degrade.\nFIX: case-facts block every turn; trim at the wrapper; key findings first.\nFOR BIG CODEBASES: subagent isolation + scratchpads + manifest + /compact.\nSTATELESS: resend full history; never silently trim.\nNOT A FIX: bigger window, bigger CLAUDE.md, rolling summary.\nLINKS: Domain 3 Explore/fork; Domain 1 sessions.\nEXAMPLE: pin '$127.45, Oct 3' in the facts block.\nMISTAKE: let the summary rewrite numbers.\nONE WORD: PIN","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"PROBLEM: summaries blur numbers; middle gets lost; tool output bloats; long sessions degrade.\nFIX: case-facts block every turn; trim at the wrapper; key findings first.\nFOR BIG CODEBASES: subagent isolation + scratchpads + manifest + /compact.\nSTATELESS: resend full history; never silently trim.\nNOT A FIX: bigger window, bigger CLAUDE.md, rolling summary.\nLINKS: Domain 3 Explore/fork; Domain 1 sessions.\nEXAMPLE: pin '$127.45, Oct 3' in the facts block.\nMISTAKE: let the summary rewrite numbers.\nONE WORD: PIN","lineHeight":1.25},{"id":"r-283","type":"rectangle","x":775,"y":3808.24,"width":745,"height":215.44,"angle":0,"strokeColor":"#0f8a7c","backgroundColor":"#b2f2bb","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":284,"version":1,"versionNonce":285,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-286","type":"text","x":791,"y":3820.24,"width":713,"height":21,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":287,"version":1,"versionNonce":288,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"ROUTE WHEN UNSURE (5.2 · 5.3 · 5.5)","rawText":"ROUTE WHEN UNSURE (5.2 · 5.3 · 5.5)","fontSize":15,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":15,"containerId":null,"originalText":"ROUTE WHEN UNSURE (5.2 · 5.3 · 5.5)","lineHeight":1.25},{"id":"t-289","type":"text","x":791,"y":3849.24,"width":713,"height":154.44,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":290,"version":1,"versionNonce":291,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"ESCALATE ON: explicit request · policy gap · no progress · multi-match ambiguity.\nERRORS: structured envelope — type, attempted query, partial results, alternatives.\nDON'T RETRY: valid empty results. DO RETRY: access failures (locally first).\nREVIEW: low-confidence + ambiguous → humans; stratified audit of auto-approved.\nCONFIDENCE: field-level, calibrated on labeled data.\nNOT SIGNALS: sentiment, self-reported confidence.\nEXAMPLE: timeout → envelope + partial results.\nMISTAKE: 'search unavailable' or empty-as-success.\nONE WORD: ROUTE","rawText":"ESCALATE ON: explicit request · policy gap · no progress · multi-match ambiguity.\nERRORS: structured envelope — type, attempted query, partial results, alternatives.\nDON'T RETRY: valid empty results. DO RETRY: access failures (locally first).\nREVIEW: low-confidence + ambiguous → humans; stratified audit of auto-approved.\nCONFIDENCE: field-level, calibrated on labeled data.\nNOT SIGNALS: sentiment, self-reported confidence.\nEXAMPLE: timeout → envelope + partial results.\nMISTAKE: 'search unavailable' or empty-as-success.\nONE WORD: ROUTE","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"ESCALATE ON: explicit request · policy gap · no progress · multi-match ambiguity.\nERRORS: structured envelope — type, attempted query, partial results, alternatives.\nDON'T RETRY: valid empty results. DO RETRY: access failures (locally first).\nREVIEW: low-confidence + ambiguous → humans; stratified audit of auto-approved.\nCONFIDENCE: field-level, calibrated on labeled data.\nNOT SIGNALS: sentiment, self-reported confidence.\nEXAMPLE: timeout → envelope + partial results.\nMISTAKE: 'search unavailable' or empty-as-success.\nONE WORD: ROUTE","lineHeight":1.25},{"id":"r-292","type":"rectangle","x":1550,"y":3808.24,"width":745,"height":215.44,"angle":0,"strokeColor":"#8a4fd1","backgroundColor":"#eebefa","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":293,"version":1,"versionNonce":294,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-295","type":"text","x":1566,"y":3820.24,"width":713,"height":21,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":296,"version":1,"versionNonce":297,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"TRACE CLAIMS (5.6)","rawText":"TRACE CLAIMS (5.6)","fontSize":15,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":15,"containerId":null,"originalText":"TRACE CLAIMS (5.6)","lineHeight":1.25},{"id":"t-298","type":"text","x":1566,"y":3849.24,"width":713,"height":154.44,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":299,"version":1,"versionNonce":300,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"PROBLEM: summarizing destroys which source said what.\nFIX: claims array: text, support (source, excerpt, date), conflict, confidence.\nCONFLICT: annotate BOTH values with reasons; never pick one.\nDATES: always carry them; different years aren't a conflict.\nFORMAT: tables for finance, prose for news, lists for technical.\nOWNER: the lead agent owns citation integrity.\nEXAMPLE: 24% (IEA, Mar 2026).\nMISTAKE: one blended prose summary with no sources.\nONE WORD: TRACE","rawText":"PROBLEM: summarizing destroys which source said what.\nFIX: claims array: text, support (source, excerpt, date), conflict, confidence.\nCONFLICT: annotate BOTH values with reasons; never pick one.\nDATES: always carry them; different years aren't a conflict.\nFORMAT: tables for finance, prose for news, lists for technical.\nOWNER: the lead agent owns citation integrity.\nEXAMPLE: 24% (IEA, Mar 2026).\nMISTAKE: one blended prose summary with no sources.\nONE WORD: TRACE","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"PROBLEM: summarizing destroys which source said what.\nFIX: claims array: text, support (source, excerpt, date), conflict, confidence.\nCONFLICT: annotate BOTH values with reasons; never pick one.\nDATES: always carry them; different years aren't a conflict.\nFORMAT: tables for finance, prose for news, lists for technical.\nOWNER: the lead agent owns citation integrity.\nEXAMPLE: 24% (IEA, Mar 2026).\nMISTAKE: one blended prose summary with no sources.\nONE WORD: TRACE","lineHeight":1.25},{"id":"t-301","type":"text","x":0,"y":4053.68,"width":2400,"height":36,"angle":0,"strokeColor":"#0f3d8a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":302,"version":1,"versionNonce":303,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"★ DISCRIMINATORS — WHEN TWO ANSWERS LOOK RIGHT, THIS DECIDES IT","rawText":"★ DISCRIMINATORS — WHEN TWO ANSWERS LOOK RIGHT, THIS DECIDES IT","fontSize":26,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":26,"containerId":null,"originalText":"★ DISCRIMINATORS — WHEN TWO ANSWERS LOOK RIGHT, THIS DECIDES IT","lineHeight":1.25},{"id":"r-304","type":"rectangle","x":0,"y":4101.68,"width":1150,"height":234.6,"angle":0,"strokeColor":"#b4303a","backgroundColor":"#fff0f0","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":305,"version":1,"versionNonce":306,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-307","type":"text","x":16,"y":4113.68,"width":1118,"height":23,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":308,"version":1,"versionNonce":309,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"1 · CASE-FACTS BLOCK  vs  ROLLING SUMMARY","rawText":"1 · CASE-FACTS BLOCK  vs  ROLLING SUMMARY","fontSize":17,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":17,"containerId":null,"originalText":"1 · CASE-FACTS BLOCK  vs  ROLLING SUMMARY","lineHeight":1.25},{"id":"t-310","type":"text","x":16,"y":4144.68,"width":1118,"height":171.6,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":311,"version":1,"versionNonce":312,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"DECIDING QUESTION: Do exact values need to survive the whole conversation?\n\nLOOK FOR → CASE-FACTS: 'amounts, dates, order numbers lost', 'long conversation', 'customer's exact words'. LOOK FOR → SUMMARY: general narrative gist only.\nSummaries are lossy and may rewrite numbers; a facts block is append-only and verified.\n\nHOW TO DECIDE: Must it be exact and always present? → facts block, top of every prompt, outside the summary.\n\nEXAMPLE: After 30 turns the agent quotes the wrong refund amount because the summary said 'a refund'. Pin '$127.45' in the block.\n\nWHY THE TRAP IS WRONG: A better summarizer prompt is still lossy; pinned facts aren't summarized.","rawText":"DECIDING QUESTION: Do exact values need to survive the whole conversation?\n\nLOOK FOR → CASE-FACTS: 'amounts, dates, order numbers lost', 'long conversation', 'customer's exact words'. LOOK FOR → SUMMARY: general narrative gist only.\nSummaries are lossy and may rewrite numbers; a facts block is append-only and verified.\n\nHOW TO DECIDE: Must it be exact and always present? → facts block, top of every prompt, outside the summary.\n\nEXAMPLE: After 30 turns the agent quotes the wrong refund amount because the summary said 'a refund'. Pin '$127.45' in the block.\n\nWHY THE TRAP IS WRONG: A better summarizer prompt is still lossy; pinned facts aren't summarized.","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"DECIDING QUESTION: Do exact values need to survive the whole conversation?\n\nLOOK FOR → CASE-FACTS: 'amounts, dates, order numbers lost', 'long conversation', 'customer's exact words'. LOOK FOR → SUMMARY: general narrative gist only.\nSummaries are lossy and may rewrite numbers; a facts block is append-only and verified.\n\nHOW TO DECIDE: Must it be exact and always present? → facts block, top of every prompt, outside the summary.\n\nEXAMPLE: After 30 turns the agent quotes the wrong refund amount because the summary said 'a refund'. Pin '$127.45' in the block.\n\nWHY THE TRAP IS WRONG: A better summarizer prompt is still lossy; pinned facts aren't summarized.","lineHeight":1.25},{"id":"r-313","type":"rectangle","x":1190,"y":4101.68,"width":1150,"height":234.6,"angle":0,"strokeColor":"#b4303a","backgroundColor":"#fff0f0","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":314,"version":1,"versionNonce":315,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-316","type":"text","x":1206,"y":4113.68,"width":1118,"height":23,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":317,"version":1,"versionNonce":318,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"2 · TRIM AT THE WRAPPER  vs  BIGGER CONTEXT WINDOW","rawText":"2 · TRIM AT THE WRAPPER  vs  BIGGER CONTEXT WINDOW","fontSize":17,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":17,"containerId":null,"originalText":"2 · TRIM AT THE WRAPPER  vs  BIGGER CONTEXT WINDOW","lineHeight":1.25},{"id":"t-319","type":"text","x":1206,"y":4144.68,"width":1118,"height":171.6,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":320,"version":1,"versionNonce":321,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"DECIDING QUESTION: Is the problem too much irrelevant tokens or too little room?\n\nLOOK FOR → TRIM: '40+ fields returned', 'accuracy falls as inputs grow', 'context rot'. LOOK FOR → WINDOW: (a distractor).\nA larger window keeps the clutter; trimming removes it before it enters history.\n\nHOW TO DECIDE: Verbose tool output that downstream steps don't need? → normalize in the tool wrapper.\n\nEXAMPLE: lookup_order returns 43 fields; the wrapper returns 6.\n\nWHY THE TRAP IS WRONG: Once verbose output is in history it can't be removed; capacity doesn't fix attention.","rawText":"DECIDING QUESTION: Is the problem too much irrelevant tokens or too little room?\n\nLOOK FOR → TRIM: '40+ fields returned', 'accuracy falls as inputs grow', 'context rot'. LOOK FOR → WINDOW: (a distractor).\nA larger window keeps the clutter; trimming removes it before it enters history.\n\nHOW TO DECIDE: Verbose tool output that downstream steps don't need? → normalize in the tool wrapper.\n\nEXAMPLE: lookup_order returns 43 fields; the wrapper returns 6.\n\nWHY THE TRAP IS WRONG: Once verbose output is in history it can't be removed; capacity doesn't fix attention.","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"DECIDING QUESTION: Is the problem too much irrelevant tokens or too little room?\n\nLOOK FOR → TRIM: '40+ fields returned', 'accuracy falls as inputs grow', 'context rot'. LOOK FOR → WINDOW: (a distractor).\nA larger window keeps the clutter; trimming removes it before it enters history.\n\nHOW TO DECIDE: Verbose tool output that downstream steps don't need? → normalize in the tool wrapper.\n\nEXAMPLE: lookup_order returns 43 fields; the wrapper returns 6.\n\nWHY THE TRAP IS WRONG: Once verbose output is in history it can't be removed; capacity doesn't fix attention.","lineHeight":1.25},{"id":"r-322","type":"rectangle","x":0,"y":4360.280000000001,"width":1150,"height":234.6,"angle":0,"strokeColor":"#b4303a","backgroundColor":"#fff0f0","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":323,"version":1,"versionNonce":324,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-325","type":"text","x":16,"y":4372.280000000001,"width":1118,"height":23,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":326,"version":1,"versionNonce":327,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"3 · KEY FINDINGS FIRST  vs  SUMMARY AT THE END","rawText":"3 · KEY FINDINGS FIRST  vs  SUMMARY AT THE END","fontSize":17,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":17,"containerId":null,"originalText":"3 · KEY FINDINGS FIRST  vs  SUMMARY AT THE END","lineHeight":1.25},{"id":"t-328","type":"text","x":16,"y":4403.280000000001,"width":1118,"height":171.6,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":329,"version":1,"versionNonce":330,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"DECIDING QUESTION: Where does the model reliably read?\n\nLOOK FOR → TOP: 'lost in the middle', 'aggregated inputs', 'long documents'. LOOK FOR → END: weaker choice.\nStart and end are used reliably; the middle may be skipped.\n\nHOW TO DECIDE: Put key findings at the START under explicit section headers.\n\nEXAMPLE: Ten-section aggregate: put the conclusions section first.\n\nWHY THE TRAP IS WRONG: Burying the key finding mid-document risks omission.","rawText":"DECIDING QUESTION: Where does the model reliably read?\n\nLOOK FOR → TOP: 'lost in the middle', 'aggregated inputs', 'long documents'. LOOK FOR → END: weaker choice.\nStart and end are used reliably; the middle may be skipped.\n\nHOW TO DECIDE: Put key findings at the START under explicit section headers.\n\nEXAMPLE: Ten-section aggregate: put the conclusions section first.\n\nWHY THE TRAP IS WRONG: Burying the key finding mid-document risks omission.","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"DECIDING QUESTION: Where does the model reliably read?\n\nLOOK FOR → TOP: 'lost in the middle', 'aggregated inputs', 'long documents'. LOOK FOR → END: weaker choice.\nStart and end are used reliably; the middle may be skipped.\n\nHOW TO DECIDE: Put key findings at the START under explicit section headers.\n\nEXAMPLE: Ten-section aggregate: put the conclusions section first.\n\nWHY THE TRAP IS WRONG: Burying the key finding mid-document risks omission.","lineHeight":1.25},{"id":"r-331","type":"rectangle","x":1190,"y":4360.280000000001,"width":1150,"height":234.6,"angle":0,"strokeColor":"#b4303a","backgroundColor":"#fff0f0","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":332,"version":1,"versionNonce":333,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-334","type":"text","x":1206,"y":4372.280000000001,"width":1118,"height":23,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":335,"version":1,"versionNonce":336,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"4 · ESCALATE IMMEDIATELY  vs  ACKNOWLEDGE AND OFFER","rawText":"4 · ESCALATE IMMEDIATELY  vs  ACKNOWLEDGE AND OFFER","fontSize":17,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":17,"containerId":null,"originalText":"4 · ESCALATE IMMEDIATELY  vs  ACKNOWLEDGE AND OFFER","lineHeight":1.25},{"id":"t-337","type":"text","x":1206,"y":4403.280000000001,"width":1118,"height":171.6,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":338,"version":1,"versionNonce":339,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"DECIDING QUESTION: Did the customer explicitly demand a human?\n\nLOOK FOR → IMMEDIATE: 'I want to speak to a person'. LOOK FOR → OFFER: frustrated, but the case is straightforward and no demand was made.\nExplicit demand is honored at once; frustration alone isn't a trigger.\n\nHOW TO DECIDE: Explicit request? yes → escalate now. No → acknowledge, offer to resolve; escalate if they repeat the demand.\n\nEXAMPLE: 'This is ridiculous!' on a late-order lookup → apologize and fix. 'Get me a human' → hand off.\n\nWHY THE TRAP IS WRONG: Investigating first after an explicit demand frustrates the customer; auto-escalating on mood floods humans.","rawText":"DECIDING QUESTION: Did the customer explicitly demand a human?\n\nLOOK FOR → IMMEDIATE: 'I want to speak to a person'. LOOK FOR → OFFER: frustrated, but the case is straightforward and no demand was made.\nExplicit demand is honored at once; frustration alone isn't a trigger.\n\nHOW TO DECIDE: Explicit request? yes → escalate now. No → acknowledge, offer to resolve; escalate if they repeat the demand.\n\nEXAMPLE: 'This is ridiculous!' on a late-order lookup → apologize and fix. 'Get me a human' → hand off.\n\nWHY THE TRAP IS WRONG: Investigating first after an explicit demand frustrates the customer; auto-escalating on mood floods humans.","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"DECIDING QUESTION: Did the customer explicitly demand a human?\n\nLOOK FOR → IMMEDIATE: 'I want to speak to a person'. LOOK FOR → OFFER: frustrated, but the case is straightforward and no demand was made.\nExplicit demand is honored at once; frustration alone isn't a trigger.\n\nHOW TO DECIDE: Explicit request? yes → escalate now. No → acknowledge, offer to resolve; escalate if they repeat the demand.\n\nEXAMPLE: 'This is ridiculous!' on a late-order lookup → apologize and fix. 'Get me a human' → hand off.\n\nWHY THE TRAP IS WRONG: Investigating first after an explicit demand frustrates the customer; auto-escalating on mood floods humans.","lineHeight":1.25},{"id":"r-340","type":"rectangle","x":0,"y":4618.880000000001,"width":1150,"height":251.76000000000002,"angle":0,"strokeColor":"#b4303a","backgroundColor":"#fff0f0","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":341,"version":1,"versionNonce":342,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-343","type":"text","x":16,"y":4630.880000000001,"width":1118,"height":23,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":344,"version":1,"versionNonce":345,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"5 · EXPLICIT CRITERIA + FEW-SHOT  vs  SENTIMENT / CONFIDENCE ROUTING","rawText":"5 · EXPLICIT CRITERIA + FEW-SHOT  vs  SENTIMENT / CONFIDENCE ROUTING","fontSize":17,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":17,"containerId":null,"originalText":"5 · EXPLICIT CRITERIA + FEW-SHOT  vs  SENTIMENT / CONFIDENCE ROUTING","lineHeight":1.25},{"id":"t-346","type":"text","x":16,"y":4661.880000000001,"width":1118,"height":188.76000000000002,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":347,"version":1,"versionNonce":348,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"DECIDING QUESTION: How should escalation be decided? (Sample Q3)\n\nLOOK FOR → CORRECT: written criteria for the four triggers + few-shot examples. LOOK FOR → TRAPS: sentiment analysis, self-reported confidence, a separate\nclassifier.\nSentiment ≠ complexity; self-reported confidence is wrong on the hard cases.\n\nHOW TO DECIDE: Define when to escalate (exception, policy gap, no progress, ambiguity) and show examples.\n\nEXAMPLE: A calm customer asks for a competitor price-match; policy is silent → escalate even though sentiment is neutral.\n\nWHY THE TRAP IS WRONG: Mood and model confidence both miss the cases that matter.","rawText":"DECIDING QUESTION: How should escalation be decided? (Sample Q3)\n\nLOOK FOR → CORRECT: written criteria for the four triggers + few-shot examples. LOOK FOR → TRAPS: sentiment analysis, self-reported confidence, a separate\nclassifier.\nSentiment ≠ complexity; self-reported confidence is wrong on the hard cases.\n\nHOW TO DECIDE: Define when to escalate (exception, policy gap, no progress, ambiguity) and show examples.\n\nEXAMPLE: A calm customer asks for a competitor price-match; policy is silent → escalate even though sentiment is neutral.\n\nWHY THE TRAP IS WRONG: Mood and model confidence both miss the cases that matter.","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"DECIDING QUESTION: How should escalation be decided? (Sample Q3)\n\nLOOK FOR → CORRECT: written criteria for the four triggers + few-shot examples. LOOK FOR → TRAPS: sentiment analysis, self-reported confidence, a separate\nclassifier.\nSentiment ≠ complexity; self-reported confidence is wrong on the hard cases.\n\nHOW TO DECIDE: Define when to escalate (exception, policy gap, no progress, ambiguity) and show examples.\n\nEXAMPLE: A calm customer asks for a competitor price-match; policy is silent → escalate even though sentiment is neutral.\n\nWHY THE TRAP IS WRONG: Mood and model confidence both miss the cases that matter.","lineHeight":1.25},{"id":"r-349","type":"rectangle","x":1190,"y":4618.880000000001,"width":1150,"height":234.6,"angle":0,"strokeColor":"#b4303a","backgroundColor":"#fff0f0","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":350,"version":1,"versionNonce":351,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-352","type":"text","x":1206,"y":4630.880000000001,"width":1118,"height":23,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":353,"version":1,"versionNonce":354,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"6 · ASK FOR IDENTIFIERS  vs  PICK THE LIKELY MATCH","rawText":"6 · ASK FOR IDENTIFIERS  vs  PICK THE LIKELY MATCH","fontSize":17,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":17,"containerId":null,"originalText":"6 · ASK FOR IDENTIFIERS  vs  PICK THE LIKELY MATCH","lineHeight":1.25},{"id":"t-355","type":"text","x":1206,"y":4661.880000000001,"width":1118,"height":171.6,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":356,"version":1,"versionNonce":357,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"DECIDING QUESTION: A lookup returns several plausible records — what now?\n\nLOOK FOR → ASK: 'two customers match', 'ambiguous'. LOOK FOR → PICK: heuristics like 'most recent'.\nGuessing risks acting on the wrong person's account.\n\nHOW TO DECIDE: More than one plausible match → request additional identifiers.\n\nEXAMPLE: Two 'J. Patel' accounts → ask for email or order number.\n\nWHY THE TRAP IS WRONG: Heuristic picks are silent errors.","rawText":"DECIDING QUESTION: A lookup returns several plausible records — what now?\n\nLOOK FOR → ASK: 'two customers match', 'ambiguous'. LOOK FOR → PICK: heuristics like 'most recent'.\nGuessing risks acting on the wrong person's account.\n\nHOW TO DECIDE: More than one plausible match → request additional identifiers.\n\nEXAMPLE: Two 'J. Patel' accounts → ask for email or order number.\n\nWHY THE TRAP IS WRONG: Heuristic picks are silent errors.","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"DECIDING QUESTION: A lookup returns several plausible records — what now?\n\nLOOK FOR → ASK: 'two customers match', 'ambiguous'. LOOK FOR → PICK: heuristics like 'most recent'.\nGuessing risks acting on the wrong person's account.\n\nHOW TO DECIDE: More than one plausible match → request additional identifiers.\n\nEXAMPLE: Two 'J. Patel' accounts → ask for email or order number.\n\nWHY THE TRAP IS WRONG: Heuristic picks are silent errors.","lineHeight":1.25},{"id":"r-358","type":"rectangle","x":0,"y":4894.640000000001,"width":1150,"height":234.6,"angle":0,"strokeColor":"#b4303a","backgroundColor":"#fff0f0","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":359,"version":1,"versionNonce":360,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-361","type":"text","x":16,"y":4906.640000000001,"width":1118,"height":23,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":362,"version":1,"versionNonce":363,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"7 · STRUCTURED ERROR ENVELOPE  vs  GENERIC STATUS","rawText":"7 · STRUCTURED ERROR ENVELOPE  vs  GENERIC STATUS","fontSize":17,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":17,"containerId":null,"originalText":"7 · STRUCTURED ERROR ENVELOPE  vs  GENERIC STATUS","lineHeight":1.25},{"id":"t-364","type":"text","x":16,"y":4937.640000000001,"width":1118,"height":171.6,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":365,"version":1,"versionNonce":366,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"DECIDING QUESTION: What does the coordinator need to recover? (Sample Q8)\n\nLOOK FOR → ENVELOPE: failure type, attempted query, partial results, alternatives. LOOK FOR → GENERIC: 'search unavailable'.\nGeneric hides what was tried and what partial data exists.\n\nHOW TO DECIDE: Can the coordinator choose a recovery from this message? If not, it's too thin.\n\nEXAMPLE: Timeout → envelope with query, retry count, partial results, alternatives.\n\nWHY THE TRAP IS WRONG: Generic errors force blind retries or total failure.","rawText":"DECIDING QUESTION: What does the coordinator need to recover? (Sample Q8)\n\nLOOK FOR → ENVELOPE: failure type, attempted query, partial results, alternatives. LOOK FOR → GENERIC: 'search unavailable'.\nGeneric hides what was tried and what partial data exists.\n\nHOW TO DECIDE: Can the coordinator choose a recovery from this message? If not, it's too thin.\n\nEXAMPLE: Timeout → envelope with query, retry count, partial results, alternatives.\n\nWHY THE TRAP IS WRONG: Generic errors force blind retries or total failure.","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"DECIDING QUESTION: What does the coordinator need to recover? (Sample Q8)\n\nLOOK FOR → ENVELOPE: failure type, attempted query, partial results, alternatives. LOOK FOR → GENERIC: 'search unavailable'.\nGeneric hides what was tried and what partial data exists.\n\nHOW TO DECIDE: Can the coordinator choose a recovery from this message? If not, it's too thin.\n\nEXAMPLE: Timeout → envelope with query, retry count, partial results, alternatives.\n\nWHY THE TRAP IS WRONG: Generic errors force blind retries or total failure.","lineHeight":1.25},{"id":"r-367","type":"rectangle","x":1190,"y":4894.640000000001,"width":1150,"height":234.6,"angle":0,"strokeColor":"#b4303a","backgroundColor":"#fff0f0","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":368,"version":1,"versionNonce":369,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-370","type":"text","x":1206,"y":4906.640000000001,"width":1118,"height":23,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":371,"version":1,"versionNonce":372,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"8 · ACCESS FAILURE (RETRY)  vs  VALID EMPTY RESULT (DON'T)","rawText":"8 · ACCESS FAILURE (RETRY)  vs  VALID EMPTY RESULT (DON'T)","fontSize":17,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":17,"containerId":null,"originalText":"8 · ACCESS FAILURE (RETRY)  vs  VALID EMPTY RESULT (DON'T)","lineHeight":1.25},{"id":"t-373","type":"text","x":1206,"y":4937.640000000001,"width":1118,"height":171.6,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":374,"version":1,"versionNonce":375,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"DECIDING QUESTION: Did the query fail, or succeed with nothing found?\n\nLOOK FOR → ACCESS FAILURE: timeout, permission denied, 5xx. LOOK FOR → EMPTY: status ok, zero results.\nFailures may be transient; an empty result is a true answer.\n\nHOW TO DECIDE: Did the call complete correctly? Yes → empty is data. No → failure, retry candidate.\n\nEXAMPLE: 'No matching orders' is a result. A 503 is a failure.\n\nWHY THE TRAP IS WRONG: Retrying an empty result wastes work; hiding a failure as empty hides the gap.","rawText":"DECIDING QUESTION: Did the query fail, or succeed with nothing found?\n\nLOOK FOR → ACCESS FAILURE: timeout, permission denied, 5xx. LOOK FOR → EMPTY: status ok, zero results.\nFailures may be transient; an empty result is a true answer.\n\nHOW TO DECIDE: Did the call complete correctly? Yes → empty is data. No → failure, retry candidate.\n\nEXAMPLE: 'No matching orders' is a result. A 503 is a failure.\n\nWHY THE TRAP IS WRONG: Retrying an empty result wastes work; hiding a failure as empty hides the gap.","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"DECIDING QUESTION: Did the query fail, or succeed with nothing found?\n\nLOOK FOR → ACCESS FAILURE: timeout, permission denied, 5xx. LOOK FOR → EMPTY: status ok, zero results.\nFailures may be transient; an empty result is a true answer.\n\nHOW TO DECIDE: Did the call complete correctly? Yes → empty is data. No → failure, retry candidate.\n\nEXAMPLE: 'No matching orders' is a result. A 503 is a failure.\n\nWHY THE TRAP IS WRONG: Retrying an empty result wastes work; hiding a failure as empty hides the gap.","lineHeight":1.25},{"id":"r-376","type":"rectangle","x":0,"y":5153.240000000002,"width":1150,"height":234.6,"angle":0,"strokeColor":"#b4303a","backgroundColor":"#fff0f0","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":377,"version":1,"versionNonce":378,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-379","type":"text","x":16,"y":5165.240000000002,"width":1118,"height":23,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":380,"version":1,"versionNonce":381,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"9 · LOCAL RECOVERY  vs  PROPAGATE TO COORDINATOR","rawText":"9 · LOCAL RECOVERY  vs  PROPAGATE TO COORDINATOR","fontSize":17,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":17,"containerId":null,"originalText":"9 · LOCAL RECOVERY  vs  PROPAGATE TO COORDINATOR","lineHeight":1.25},{"id":"t-382","type":"text","x":16,"y":5196.240000000002,"width":1118,"height":171.6,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":383,"version":1,"versionNonce":384,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"DECIDING QUESTION: Who handles the failure?\n\nLOOK FOR → LOCAL: transient failure; subagent retries 1–2× with backoff. LOOK FOR → PROPAGATE: unrecoverable after retries.\nOnly unrecoverable failures go up, with attempted query and partial results.\n\nHOW TO DECIDE: Transient? retry locally. Still failing? propagate with context.\n\nEXAMPLE: Search times out once, succeeds on retry — coordinator never knows. Fails thrice — coordinator gets the envelope.\n\nWHY THE TRAP IS WRONG: Escalating every blip floods the coordinator; swallowing real failures hides gaps.","rawText":"DECIDING QUESTION: Who handles the failure?\n\nLOOK FOR → LOCAL: transient failure; subagent retries 1–2× with backoff. LOOK FOR → PROPAGATE: unrecoverable after retries.\nOnly unrecoverable failures go up, with attempted query and partial results.\n\nHOW TO DECIDE: Transient? retry locally. Still failing? propagate with context.\n\nEXAMPLE: Search times out once, succeeds on retry — coordinator never knows. Fails thrice — coordinator gets the envelope.\n\nWHY THE TRAP IS WRONG: Escalating every blip floods the coordinator; swallowing real failures hides gaps.","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"DECIDING QUESTION: Who handles the failure?\n\nLOOK FOR → LOCAL: transient failure; subagent retries 1–2× with backoff. LOOK FOR → PROPAGATE: unrecoverable after retries.\nOnly unrecoverable failures go up, with attempted query and partial results.\n\nHOW TO DECIDE: Transient? retry locally. Still failing? propagate with context.\n\nEXAMPLE: Search times out once, succeeds on retry — coordinator never knows. Fails thrice — coordinator gets the envelope.\n\nWHY THE TRAP IS WRONG: Escalating every blip floods the coordinator; swallowing real failures hides gaps.","lineHeight":1.25},{"id":"r-385","type":"rectangle","x":1190,"y":5153.240000000002,"width":1150,"height":234.6,"angle":0,"strokeColor":"#b4303a","backgroundColor":"#fff0f0","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":386,"version":1,"versionNonce":387,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-388","type":"text","x":1206,"y":5165.240000000002,"width":1118,"height":23,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":389,"version":1,"versionNonce":390,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"10 · CONTINUE WITH PARTIAL RESULTS  vs  TERMINATE THE WORKFLOW","rawText":"10 · CONTINUE WITH PARTIAL RESULTS  vs  TERMINATE THE WORKFLOW","fontSize":17,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":17,"containerId":null,"originalText":"10 · CONTINUE WITH PARTIAL RESULTS  vs  TERMINATE THE WORKFLOW","lineHeight":1.25},{"id":"t-391","type":"text","x":1206,"y":5196.240000000002,"width":1118,"height":171.6,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":392,"version":1,"versionNonce":393,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"DECIDING QUESTION: One subagent failed — do you abort?\n\nLOOK FOR → CONTINUE: other subagents succeeded. LOOK FOR → TERMINATE: (anti-pattern).\nKilling successful work is wasteful; hiding the gap is misleading.\n\nHOW TO DECIDE: Proceed with partial data and annotate the coverage gap.\n\nEXAMPLE: Regional-news agent fails; report the other regions and mark that one as a gap.\n\nWHY THE TRAP IS WRONG: Terminating discards good results.","rawText":"DECIDING QUESTION: One subagent failed — do you abort?\n\nLOOK FOR → CONTINUE: other subagents succeeded. LOOK FOR → TERMINATE: (anti-pattern).\nKilling successful work is wasteful; hiding the gap is misleading.\n\nHOW TO DECIDE: Proceed with partial data and annotate the coverage gap.\n\nEXAMPLE: Regional-news agent fails; report the other regions and mark that one as a gap.\n\nWHY THE TRAP IS WRONG: Terminating discards good results.","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"DECIDING QUESTION: One subagent failed — do you abort?\n\nLOOK FOR → CONTINUE: other subagents succeeded. LOOK FOR → TERMINATE: (anti-pattern).\nKilling successful work is wasteful; hiding the gap is misleading.\n\nHOW TO DECIDE: Proceed with partial data and annotate the coverage gap.\n\nEXAMPLE: Regional-news agent fails; report the other regions and mark that one as a gap.\n\nWHY THE TRAP IS WRONG: Terminating discards good results.","lineHeight":1.25},{"id":"r-394","type":"rectangle","x":0,"y":5411.840000000002,"width":1150,"height":234.6,"angle":0,"strokeColor":"#b4303a","backgroundColor":"#fff0f0","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":395,"version":1,"versionNonce":396,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-397","type":"text","x":16,"y":5423.840000000002,"width":1118,"height":23,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":398,"version":1,"versionNonce":399,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"11 · SUBAGENT SUMMARY  vs  RAW OUTPUT IN MAIN CONTEXT","rawText":"11 · SUBAGENT SUMMARY  vs  RAW OUTPUT IN MAIN CONTEXT","fontSize":17,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":17,"containerId":null,"originalText":"11 · SUBAGENT SUMMARY  vs  RAW OUTPUT IN MAIN CONTEXT","lineHeight":1.25},{"id":"t-400","type":"text","x":16,"y":5454.840000000002,"width":1118,"height":171.6,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":401,"version":1,"versionNonce":402,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"DECIDING QUESTION: Where should verbose exploration happen?\n\nLOOK FOR → SUBAGENT: 'grep results flood context', 'long exploration'. LOOK FOR → MAIN: short, targeted lookups.\nSubagents keep ~50K tokens of raw output out of the main context and return ~200.\n\nHOW TO DECIDE: Is the output noisy and only the conclusion matters? → subagent.\n\nEXAMPLE: 'Find all refund-related tests' → Explore subagent returns a short list.\n\nWHY THE TRAP IS WRONG: Raw output in main context accelerates degradation.","rawText":"DECIDING QUESTION: Where should verbose exploration happen?\n\nLOOK FOR → SUBAGENT: 'grep results flood context', 'long exploration'. LOOK FOR → MAIN: short, targeted lookups.\nSubagents keep ~50K tokens of raw output out of the main context and return ~200.\n\nHOW TO DECIDE: Is the output noisy and only the conclusion matters? → subagent.\n\nEXAMPLE: 'Find all refund-related tests' → Explore subagent returns a short list.\n\nWHY THE TRAP IS WRONG: Raw output in main context accelerates degradation.","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"DECIDING QUESTION: Where should verbose exploration happen?\n\nLOOK FOR → SUBAGENT: 'grep results flood context', 'long exploration'. LOOK FOR → MAIN: short, targeted lookups.\nSubagents keep ~50K tokens of raw output out of the main context and return ~200.\n\nHOW TO DECIDE: Is the output noisy and only the conclusion matters? → subagent.\n\nEXAMPLE: 'Find all refund-related tests' → Explore subagent returns a short list.\n\nWHY THE TRAP IS WRONG: Raw output in main context accelerates degradation.","lineHeight":1.25},{"id":"r-403","type":"rectangle","x":1190,"y":5411.840000000002,"width":1150,"height":234.6,"angle":0,"strokeColor":"#b4303a","backgroundColor":"#fff0f0","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":404,"version":1,"versionNonce":405,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-406","type":"text","x":1206,"y":5423.840000000002,"width":1118,"height":23,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":407,"version":1,"versionNonce":408,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"12 · SCRATCHPAD FILE  vs  /compact ONLY","rawText":"12 · SCRATCHPAD FILE  vs  /compact ONLY","fontSize":17,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":17,"containerId":null,"originalText":"12 · SCRATCHPAD FILE  vs  /compact ONLY","lineHeight":1.25},{"id":"t-409","type":"text","x":1206,"y":5454.840000000002,"width":1118,"height":171.6,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":410,"version":1,"versionNonce":411,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"DECIDING QUESTION: What survives a compaction or a crash?\n\nLOOK FOR → SCRATCHPAD: 'persist findings', 'resume after crash'. LOOK FOR → /compact: 'context nearly full'.\n/compact keeps tasks and decisions but loses detailed tool output; files on disk survive.\n\nHOW TO DECIDE: Need durable facts? → write to scratchpad/manifest first, then /compact.\n\nEXAMPLE: Trace the refund flow into scratch/refund-flow.md, then /compact safely.\n\nWHY THE TRAP IS WRONG: Relying on compaction alone can lose specifics.","rawText":"DECIDING QUESTION: What survives a compaction or a crash?\n\nLOOK FOR → SCRATCHPAD: 'persist findings', 'resume after crash'. LOOK FOR → /compact: 'context nearly full'.\n/compact keeps tasks and decisions but loses detailed tool output; files on disk survive.\n\nHOW TO DECIDE: Need durable facts? → write to scratchpad/manifest first, then /compact.\n\nEXAMPLE: Trace the refund flow into scratch/refund-flow.md, then /compact safely.\n\nWHY THE TRAP IS WRONG: Relying on compaction alone can lose specifics.","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"DECIDING QUESTION: What survives a compaction or a crash?\n\nLOOK FOR → SCRATCHPAD: 'persist findings', 'resume after crash'. LOOK FOR → /compact: 'context nearly full'.\n/compact keeps tasks and decisions but loses detailed tool output; files on disk survive.\n\nHOW TO DECIDE: Need durable facts? → write to scratchpad/manifest first, then /compact.\n\nEXAMPLE: Trace the refund flow into scratch/refund-flow.md, then /compact safely.\n\nWHY THE TRAP IS WRONG: Relying on compaction alone can lose specifics.","lineHeight":1.25},{"id":"r-412","type":"rectangle","x":0,"y":5670.440000000002,"width":1150,"height":234.6,"angle":0,"strokeColor":"#b4303a","backgroundColor":"#fff0f0","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":413,"version":1,"versionNonce":414,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-415","type":"text","x":16,"y":5682.440000000002,"width":1118,"height":23,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":416,"version":1,"versionNonce":417,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"13 · MANIFEST  vs  START OVER AFTER A CRASH","rawText":"13 · MANIFEST  vs  START OVER AFTER A CRASH","fontSize":17,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":17,"containerId":null,"originalText":"13 · MANIFEST  vs  START OVER AFTER A CRASH","lineHeight":1.25},{"id":"t-418","type":"text","x":16,"y":5713.440000000002,"width":1118,"height":171.6,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":419,"version":1,"versionNonce":420,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"DECIDING QUESTION: How does a new session continue?\n\nLOOK FOR → MANIFEST: 'resume', 'crash recovery'. LOOK FOR → RESTART: wasteful.\nThe manifest records phase, completed steps, open questions, file resume summaries, subagent statuses.\n\nHOW TO DECIDE: Load manifest → re-inject resume summaries → read files only if needed.\n\nEXAMPLE: Phase 3 crash: new session sees phases 1–2 done and continues.\n\nWHY THE TRAP IS WRONG: Restarting repeats finished work.","rawText":"DECIDING QUESTION: How does a new session continue?\n\nLOOK FOR → MANIFEST: 'resume', 'crash recovery'. LOOK FOR → RESTART: wasteful.\nThe manifest records phase, completed steps, open questions, file resume summaries, subagent statuses.\n\nHOW TO DECIDE: Load manifest → re-inject resume summaries → read files only if needed.\n\nEXAMPLE: Phase 3 crash: new session sees phases 1–2 done and continues.\n\nWHY THE TRAP IS WRONG: Restarting repeats finished work.","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"DECIDING QUESTION: How does a new session continue?\n\nLOOK FOR → MANIFEST: 'resume', 'crash recovery'. LOOK FOR → RESTART: wasteful.\nThe manifest records phase, completed steps, open questions, file resume summaries, subagent statuses.\n\nHOW TO DECIDE: Load manifest → re-inject resume summaries → read files only if needed.\n\nEXAMPLE: Phase 3 crash: new session sees phases 1–2 done and continues.\n\nWHY THE TRAP IS WRONG: Restarting repeats finished work.","lineHeight":1.25},{"id":"r-421","type":"rectangle","x":1190,"y":5670.440000000002,"width":1150,"height":234.6,"angle":0,"strokeColor":"#b4303a","backgroundColor":"#fff0f0","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":422,"version":1,"versionNonce":423,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-424","type":"text","x":1206,"y":5682.440000000002,"width":1118,"height":23,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":425,"version":1,"versionNonce":426,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"14 · AGGREGATE ACCURACY  vs  PER-TYPE / PER-FIELD ACCURACY","rawText":"14 · AGGREGATE ACCURACY  vs  PER-TYPE / PER-FIELD ACCURACY","fontSize":17,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":17,"containerId":null,"originalText":"14 · AGGREGATE ACCURACY  vs  PER-TYPE / PER-FIELD ACCURACY","lineHeight":1.25},{"id":"t-427","type":"text","x":1206,"y":5713.440000000002,"width":1118,"height":171.6,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":428,"version":1,"versionNonce":429,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"DECIDING QUESTION: Can one overall number justify auto-approval?\n\nLOOK FOR → PER-SEGMENT: '97% overall', 'one document type failing'. LOOK FOR → AGGREGATE: (trap).\nAverages hide weak segments (invoices 99.5%, contracts 65%).\n\nHOW TO DECIDE: Measure accuracy by document type AND field before automating.\n\nEXAMPLE: Contracts' payment terms are wrong 35% of the time but vanish in the average.\n\nWHY THE TRAP IS WRONG: A good overall number can mask a broken pipeline.","rawText":"DECIDING QUESTION: Can one overall number justify auto-approval?\n\nLOOK FOR → PER-SEGMENT: '97% overall', 'one document type failing'. LOOK FOR → AGGREGATE: (trap).\nAverages hide weak segments (invoices 99.5%, contracts 65%).\n\nHOW TO DECIDE: Measure accuracy by document type AND field before automating.\n\nEXAMPLE: Contracts' payment terms are wrong 35% of the time but vanish in the average.\n\nWHY THE TRAP IS WRONG: A good overall number can mask a broken pipeline.","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"DECIDING QUESTION: Can one overall number justify auto-approval?\n\nLOOK FOR → PER-SEGMENT: '97% overall', 'one document type failing'. LOOK FOR → AGGREGATE: (trap).\nAverages hide weak segments (invoices 99.5%, contracts 65%).\n\nHOW TO DECIDE: Measure accuracy by document type AND field before automating.\n\nEXAMPLE: Contracts' payment terms are wrong 35% of the time but vanish in the average.\n\nWHY THE TRAP IS WRONG: A good overall number can mask a broken pipeline.","lineHeight":1.25},{"id":"r-430","type":"rectangle","x":0,"y":5929.040000000003,"width":1150,"height":234.6,"angle":0,"strokeColor":"#b4303a","backgroundColor":"#fff0f0","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":431,"version":1,"versionNonce":432,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-433","type":"text","x":16,"y":5941.040000000003,"width":1118,"height":23,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":434,"version":1,"versionNonce":435,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"15 · FIELD-LEVEL CONFIDENCE  vs  DOCUMENT-LEVEL CONFIDENCE","rawText":"15 · FIELD-LEVEL CONFIDENCE  vs  DOCUMENT-LEVEL CONFIDENCE","fontSize":17,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":17,"containerId":null,"originalText":"15 · FIELD-LEVEL CONFIDENCE  vs  DOCUMENT-LEVEL CONFIDENCE","lineHeight":1.25},{"id":"t-436","type":"text","x":16,"y":5972.040000000003,"width":1118,"height":171.6,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":437,"version":1,"versionNonce":438,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"DECIDING QUESTION: Is the whole document equally reliable?\n\nLOOK FOR → FIELD-LEVEL: 'total is certain, payment terms aren't'. LOOK FOR → DOCUMENT-LEVEL: coarse.\nFields differ in difficulty; one score hides weak fields.\n\nHOW TO DECIDE: Score and calibrate per field; route weak fields to review.\n\nEXAMPLE: Total amount high-confidence, payment terms low → review just the terms.\n\nWHY THE TRAP IS WRONG: Document-level scores either over-review or under-review.","rawText":"DECIDING QUESTION: Is the whole document equally reliable?\n\nLOOK FOR → FIELD-LEVEL: 'total is certain, payment terms aren't'. LOOK FOR → DOCUMENT-LEVEL: coarse.\nFields differ in difficulty; one score hides weak fields.\n\nHOW TO DECIDE: Score and calibrate per field; route weak fields to review.\n\nEXAMPLE: Total amount high-confidence, payment terms low → review just the terms.\n\nWHY THE TRAP IS WRONG: Document-level scores either over-review or under-review.","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"DECIDING QUESTION: Is the whole document equally reliable?\n\nLOOK FOR → FIELD-LEVEL: 'total is certain, payment terms aren't'. LOOK FOR → DOCUMENT-LEVEL: coarse.\nFields differ in difficulty; one score hides weak fields.\n\nHOW TO DECIDE: Score and calibrate per field; route weak fields to review.\n\nEXAMPLE: Total amount high-confidence, payment terms low → review just the terms.\n\nWHY THE TRAP IS WRONG: Document-level scores either over-review or under-review.","lineHeight":1.25},{"id":"r-439","type":"rectangle","x":1190,"y":5929.040000000003,"width":1150,"height":234.6,"angle":0,"strokeColor":"#b4303a","backgroundColor":"#fff0f0","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":440,"version":1,"versionNonce":441,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-442","type":"text","x":1206,"y":5941.040000000003,"width":1118,"height":23,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":443,"version":1,"versionNonce":444,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"16 · CALIBRATED CONFIDENCE  vs  RAW SELF-REPORTED CONFIDENCE","rawText":"16 · CALIBRATED CONFIDENCE  vs  RAW SELF-REPORTED CONFIDENCE","fontSize":17,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":17,"containerId":null,"originalText":"16 · CALIBRATED CONFIDENCE  vs  RAW SELF-REPORTED CONFIDENCE","lineHeight":1.25},{"id":"t-445","type":"text","x":1206,"y":5972.040000000003,"width":1118,"height":171.6,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":446,"version":1,"versionNonce":447,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"DECIDING QUESTION: Can you trust the model's stated confidence?\n\nLOOK FOR → CALIBRATED: labeled validation set, buckets, thresholds. LOOK FOR → RAW: 'the model says 0.95'.\nRaw confidence is poorly calibrated; confidently wrong on hard cases.\n\nHOW TO DECIDE: Bucket by confidence, measure actual accuracy, set the threshold by error budget; recalibrate per type and on model change.\n\nEXAMPLE: Contracts at 0.9 are only 80% right; set a higher threshold for them.\n\nWHY THE TRAP IS WRONG: Uncalibrated thresholds auto-approve errors.","rawText":"DECIDING QUESTION: Can you trust the model's stated confidence?\n\nLOOK FOR → CALIBRATED: labeled validation set, buckets, thresholds. LOOK FOR → RAW: 'the model says 0.95'.\nRaw confidence is poorly calibrated; confidently wrong on hard cases.\n\nHOW TO DECIDE: Bucket by confidence, measure actual accuracy, set the threshold by error budget; recalibrate per type and on model change.\n\nEXAMPLE: Contracts at 0.9 are only 80% right; set a higher threshold for them.\n\nWHY THE TRAP IS WRONG: Uncalibrated thresholds auto-approve errors.","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"DECIDING QUESTION: Can you trust the model's stated confidence?\n\nLOOK FOR → CALIBRATED: labeled validation set, buckets, thresholds. LOOK FOR → RAW: 'the model says 0.95'.\nRaw confidence is poorly calibrated; confidently wrong on hard cases.\n\nHOW TO DECIDE: Bucket by confidence, measure actual accuracy, set the threshold by error budget; recalibrate per type and on model change.\n\nEXAMPLE: Contracts at 0.9 are only 80% right; set a higher threshold for them.\n\nWHY THE TRAP IS WRONG: Uncalibrated thresholds auto-approve errors.","lineHeight":1.25},{"id":"r-448","type":"rectangle","x":0,"y":6187.640000000003,"width":1150,"height":234.6,"angle":0,"strokeColor":"#b4303a","backgroundColor":"#fff0f0","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":449,"version":1,"versionNonce":450,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-451","type":"text","x":16,"y":6199.640000000003,"width":1118,"height":23,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":452,"version":1,"versionNonce":453,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"17 · STRATIFIED AUDIT OF AUTO-APPROVED  vs  TRUST HIGH CONFIDENCE","rawText":"17 · STRATIFIED AUDIT OF AUTO-APPROVED  vs  TRUST HIGH CONFIDENCE","fontSize":17,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":17,"containerId":null,"originalText":"17 · STRATIFIED AUDIT OF AUTO-APPROVED  vs  TRUST HIGH CONFIDENCE","lineHeight":1.25},{"id":"t-454","type":"text","x":16,"y":6230.640000000003,"width":1118,"height":171.6,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":455,"version":1,"versionNonce":456,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"DECIDING QUESTION: How do you catch errors the model is sure about?\n\nLOOK FOR → STRATIFIED AUDIT: ~2% sample by type × field. LOOK FOR → TRUST: no audit.\nNovel error patterns hide in the high-confidence stream.\n\nHOW TO DECIDE: Sample each segment, not one random pile; prioritize reviewers by risk.\n\nEXAMPLE: A new contract clause breaks extraction; the audit sample finds it.\n\nWHY THE TRAP IS WRONG: No audit means silent drift.","rawText":"DECIDING QUESTION: How do you catch errors the model is sure about?\n\nLOOK FOR → STRATIFIED AUDIT: ~2% sample by type × field. LOOK FOR → TRUST: no audit.\nNovel error patterns hide in the high-confidence stream.\n\nHOW TO DECIDE: Sample each segment, not one random pile; prioritize reviewers by risk.\n\nEXAMPLE: A new contract clause breaks extraction; the audit sample finds it.\n\nWHY THE TRAP IS WRONG: No audit means silent drift.","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"DECIDING QUESTION: How do you catch errors the model is sure about?\n\nLOOK FOR → STRATIFIED AUDIT: ~2% sample by type × field. LOOK FOR → TRUST: no audit.\nNovel error patterns hide in the high-confidence stream.\n\nHOW TO DECIDE: Sample each segment, not one random pile; prioritize reviewers by risk.\n\nEXAMPLE: A new contract clause breaks extraction; the audit sample finds it.\n\nWHY THE TRAP IS WRONG: No audit means silent drift.","lineHeight":1.25},{"id":"r-457","type":"rectangle","x":1190,"y":6187.640000000003,"width":1150,"height":234.6,"angle":0,"strokeColor":"#b4303a","backgroundColor":"#fff0f0","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":458,"version":1,"versionNonce":459,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-460","type":"text","x":1206,"y":6199.640000000003,"width":1118,"height":23,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":461,"version":1,"versionNonce":462,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"18 · ANNOTATE BOTH SOURCES  vs  PICK ONE VALUE","rawText":"18 · ANNOTATE BOTH SOURCES  vs  PICK ONE VALUE","fontSize":17,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":17,"containerId":null,"originalText":"18 · ANNOTATE BOTH SOURCES  vs  PICK ONE VALUE","lineHeight":1.25},{"id":"t-463","type":"text","x":1206,"y":6230.640000000003,"width":1118,"height":171.6,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":464,"version":1,"versionNonce":465,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"DECIDING QUESTION: Credible sources disagree — what do you report?\n\nLOOK FOR → ANNOTATE: 'two reputable sources, different numbers'. LOOK FOR → PICK: 'use the more recent/larger'.\nArbitrary resolution invents certainty.\n\nHOW TO DECIDE: Same period, different values → show both with attribution and reason (methodology); mark contested.\n\nEXAMPLE: Survey 4.1% vs payroll 3.8% → report both.\n\nWHY THE TRAP IS WRONG: Choosing one hides a real disagreement.","rawText":"DECIDING QUESTION: Credible sources disagree — what do you report?\n\nLOOK FOR → ANNOTATE: 'two reputable sources, different numbers'. LOOK FOR → PICK: 'use the more recent/larger'.\nArbitrary resolution invents certainty.\n\nHOW TO DECIDE: Same period, different values → show both with attribution and reason (methodology); mark contested.\n\nEXAMPLE: Survey 4.1% vs payroll 3.8% → report both.\n\nWHY THE TRAP IS WRONG: Choosing one hides a real disagreement.","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"DECIDING QUESTION: Credible sources disagree — what do you report?\n\nLOOK FOR → ANNOTATE: 'two reputable sources, different numbers'. LOOK FOR → PICK: 'use the more recent/larger'.\nArbitrary resolution invents certainty.\n\nHOW TO DECIDE: Same period, different values → show both with attribution and reason (methodology); mark contested.\n\nEXAMPLE: Survey 4.1% vs payroll 3.8% → report both.\n\nWHY THE TRAP IS WRONG: Choosing one hides a real disagreement.","lineHeight":1.25},{"id":"r-466","type":"rectangle","x":0,"y":6446.240000000003,"width":1150,"height":234.6,"angle":0,"strokeColor":"#b4303a","backgroundColor":"#fff0f0","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":467,"version":1,"versionNonce":468,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-469","type":"text","x":16,"y":6458.240000000003,"width":1118,"height":23,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":470,"version":1,"versionNonce":471,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"19 · CARRY DATES  vs  CONFLICT","rawText":"19 · CARRY DATES  vs  CONFLICT","fontSize":17,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":17,"containerId":null,"originalText":"19 · CARRY DATES  vs  CONFLICT","lineHeight":1.25},{"id":"t-472","type":"text","x":16,"y":6489.240000000003,"width":1118,"height":171.6,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":473,"version":1,"versionNonce":474,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"DECIDING QUESTION: Are the numbers contradictory or just from different times?\n\nLOOK FOR → DATES: 'numbers seem to contradict', time series. LOOK FOR → CONFLICT: same period, different values.\nMissing dates turn a time series into a false contradiction.\n\nHOW TO DECIDE: Check publication/collection dates before flagging a conflict.\n\nEXAMPLE: 12% (2023) and 18% (2025) aren't conflicting.\n\nWHY THE TRAP IS WRONG: Undated claims invite wrong 'conflict' flags.","rawText":"DECIDING QUESTION: Are the numbers contradictory or just from different times?\n\nLOOK FOR → DATES: 'numbers seem to contradict', time series. LOOK FOR → CONFLICT: same period, different values.\nMissing dates turn a time series into a false contradiction.\n\nHOW TO DECIDE: Check publication/collection dates before flagging a conflict.\n\nEXAMPLE: 12% (2023) and 18% (2025) aren't conflicting.\n\nWHY THE TRAP IS WRONG: Undated claims invite wrong 'conflict' flags.","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"DECIDING QUESTION: Are the numbers contradictory or just from different times?\n\nLOOK FOR → DATES: 'numbers seem to contradict', time series. LOOK FOR → CONFLICT: same period, different values.\nMissing dates turn a time series into a false contradiction.\n\nHOW TO DECIDE: Check publication/collection dates before flagging a conflict.\n\nEXAMPLE: 12% (2023) and 18% (2025) aren't conflicting.\n\nWHY THE TRAP IS WRONG: Undated claims invite wrong 'conflict' flags.","lineHeight":1.25},{"id":"r-475","type":"rectangle","x":1190,"y":6446.240000000003,"width":1150,"height":234.6,"angle":0,"strokeColor":"#b4303a","backgroundColor":"#fff0f0","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":476,"version":1,"versionNonce":477,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false},{"id":"t-478","type":"text","x":1206,"y":6458.240000000003,"width":1118,"height":23,"angle":0,"strokeColor":"#0f172a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":479,"version":1,"versionNonce":480,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"20 · STRUCTURED CLAIM→SOURCE MAPPING  vs  PROSE SUMMARY","rawText":"20 · STRUCTURED CLAIM→SOURCE MAPPING  vs  PROSE SUMMARY","fontSize":17,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":17,"containerId":null,"originalText":"20 · STRUCTURED CLAIM→SOURCE MAPPING  vs  PROSE SUMMARY","lineHeight":1.25},{"id":"t-481","type":"text","x":1206,"y":6489.240000000003,"width":1118,"height":171.6,"angle":0,"strokeColor":"#2b2b2b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":482,"version":1,"versionNonce":483,"isDeleted":false,"boundElements":null,"updated":1792553292016,"link":null,"locked":false,"text":"DECIDING QUESTION: Can the final report trace a number to its source?\n\nLOOK FOR → STRUCTURED: claims array with source, excerpt, date. LOOK FOR → PROSE: attribution lost.\nOnce lost, attribution can only be rebuilt by searching again.\n\nHOW TO DECIDE: Keep mappings as structured data through synthesis; the lead agent owns citation integrity.\n\nEXAMPLE: Each claim carries support entries and a conflict object when needed.\n\nWHY THE TRAP IS WRONG: A smooth prose summary looks fine but can't be verified.","rawText":"DECIDING QUESTION: Can the final report trace a number to its source?\n\nLOOK FOR → STRUCTURED: claims array with source, excerpt, date. LOOK FOR → PROSE: attribution lost.\nOnce lost, attribution can only be rebuilt by searching again.\n\nHOW TO DECIDE: Keep mappings as structured data through synthesis; the lead agent owns citation integrity.\n\nEXAMPLE: Each claim carries support entries and a conflict object when needed.\n\nWHY THE TRAP IS WRONG: A smooth prose summary looks fine but can't be verified.","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","baseline":13,"containerId":null,"originalText":"DECIDING QUESTION: Can the final report trace a number to its source?\n\nLOOK FOR → STRUCTURED: claims array with source, excerpt, date. LOOK FOR → PROSE: attribution lost.\nOnce lost, attribution can only be rebuilt by searching again.\n\nHOW TO DECIDE: Keep mappings as structured data through synthesis; the lead agent owns citation integrity.\n\nEXAMPLE: Each claim carries support entries and a conflict object when needed.\n\nWHY THE TRAP IS WRONG: A smooth prose summary looks fine but can't be verified.","lineHeight":1.25},{"id":"t-484","type":"text","x":0,"y":6724.840000000004,"width":2400,"height":36,"angle":0,"strokeColor":"#0f3d8a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":485,"version":1,"versionNonce":486,"isDeleted":false,"boundElements":null,"updated