extAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":552,"width":670},{"seed":125,"strokeStyle":"solid","id":"t-124","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"Scenario Q&A at the bottom","fontSize":12.5,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"Scenario Q&A at the bottom","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":12.5,"originalText":"Scenario Q&A at the bottom","height":24,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":126,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":700,"angle":0,"y":552,"width":980},{"seed":128,"strokeStyle":"solid","id":"t-127","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"Covered","fontSize":12.5,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"Covered","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":12.5,"originalText":"Covered","height":24,"link":null,"strokeColor":"#b4590c","fillStyle":"solid","groupIds":[],"versionNonce":129,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1700,"angle":0,"y":552,"width":620},{"isDeleted":false,"locked":false,"strokeColor":"#c7d2e8","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#ffffff","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-130","x":0,"seed":131,"boundElements":null,"y":584,"opacity":100,"height":44,"width":2340,"frameId":null,"strokeStyle":"solid","versionNonce":132},{"seed":134,"strokeStyle":"solid","id":"t-133","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"NOTE: voice session claimed it received your Domain 4 sidebar screenshot","fontSize":12.5,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"NOTE: subtopics not compared with the official course outline","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":12.5,"originalText":"NOTE: subtopics not compared with the official course outline","height":24,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":135,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":596,"width":670},{"seed":137,"strokeStyle":"solid","id":"t-136","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"NO screenshot reached me. The six subtopics above are the study guide's list, not yours.","fontSize":12.5,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"The six subtopics above are the study guide's list, not necessarily the course's.","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":12.5,"originalText":"The six subtopics above are the study guide's list, not necessarily the course's.","height":24,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":138,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":700,"angle":0,"y":596,"width":980},{"seed":140,"strokeStyle":"solid","id":"t-139","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"Send the real Domain 4 sidebar and I will diff it against this table","fontSize":12.5,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"Diff the official Domain 4 outline against this table before relying on it","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":12.5,"originalText":"Diff the official Domain 4 outline against this table before relying on it","height":24,"link":null,"strokeColor":"#b4590c","fillStyle":"solid","groupIds":[],"versionNonce":141,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1700,"angle":0,"y":596,"width":620},{"seed":143,"strokeStyle":"solid","id":"t-142","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"CORE CONCEPTS — FULL DEPTH","fontSize":26,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"CORE CONCEPTS — FULL DEPTH","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":26,"originalText":"CORE CONCEPTS — FULL DEPTH","height":36,"link":null,"strokeColor":"#0f3d8a","fillStyle":"solid","groupIds":[],"versionNonce":144,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":0,"angle":0,"y":658,"width":2400},{"isDeleted":false,"locked":false,"strokeColor":"#2457c5","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#f1f3f9","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-145","x":0,"seed":146,"boundElements":null,"y":706,"opacity":100,"height":424.36,"width":1150,"frameId":null,"strokeStyle":"solid","versionNonce":147},{"seed":149,"strokeStyle":"solid","id":"t-148","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"01 · 4.1 — EXPLICIT CRITERIA BEAT VAGUE INSTRUCTIONS","fontSize":18,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"01 · 4.1 — EXPLICIT CRITERIA BEAT VAGUE INSTRUCTIONS","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":18,"originalText":"01 · 4.1 — EXPLICIT CRITERIA BEAT VAGUE INSTRUCTIONS","height":24,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":150,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":718,"width":1118},{"seed":152,"strokeStyle":"solid","id":"t-151","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"CORE RULE: tell the model exactly what counts as a finding and what to skip. Categorical, checkable criteria outperform adjectives.\n\nVAGUE → SPECIFIC:\n• 'Check that comments are accurate' → flag a comment ONLY when its claimed behavior contradicts the actual code. Do NOT flag comments that are merely\nvague, outdated in style or under-detailed.\n• 'Find security issues' → report only: SQL string concatenation reaching a query call; eval/exec on attacker-controlled input; secrets in source; missing\nauth on /api/admin/*. Skip: defensive asserts, hardcoded test fixtures, anything in tests/, fixtures/, examples/.\n• 'Be conservative when escalating' → escalate when (a) the customer asks for a policy exception, (b) claim value exceeds $X, or (c) more than 2 prior\ncontacts exist. Resolve autonomously when photo evidence matches a standard damage SKU and value is under $X.\n• 'Only report high-confidence findings' → report only if you can quote the exact source line AND name the rule violated; if you cannot quote a line, do not\nreport.\n\n★ EVERY GOOD VERSION ANSWERS TWO QUESTIONS: what counts as a positive, and what non-issue must be skipped.\n\n★ WHY 'BE CONSERVATIVE' FAILS: 'carefully', 'conservative', 'high-confidence' give the model nothing it can mechanically check. 'Quote the line and name the\nrule' is checkable — the model can verify it before answering.\n\nTRUST EROSION: a high false-positive (FP) rate in ONE category makes developers distrust ALL categories.\n\nEXAM TELLS: 'too many false positives' → explicit categorical criteria + few-shot, NOT 'be conservative', NOT confidence thresholds, NOT a higher\ntemperature.","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"CORE RULE: tell the model exactly what counts as a finding and what to skip. Categorical, checkable criteria outperform adjectives.\n\nVAGUE → SPECIFIC:\n• 'Check that comments are accurate' → flag a comment ONLY when its claimed behavior contradicts the actual code. Do NOT flag comments that are merely\nvague, outdated in style or under-detailed.\n• 'Find security issues' → report only: SQL string concatenation reaching a query call; eval/exec on attacker-controlled input; secrets in source; missing\nauth on /api/admin/*. Skip: defensive asserts, hardcoded test fixtures, anything in tests/, fixtures/, examples/.\n• 'Be conservative when escalating' → escalate when (a) the customer asks for a policy exception, (b) claim value exceeds $X, or (c) more than 2 prior\ncontacts exist. Resolve autonomously when photo evidence matches a standard damage SKU and value is under $X.\n• 'Only report high-confidence findings' → report only if you can quote the exact source line AND name the rule violated; if you cannot quote a line, do not\nreport.\n\n★ EVERY GOOD VERSION ANSWERS TWO QUESTIONS: what counts as a positive, and what non-issue must be skipped.\n\n★ WHY 'BE CONSERVATIVE' FAILS: 'carefully', 'conservative', 'high-confidence' give the model nothing it can mechanically check. 'Quote the line and name the\nrule' is checkable — the model can verify it before answering.\n\nTRUST EROSION: a high false-positive (FP) rate in ONE category makes developers distrust ALL categories.\n\nEXAM TELLS: 'too many false positives' → explicit categorical criteria + few-shot, NOT 'be conservative', NOT confidence thresholds, NOT a higher\ntemperature.","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"CORE RULE: tell the model exactly what counts as a finding and what to skip. Categorical, checkable criteria outperform adjectives.\n\nVAGUE → SPECIFIC:\n• 'Check that comments are accurate' → flag a comment ONLY when its claimed behavior contradicts the actual code. Do NOT flag comments that are merely\nvague, outdated in style or under-detailed.\n• 'Find security issues' → report only: SQL string concatenation reaching a query call; eval/exec on attacker-controlled input; secrets in source; missing\nauth on /api/admin/*. Skip: defensive asserts, hardcoded test fixtures, anything in tests/, fixtures/, examples/.\n• 'Be conservative when escalating' → escalate when (a) the customer asks for a policy exception, (b) claim value exceeds $X, or (c) more than 2 prior\ncontacts exist. Resolve autonomously when photo evidence matches a standard damage SKU and value is under $X.\n• 'Only report high-confidence findings' → report only if you can quote the exact source line AND name the rule violated; if you cannot quote a line, do not\nreport.\n\n★ EVERY GOOD VERSION ANSWERS TWO QUESTIONS: what counts as a positive, and what non-issue must be skipped.\n\n★ WHY 'BE CONSERVATIVE' FAILS: 'carefully', 'conservative', 'high-confidence' give the model nothing it can mechanically check. 'Quote the line and name the\nrule' is checkable — the model can verify it before answering.\n\nTRUST EROSION: a high false-positive (FP) rate in ONE category makes developers distrust ALL categories.\n\nEXAM TELLS: 'too many false positives' → explicit categorical criteria + few-shot, NOT 'be conservative', NOT confidence thresholds, NOT a higher\ntemperature.","height":360.36,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":153,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":750,"width":1118},{"isDeleted":false,"locked":false,"strokeColor":"#2457c5","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#f1f3f9","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-154","x":1190,"seed":155,"boundElements":null,"y":706,"opacity":100,"height":372.88,"width":1150,"frameId":null,"strokeStyle":"solid","versionNonce":156},{"seed":158,"strokeStyle":"solid","id":"t-157","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"02 · 4.1 — SEVERITY DEFINITIONS & THE DISABLE-THEN-REBUILD MOVE","fontSize":18,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"02 · 4.1 — SEVERITY DEFINITIONS & THE DISABLE-THEN-REBUILD MOVE","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":18,"originalText":"02 · 4.1 — SEVERITY DEFINITIONS & THE DISABLE-THEN-REBUILD MOVE","height":24,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":159,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1206,"angle":0,"y":718,"width":1118},{"seed":161,"strokeStyle":"solid","id":"t-160","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"SEVERITY LEVELS MUST BE DEFINED IN THE PROMPT WITH A CONCRETE CODE EXAMPLE EACH (the guide uses XML tags: <severity_definitions> with <critical>, <high>,\n<medium>, <low>):\n• CRITICAL: data loss, auth bypass or RCE in production. Example: SQL query built by concatenating a request parameter.\n• HIGH: incorrect output for at least one realistic input. Example: off-by-one in pagination that drops the last page.\n• MEDIUM: resource leak or correctness issue only under load. Example: file handle opened in a loop without with/defer close.\n• LOW: style/readability only. Do NOT include unless explicitly asked.\n\nWithout definitions, 'high' means different things on different runs — inconsistent severity, inconsistent routing.\n\n★ DISABLE-THEN-REBUILD: a category running at ~40% FP should be REMOVED from the live prompt rather than left to poison trust in the good categories (e.g.,\nsecurity). Iterate on it in a side prompt until precision clears your threshold, then re-enable.\n\nSKILLS THE EXAM TESTS: (1) write report-when / skip-when rules per category, (2) temporarily disable high-FP categories, (3) define severity with concrete\ncode examples.\n\nEXAMPLE: A style-nitpick category is 60% dismissed by developers. Turn it off, keep security/logic findings on, and rebuild the nitpick rules offline.\n\nEXAM TELLS: 'one noisy category is making developers ignore everything' → disable that category while improving it.","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"SEVERITY LEVELS MUST BE DEFINED IN THE PROMPT WITH A CONCRETE CODE EXAMPLE EACH (the guide uses XML tags: <severity_definitions> with <critical>, <high>,\n<medium>, <low>):\n• CRITICAL: data loss, auth bypass or RCE in production. Example: SQL query built by concatenating a request parameter.\n• HIGH: incorrect output for at least one realistic input. Example: off-by-one in pagination that drops the last page.\n• MEDIUM: resource leak or correctness issue only under load. Example: file handle opened in a loop without with/defer close.\n• LOW: style/readability only. Do NOT include unless explicitly asked.\n\nWithout definitions, 'high' means different things on different runs — inconsistent severity, inconsistent routing.\n\n★ DISABLE-THEN-REBUILD: a category running at ~40% FP should be REMOVED from the live prompt rather than left to poison trust in the good categories (e.g.,\nsecurity). Iterate on it in a side prompt until precision clears your threshold, then re-enable.\n\nSKILLS THE EXAM TESTS: (1) write report-when / skip-when rules per category, (2) temporarily disable high-FP categories, (3) define severity with concrete\ncode examples.\n\nEXAMPLE: A style-nitpick category is 60% dismissed by developers. Turn it off, keep security/logic findings on, and rebuild the nitpick rules offline.\n\nEXAM TELLS: 'one noisy category is making developers ignore everything' → disable that category while improving it.","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"SEVERITY LEVELS MUST BE DEFINED IN THE PROMPT WITH A CONCRETE CODE EXAMPLE EACH (the guide uses XML tags: <severity_definitions> with <critical>, <high>,\n<medium>, <low>):\n• CRITICAL: data loss, auth bypass or RCE in production. Example: SQL query built by concatenating a request parameter.\n• HIGH: incorrect output for at least one realistic input. Example: off-by-one in pagination that drops the last page.\n• MEDIUM: resource leak or correctness issue only under load. Example: file handle opened in a loop without with/defer close.\n• LOW: style/readability only. Do NOT include unless explicitly asked.\n\nWithout definitions, 'high' means different things on different runs — inconsistent severity, inconsistent routing.\n\n★ DISABLE-THEN-REBUILD: a category running at ~40% FP should be REMOVED from the live prompt rather than left to poison trust in the good categories (e.g.,\nsecurity). Iterate on it in a side prompt until precision clears your threshold, then re-enable.\n\nSKILLS THE EXAM TESTS: (1) write report-when / skip-when rules per category, (2) temporarily disable high-FP categories, (3) define severity with concrete\ncode examples.\n\nEXAMPLE: A style-nitpick category is 60% dismissed by developers. Turn it off, keep security/logic findings on, and rebuild the nitpick rules offline.\n\nEXAM TELLS: 'one noisy category is making developers ignore everything' → disable that category while improving it.","height":308.88,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":162,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1206,"angle":0,"y":750,"width":1118},{"isDeleted":false,"locked":false,"strokeColor":"#2457c5","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#f1f3f9","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-163","x":0,"seed":164,"boundElements":null,"y":1158.3600000000001,"opacity":100,"height":390.04,"width":1150,"frameId":null,"strokeStyle":"solid","versionNonce":165},{"seed":167,"strokeStyle":"solid","id":"t-166","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"03 · 4.2 — FEW-SHOT PROMPTING: WHY, HOW MANY, ANATOMY, PLACEMENT","fontSize":18,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"03 · 4.2 — FEW-SHOT PROMPTING: WHY, HOW MANY, ANATOMY, PLACEMENT","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":18,"originalText":"03 · 4.2 — FEW-SHOT PROMPTING: WHY, HOW MANY, ANATOMY, PLACEMENT","height":24,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":168,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":1170.3600000000001,"width":1118},{"seed":170,"strokeStyle":"solid","id":"t-169","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"WHY: few-shot examples are the MOST EFFECTIVE technique for consistent, formatted, actionable output when instructions alone are inconsistent. They drive\nambiguous-case handling (tool selection, escalation), generalization to novel patterns, and fewer hallucinations in extraction across varied document\nlayouts.\n\n★ HOW MANY: 2–4. Fewer than 2 does not establish a pattern. More than ~4 wastes tokens and risks OVERFITTING to surface features. (Not 10. Not 1.)\n\nANATOMY OF ONE EXAMPLE (three fields):\n1) INPUT — a snippet that mirrors real production input.\n2) REASONING — WHY the chosen action beats the plausible alternatives (e.g., 'delivery complaint within policy, no exception requested → refund + reship').\n3) OUTPUT — the exact shape (XML or JSON) expected at inference time.\n\nPLACEMENT: wrap in XML tags (<examples>, <example>, <input>, <output>). Put them AFTER the task instructions and criteria and BEFORE the live input.\n\nWITH EXTENDED THINKING: multishot still helps, but examples should show REASONING PATTERNS, not just input → output pairs.\n\nRUNNING-NOTES TIE-IN: format inconsistency (citations inline vs footnote) is fixed by DEMONSTRATING the format with a few-shot example — not by temperature 0,\nnot by regex cleanup afterwards, not by bold text.\n\nEXAM TELLS: 'inconsistent format / ambiguous escalation or tool choice' → 2–4 targeted few-shot examples WITH reasoning.","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"WHY: few-shot examples are the MOST EFFECTIVE technique for consistent, formatted, actionable output when instructions alone are inconsistent. They drive\nambiguous-case handling (tool selection, escalation), generalization to novel patterns, and fewer hallucinations in extraction across varied document\nlayouts.\n\n★ HOW MANY: 2–4. Fewer than 2 does not establish a pattern. More than ~4 wastes tokens and risks OVERFITTING to surface features. (Not 10. Not 1.)\n\nANATOMY OF ONE EXAMPLE (three fields):\n1) INPUT — a snippet that mirrors real production input.\n2) REASONING — WHY the chosen action beats the plausible alternatives (e.g., 'delivery complaint within policy, no exception requested → refund + reship').\n3) OUTPUT — the exact shape (XML or JSON) expected at inference time.\n\nPLACEMENT: wrap in XML tags (<examples>, <example>, <input>, <output>). Put them AFTER the task instructions and criteria and BEFORE the live input.\n\nWITH EXTENDED THINKING: multishot still helps, but examples should show REASONING PATTERNS, not just input → output pairs.\n\nRUNNING-NOTES TIE-IN: format inconsistency (citations inline vs footnote) is fixed by DEMONSTRATING the format with a few-shot example — not by temperature 0,\nnot by regex cleanup afterwards, not by bold text.\n\nEXAM TELLS: 'inconsistent format / ambiguous escalation or tool choice' → 2–4 targeted few-shot examples WITH reasoning.","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"WHY: few-shot examples are the MOST EFFECTIVE technique for consistent, formatted, actionable output when instructions alone are inconsistent. They drive\nambiguous-case handling (tool selection, escalation), generalization to novel patterns, and fewer hallucinations in extraction across varied document\nlayouts.\n\n★ HOW MANY: 2–4. Fewer than 2 does not establish a pattern. More than ~4 wastes tokens and risks OVERFITTING to surface features. (Not 10. Not 1.)\n\nANATOMY OF ONE EXAMPLE (three fields):\n1) INPUT — a snippet that mirrors real production input.\n2) REASONING — WHY the chosen action beats the plausible alternatives (e.g., 'delivery complaint within policy, no exception requested → refund + reship').\n3) OUTPUT — the exact shape (XML or JSON) expected at inference time.\n\nPLACEMENT: wrap in XML tags (<examples>, <example>, <input>, <output>). Put them AFTER the task instructions and criteria and BEFORE the live input.\n\nWITH EXTENDED THINKING: multishot still helps, but examples should show REASONING PATTERNS, not just input → output pairs.\n\nRUNNING-NOTES TIE-IN: format inconsistency (citations inline vs footnote) is fixed by DEMONSTRATING the format with a few-shot example — not by temperature 0,\nnot by regex cleanup afterwards, not by bold text.\n\nEXAM TELLS: 'inconsistent format / ambiguous escalation or tool choice' → 2–4 targeted few-shot examples WITH reasoning.","height":326.04,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":171,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":1202.3600000000001,"width":1118},{"isDeleted":false,"locked":false,"strokeColor":"#2457c5","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#f1f3f9","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-172","x":1190,"seed":173,"boundElements":null,"y":1158.3600000000001,"opacity":100,"height":390.04,"width":1150,"frameId":null,"strokeStyle":"solid","versionNonce":174},{"seed":176,"strokeStyle":"solid","id":"t-175","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"04 · 4.2 — FOUR USAGE PATTERNS FOR FEW-SHOT (WHICH EXAMPLES TO PICK)","fontSize":18,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"04 · 4.2 — FOUR USAGE PATTERNS FOR FEW-SHOT (WHICH EXAMPLES TO PICK)","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":18,"originalText":"04 · 4.2 — FOUR USAGE PATTERNS FOR FEW-SHOT (WHICH EXAMPLES TO PICK)","height":24,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":177,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1206,"angle":0,"y":1170.3600000000001,"width":1118},{"seed":179,"strokeStyle":"solid","id":"t-178","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"1) AMBIGUOUS CASES: pick 2–4 examples from your eval set where the model previously misbehaved. Include a CONTRAST PAIR — a similar-looking example that\nmust be handled the OPPOSITE way. Contrast pairs teach generalization, not memorization.\n\n2) FORMAT CONSISTENCY: show findings in the exact target shape, e.g. {location, issue, severity, suggested_fix}. Instructions alone leak inconsistent\ncapitalization, missing fields and trailing prose.\n\n3) FALSE-POSITIVE REDUCTION: pair each issue example with an ACCEPTABLE-PATTERN example that shares surface features. For a SQL-injection reviewer: one\nvulnerable concatenation AND one parameterized call labeled not_a_finding.\n\n4) VARIED DOCUMENT STRUCTURES: give ONE example per structural variant — messy invoice line items, inline vs bibliography citations, methodology buried in\nnarrative. Without coverage, extraction returns null on unseen layouts.\n\nHOW TO TELL WHICH PATTERN: 'model misjudges borderline cases' → ambiguous-case + contrast pair. 'output shape drifts' → format example. 'flags harmless\ncode' → acceptable-pattern example. 'works on some documents, null on others' → one example per structure.\n\nEXAMPLE: An invoice extractor returns null for invoices where totals sit in a footer table. Add one example with a footer-table invoice — not a longer\ninstruction.\n\nEXAM TELLS: 'handle a new document layout' → add an example of that layout. 'flags safe code' → add a labeled not_a_finding example.","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"1) AMBIGUOUS CASES: pick 2–4 examples from your eval set where the model previously misbehaved. Include a CONTRAST PAIR — a similar-looking example that\nmust be handled the OPPOSITE way. Contrast pairs teach generalization, not memorization.\n\n2) FORMAT CONSISTENCY: show findings in the exact target shape, e.g. {location, issue, severity, suggested_fix}. Instructions alone leak inconsistent\ncapitalization, missing fields and trailing prose.\n\n3) FALSE-POSITIVE REDUCTION: pair each issue example with an ACCEPTABLE-PATTERN example that shares surface features. For a SQL-injection reviewer: one\nvulnerable concatenation AND one parameterized call labeled not_a_finding.\n\n4) VARIED DOCUMENT STRUCTURES: give ONE example per structural variant — messy invoice line items, inline vs bibliography citations, methodology buried in\nnarrative. Without coverage, extraction returns null on unseen layouts.\n\nHOW TO TELL WHICH PATTERN: 'model misjudges borderline cases' → ambiguous-case + contrast pair. 'output shape drifts' → format example. 'flags harmless\ncode' → acceptable-pattern example. 'works on some documents, null on others' → one example per structure.\n\nEXAMPLE: An invoice extractor returns null for invoices where totals sit in a footer table. Add one example with a footer-table invoice — not a longer\ninstruction.\n\nEXAM TELLS: 'handle a new document layout' → add an example of that layout. 'flags safe code' → add a labeled not_a_finding example.","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"1) AMBIGUOUS CASES: pick 2–4 examples from your eval set where the model previously misbehaved. Include a CONTRAST PAIR — a similar-looking example that\nmust be handled the OPPOSITE way. Contrast pairs teach generalization, not memorization.\n\n2) FORMAT CONSISTENCY: show findings in the exact target shape, e.g. {location, issue, severity, suggested_fix}. Instructions alone leak inconsistent\ncapitalization, missing fields and trailing prose.\n\n3) FALSE-POSITIVE REDUCTION: pair each issue example with an ACCEPTABLE-PATTERN example that shares surface features. For a SQL-injection reviewer: one\nvulnerable concatenation AND one parameterized call labeled not_a_finding.\n\n4) VARIED DOCUMENT STRUCTURES: give ONE example per structural variant — messy invoice line items, inline vs bibliography citations, methodology buried in\nnarrative. Without coverage, extraction returns null on unseen layouts.\n\nHOW TO TELL WHICH PATTERN: 'model misjudges borderline cases' → ambiguous-case + contrast pair. 'output shape drifts' → format example. 'flags harmless\ncode' → acceptable-pattern example. 'works on some documents, null on others' → one example per structure.\n\nEXAMPLE: An invoice extractor returns null for invoices where totals sit in a footer table. Add one example with a footer-table invoice — not a longer\ninstruction.\n\nEXAM TELLS: 'handle a new document layout' → add an example of that layout. 'flags safe code' → add a labeled not_a_finding example.","height":326.04,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":180,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1206,"angle":0,"y":1202.3600000000001,"width":1118},{"isDeleted":false,"locked":false,"strokeColor":"#2457c5","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#f1f3f9","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-181","x":0,"seed":182,"boundElements":null,"y":1576.4,"opacity":100,"height":441.52000000000004,"width":1150,"frameId":null,"strokeStyle":"solid","versionNonce":183},{"seed":185,"strokeStyle":"solid","id":"t-184","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"05 · 4.3 — WHY STRUCTURED OUTPUT: tool_use + JSON SCHEMA, strict, output_config.format","fontSize":18,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"05 · 4.3 — WHY STRUCTURED OUTPUT: tool_use + JSON SCHEMA, strict, output_config.format","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":18,"originalText":"05 · 4.3 — WHY STRUCTURED OUTPUT: tool_use + JSON SCHEMA, strict, output_config.format","height":24,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":186,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":1588.4,"width":1118},{"seed":188,"strokeStyle":"solid","id":"t-187","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"PROBLEM: asking for 'JSON only' in the prompt fails occasionally — prose preambles, markdown fences, trailing commas. Bare 'respond with JSON' answers are\nDISTRACTORS.\n\nFIX #1 — tool_use WITH A JSON SCHEMA: define a tool whose input_schema is the shape you want and force the model to call it. The tool-call arguments are\nyour structured output. This removes most SYNTAX failures.\n\nFIX #2 — strict mode: add \"strict\": true on the tool. Sampling is constrained so output matches the schema's types, enums and required fields. (Guide lists\nsupport on Opus 4.7/4.6/4.5, Sonnet 4.6/4.5, Haiku 4.5 — verify current list.)\n\nFIX #3 — Structured Outputs: output_config.format with \"type\": \"json_schema\" gives the same guarantee WITHOUT a fake tool. Same JSON Schema subset, same\nlimits.\n\n★ THE LIMIT (most tested): strict schemas guarantee PARSEABILITY, not CORRECTNESS. Schema-valid output can still have wrong totals, misplaced values,\nplausible-but-wrong content. 'Schemas don't do arithmetic.'\n\nWHAT CATCHES SEMANTIC ERRORS: application validation, retry-with-error-feedback (4.4), or an independent reviewer (4.6).\n\nEXAMPLE: invoice extraction with a strict schema never returns malformed JSON, yet line items sum to 940 while the stated total is 1040. The schema can't\nsee that.\n\nEXAM TELLS: 'occasional parse errors / prose around the JSON' → tool_use + schema (strict). 'schema added but values still wrong' → validation-retry, not\nanother schema.","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"PROBLEM: asking for 'JSON only' in the prompt fails occasionally — prose preambles, markdown fences, trailing commas. Bare 'respond with JSON' answers are\nDISTRACTORS.\n\nFIX #1 — tool_use WITH A JSON SCHEMA: define a tool whose input_schema is the shape you want and force the model to call it. The tool-call arguments are\nyour structured output. This removes most SYNTAX failures.\n\nFIX #2 — strict mode: add \"strict\": true on the tool. Sampling is constrained so output matches the schema's types, enums and required fields. (Guide lists\nsupport on Opus 4.7/4.6/4.5, Sonnet 4.6/4.5, Haiku 4.5 — verify current list.)\n\nFIX #3 — Structured Outputs: output_config.format with \"type\": \"json_schema\" gives the same guarantee WITHOUT a fake tool. Same JSON Schema subset, same\nlimits.\n\n★ THE LIMIT (most tested): strict schemas guarantee PARSEABILITY, not CORRECTNESS. Schema-valid output can still have wrong totals, misplaced values,\nplausible-but-wrong content. 'Schemas don't do arithmetic.'\n\nWHAT CATCHES SEMANTIC ERRORS: application validation, retry-with-error-feedback (4.4), or an independent reviewer (4.6).\n\nEXAMPLE: invoice extraction with a strict schema never returns malformed JSON, yet line items sum to 940 while the stated total is 1040. The schema can't\nsee that.\n\nEXAM TELLS: 'occasional parse errors / prose around the JSON' → tool_use + schema (strict). 'schema added but values still wrong' → validation-retry, not\nanother schema.","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"PROBLEM: asking for 'JSON only' in the prompt fails occasionally — prose preambles, markdown fences, trailing commas. Bare 'respond with JSON' answers are\nDISTRACTORS.\n\nFIX #1 — tool_use WITH A JSON SCHEMA: define a tool whose input_schema is the shape you want and force the model to call it. The tool-call arguments are\nyour structured output. This removes most SYNTAX failures.\n\nFIX #2 — strict mode: add \"strict\": true on the tool. Sampling is constrained so output matches the schema's types, enums and required fields. (Guide lists\nsupport on Opus 4.7/4.6/4.5, Sonnet 4.6/4.5, Haiku 4.5 — verify current list.)\n\nFIX #3 — Structured Outputs: output_config.format with \"type\": \"json_schema\" gives the same guarantee WITHOUT a fake tool. Same JSON Schema subset, same\nlimits.\n\n★ THE LIMIT (most tested): strict schemas guarantee PARSEABILITY, not CORRECTNESS. Schema-valid output can still have wrong totals, misplaced values,\nplausible-but-wrong content. 'Schemas don't do arithmetic.'\n\nWHAT CATCHES SEMANTIC ERRORS: application validation, retry-with-error-feedback (4.4), or an independent reviewer (4.6).\n\nEXAMPLE: invoice extraction with a strict schema never returns malformed JSON, yet line items sum to 940 while the stated total is 1040. The schema can't\nsee that.\n\nEXAM TELLS: 'occasional parse errors / prose around the JSON' → tool_use + schema (strict). 'schema added but values still wrong' → validation-retry, not\nanother schema.","height":377.52000000000004,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":189,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":1620.4,"width":1118},{"isDeleted":false,"locked":false,"strokeColor":"#2457c5","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#f1f3f9","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-190","x":1190,"seed":191,"boundElements":null,"y":1576.4,"opacity":100,"height":355.72,"width":1150,"frameId":null,"strokeStyle":"solid","versionNonce":192},{"seed":194,"strokeStyle":"solid","id":"t-193","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"06 · 4.3 — tool_choice MODES & PARALLEL CALLS","fontSize":18,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"06 · 4.3 — tool_choice MODES & PARALLEL CALLS","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":18,"originalText":"06 · 4.3 — tool_choice MODES & PARALLEL CALLS","height":24,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":195,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1206,"angle":0,"y":1588.4,"width":1118},{"seed":197,"strokeStyle":"solid","id":"t-196","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"• auto — the model MAY reply with text or call any tool. Use only when a text answer is valid.\n• any — the model MUST call a tool but chooses WHICH. Use when the document type is UNKNOWN and you have several extraction tools.\n• forced {\"type\":\"tool\",\"name\":\"extract_invoice\"} — the model MUST call that specific tool. Use for a required step and stable response shape (also what the\nretry loop uses).\n• none — no tool calls this turn.\n\ndisable_parallel_tool_use: true → at most ONE tool call per turn.\n\nNOTE (from Domain 2): forced tool choice is incompatible with extended thinking — check this before combining them.\n\nHOW TO PICK: Is a tool call required? No → auto. Yes: do you know which tool? Yes → forced. No → any.\n\nEXAMPLE: A pipeline ingests invoices, receipts and contracts, each with its own tool. Document type is unknown → tool_choice any. Once classified as\ninvoice, the second step uses a forced extract_invoice.\n\nEXAM TELLS: 'unknown document type, must still return structured data' → any. 'required extraction step' → forced. 'model sometimes answers in prose instead\nof calling the tool' → any or forced, NOT auto.","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"• auto — the model MAY reply with text or call any tool. Use only when a text answer is valid.\n• any — the model MUST call a tool but chooses WHICH. Use when the document type is UNKNOWN and you have several extraction tools.\n• forced {\"type\":\"tool\",\"name\":\"extract_invoice\"} — the model MUST call that specific tool. Use for a required step and stable response shape (also what the\nretry loop uses).\n• none — no tool calls this turn.\n\ndisable_parallel_tool_use: true → at most ONE tool call per turn.\n\nNOTE (from Domain 2): forced tool choice is incompatible with extended thinking — check this before combining them.\n\nHOW TO PICK: Is a tool call required? No → auto. Yes: do you know which tool? Yes → forced. No → any.\n\nEXAMPLE: A pipeline ingests invoices, receipts and contracts, each with its own tool. Document type is unknown → tool_choice any. Once classified as\ninvoice, the second step uses a forced extract_invoice.\n\nEXAM TELLS: 'unknown document type, must still return structured data' → any. 'required extraction step' → forced. 'model sometimes answers in prose instead\nof calling the tool' → any or forced, NOT auto.","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"• auto — the model MAY reply with text or call any tool. Use only when a text answer is valid.\n• any — the model MUST call a tool but chooses WHICH. Use when the document type is UNKNOWN and you have several extraction tools.\n• forced {\"type\":\"tool\",\"name\":\"extract_invoice\"} — the model MUST call that specific tool. Use for a required step and stable response shape (also what the\nretry loop uses).\n• none — no tool calls this turn.\n\ndisable_parallel_tool_use: true → at most ONE tool call per turn.\n\nNOTE (from Domain 2): forced tool choice is incompatible with extended thinking — check this before combining them.\n\nHOW TO PICK: Is a tool call required? No → auto. Yes: do you know which tool? Yes → forced. No → any.\n\nEXAMPLE: A pipeline ingests invoices, receipts and contracts, each with its own tool. Document type is unknown → tool_choice any. Once classified as\ninvoice, the second step uses a forced extract_invoice.\n\nEXAM TELLS: 'unknown document type, must still return structured data' → any. 'required extraction step' → forced. 'model sometimes answers in prose instead\nof calling the tool' → any or forced, NOT auto.","height":291.72,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":198,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1206,"angle":0,"y":1620.4,"width":1118},{"isDeleted":false,"locked":false,"strokeColor":"#2457c5","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#f1f3f9","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-199","x":0,"seed":200,"boundElements":null,"y":2045.92,"opacity":100,"height":372.88,"width":1150,"frameId":null,"strokeStyle":"solid","versionNonce":201},{"seed":203,"strokeStyle":"solid","id":"t-202","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"07 · 4.3 — SCHEMA DESIGN: NULLABLE, 'other', 'unclear', SELF-VALIDATING FIELDS","fontSize":18,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"07 · 4.3 — SCHEMA DESIGN: NULLABLE, 'other', 'unclear', SELF-VALIDATING FIELDS","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":18,"originalText":"07 · 4.3 — SCHEMA DESIGN: NULLABLE, 'other', 'unclear', SELF-VALIDATING FIELDS","height":24,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":204,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":2057.92,"width":1118},{"seed":206,"strokeStyle":"solid","id":"t-205","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"1) REQUIRED FIELDS CAUSE FABRICATION. If a field is required but the source doesn't contain it, the model invents a value. Use NULLABLE types for optional\ndata: [\"string\",\"null\"].\n\n2) CLOSED ENUMS ARE BRITTLE. A fixed category list forces wrong picks for new cases. Add \"other\" plus a detail string field so novel cases are captured, not\nmis-bucketed.\n\n3) 'unclear' VALUE. Let the model flag low confidence (e.g., category: unclear) so a human reviews it, instead of guessing.\n\n4) SELF-VALIDATING FIELDS. Ask for stated_total AND calculated_total. A validator compares them in post-processing; computing the total forces the model to\nlook at every line item.\n\nEXAMPLE SCHEMA SNIPPET: tax_id: [\"string\",\"null\"] · category: enum[\"invoice\",\"receipt\",\"other\"] + category_detail: string · stated_total: number ·\ncalculated_total: number.\n\nWHY IT MATTERS: the model's instinct is to complete the schema. Make 'I don't know' a legal answer, or it will invent one.\n\nEXAM TELLS: 'model invents values for missing data' → make the field nullable. 'new category gets forced into the wrong bucket' → add other + detail.\n'totals disagree' → add calculated vs stated.","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"1) REQUIRED FIELDS CAUSE FABRICATION. If a field is required but the source doesn't contain it, the model invents a value. Use NULLABLE types for optional\ndata: [\"string\",\"null\"].\n\n2) CLOSED ENUMS ARE BRITTLE. A fixed category list forces wrong picks for new cases. Add \"other\" plus a detail string field so novel cases are captured, not\nmis-bucketed.\n\n3) 'unclear' VALUE. Let the model flag low confidence (e.g., category: unclear) so a human reviews it, instead of guessing.\n\n4) SELF-VALIDATING FIELDS. Ask for stated_total AND calculated_total. A validator compares them in post-processing; computing the total forces the model to\nlook at every line item.\n\nEXAMPLE SCHEMA SNIPPET: tax_id: [\"string\",\"null\"] · category: enum[\"invoice\",\"receipt\",\"other\"] + category_detail: string · stated_total: number ·\ncalculated_total: number.\n\nWHY IT MATTERS: the model's instinct is to complete the schema. Make 'I don't know' a legal answer, or it will invent one.\n\nEXAM TELLS: 'model invents values for missing data' → make the field nullable. 'new category gets forced into the wrong bucket' → add other + detail.\n'totals disagree' → add calculated vs stated.","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"1) REQUIRED FIELDS CAUSE FABRICATION. If a field is required but the source doesn't contain it, the model invents a value. Use NULLABLE types for optional\ndata: [\"string\",\"null\"].\n\n2) CLOSED ENUMS ARE BRITTLE. A fixed category list forces wrong picks for new cases. Add \"other\" plus a detail string field so novel cases are captured, not\nmis-bucketed.\n\n3) 'unclear' VALUE. Let the model flag low confidence (e.g., category: unclear) so a human reviews it, instead of guessing.\n\n4) SELF-VALIDATING FIELDS. Ask for stated_total AND calculated_total. A validator compares them in post-processing; computing the total forces the model to\nlook at every line item.\n\nEXAMPLE SCHEMA SNIPPET: tax_id: [\"string\",\"null\"] · category: enum[\"invoice\",\"receipt\",\"other\"] + category_detail: string · stated_total: number ·\ncalculated_total: number.\n\nWHY IT MATTERS: the model's instinct is to complete the schema. Make 'I don't know' a legal answer, or it will invent one.\n\nEXAM TELLS: 'model invents values for missing data' → make the field nullable. 'new category gets forced into the wrong bucket' → add other + detail.\n'totals disagree' → add calculated vs stated.","height":308.88,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":207,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":2089.92,"width":1118},{"isDeleted":false,"locked":false,"strokeColor":"#2457c5","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#f1f3f9","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-208","x":1190,"seed":209,"boundElements":null,"y":2045.92,"opacity":100,"height":338.56,"width":1150,"frameId":null,"strokeStyle":"solid","versionNonce":210},{"seed":212,"strokeStyle":"solid","id":"t-211","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"08 · 4.3 — WHAT THE JSON SCHEMA SUBSET SUPPORTS (AND WHAT IT DOESN'T)","fontSize":18,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"08 · 4.3 — WHAT THE JSON SCHEMA SUBSET SUPPORTS (AND WHAT IT DOESN'T)","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":18,"originalText":"08 · 4.3 — WHAT THE JSON SCHEMA SUBSET SUPPORTS (AND WHAT IT DOESN'T)","height":24,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":213,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1206,"angle":0,"y":2057.92,"width":1118},{"seed":215,"strokeStyle":"solid","id":"t-214","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"SUPPORTED (per the guide): basic types · primitive enum · const · limited anyOf/allOf · internal $ref/$defs · default · required · additionalProperties:\nfalse · common string formats · minItems of 0 or 1 · regex quantifiers, character classes, groups.\n\nNOT SUPPORTED: external $ref · recursive schemas · complex enum types · numeric constraints (minimum, maximum, multipleOf) · string-length constraints ·\nadditionalProperties other than false · regex backreferences, lookarounds, word boundaries.\n\n★ CONSEQUENCE: you can't enforce 'quantity between 1 and 100' or 'name under 50 chars' with the schema. Those are SEMANTIC rules — enforce them in\napplication validation and retry (4.4).\n\nBoth tool_use strict mode and output_config.format share this same subset and the same semantic-error limit.\n\nEXAMPLE: you want total >= 0. The schema can't say it → validate in code, and if it fails send the specific error back to the model.\n\nVERIFY: this subset list is from the unofficial guide and may change with API versions — check the current docs before the exam if your course covers it.\n\nEXAM TELLS: 'enforce a numeric range in the schema' → not supported; use validation + retry.","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"SUPPORTED (per the guide): basic types · primitive enum · const · limited anyOf/allOf · internal $ref/$defs · default · required · additionalProperties:\nfalse · common string formats · minItems of 0 or 1 · regex quantifiers, character classes, groups.\n\nNOT SUPPORTED: external $ref · recursive schemas · complex enum types · numeric constraints (minimum, maximum, multipleOf) · string-length constraints ·\nadditionalProperties other than false · regex backreferences, lookarounds, word boundaries.\n\n★ CONSEQUENCE: you can't enforce 'quantity between 1 and 100' or 'name under 50 chars' with the schema. Those are SEMANTIC rules — enforce them in\napplication validation and retry (4.4).\n\nBoth tool_use strict mode and output_config.format share this same subset and the same semantic-error limit.\n\nEXAMPLE: you want total >= 0. The schema can't say it → validate in code, and if it fails send the specific error back to the model.\n\nVERIFY: this subset list is from the unofficial guide and may change with API versions — check the current docs before the exam if your course covers it.\n\nEXAM TELLS: 'enforce a numeric range in the schema' → not supported; use validation + retry.","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"SUPPORTED (per the guide): basic types · primitive enum · const · limited anyOf/allOf · internal $ref/$defs · default · required · additionalProperties:\nfalse · common string formats · minItems of 0 or 1 · regex quantifiers, character classes, groups.\n\nNOT SUPPORTED: external $ref · recursive schemas · complex enum types · numeric constraints (minimum, maximum, multipleOf) · string-length constraints ·\nadditionalProperties other than false · regex backreferences, lookarounds, word boundaries.\n\n★ CONSEQUENCE: you can't enforce 'quantity between 1 and 100' or 'name under 50 chars' with the schema. Those are SEMANTIC rules — enforce them in\napplication validation and retry (4.4).\n\nBoth tool_use strict mode and output_config.format share this same subset and the same semantic-error limit.\n\nEXAMPLE: you want total >= 0. The schema can't say it → validate in code, and if it fails send the specific error back to the model.\n\nVERIFY: this subset list is from the unofficial guide and may change with API versions — check the current docs before the exam if your course covers it.\n\nEXAM TELLS: 'enforce a numeric range in the schema' → not supported; use validation + retry.","height":274.56,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":216,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1206,"angle":0,"y":2089.92,"width":1118},{"isDeleted":false,"locked":false,"strokeColor":"#2457c5","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#f1f3f9","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-217","x":0,"seed":218,"boundElements":null,"y":2446.8,"opacity":100,"height":321.40000000000003,"width":1150,"frameId":null,"strokeStyle":"solid","versionNonce":219},{"seed":221,"strokeStyle":"solid","id":"t-220","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"09 · 4.4 — RETRY-WITH-ERROR-FEEDBACK (THE VALIDATION LOOP)","fontSize":18,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"09 · 4.4 — RETRY-WITH-ERROR-FEEDBACK (THE VALIDATION LOOP)","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":18,"originalText":"09 · 4.4 — RETRY-WITH-ERROR-FEEDBACK (THE VALIDATION LOOP)","height":24,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":222,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":2458.8,"width":1118},{"seed":224,"strokeStyle":"solid","id":"t-223","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"LOOP: (1) call the model with a forced tool; (2) validate the output PROGRAMMATICALLY; (3) on failure, send a NEW turn containing the ORIGINAL input, the\nFAILED output, and the SPECIFIC validation error; (4) repeat up to max_attempts; (5) if attempts run out, raise/escalate.\n\n★ THREE PROPERTIES: (a) append the assistant turn VERBATIM (same rule as the agentic loop in Domain 1); (b) the follow-up names the specific failed fields;\n(c) retries use a FORCED tool call so response shape stays stable.\n\n★ GENERIC 'TRY AGAIN' NEVER HELPS. The model needs to know what was wrong: 'line_items sum to 940 but stated_total is 1040' beats 'that was wrong'.\n\nGUIDE'S CODE SHAPE: max_attempts parameter · forced extract_invoice tool · validate() function · is_recoverable() check that raises immediately on\nunrecoverable errors · final raise if attempts run out.\n\nEXAMPLE: attempt 1 returns tax_id in the wrong field. Validator: 'tax_id looks like a date; expected 9 digits'. Retry sends original document + the bad\noutput + that exact error. Attempt 2 fixes it.\n\nEXAM TELLS: 'extraction has format/structure errors' → retry with the specific error attached. 'just resend the same prompt' → wrong.","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"LOOP: (1) call the model with a forced tool; (2) validate the output PROGRAMMATICALLY; (3) on failure, send a NEW turn containing the ORIGINAL input, the\nFAILED output, and the SPECIFIC validation error; (4) repeat up to max_attempts; (5) if attempts run out, raise/escalate.\n\n★ THREE PROPERTIES: (a) append the assistant turn VERBATIM (same rule as the agentic loop in Domain 1); (b) the follow-up names the specific failed fields;\n(c) retries use a FORCED tool call so response shape stays stable.\n\n★ GENERIC 'TRY AGAIN' NEVER HELPS. The model needs to know what was wrong: 'line_items sum to 940 but stated_total is 1040' beats 'that was wrong'.\n\nGUIDE'S CODE SHAPE: max_attempts parameter · forced extract_invoice tool · validate() function · is_recoverable() check that raises immediately on\nunrecoverable errors · final raise if attempts run out.\n\nEXAMPLE: attempt 1 returns tax_id in the wrong field. Validator: 'tax_id looks like a date; expected 9 digits'. Retry sends original document + the bad\noutput + that exact error. Attempt 2 fixes it.\n\nEXAM TELLS: 'extraction has format/structure errors' → retry with the specific error attached. 'just resend the same prompt' → wrong.","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"LOOP: (1) call the model with a forced tool; (2) validate the output PROGRAMMATICALLY; (3) on failure, send a NEW turn containing the ORIGINAL input, the\nFAILED output, and the SPECIFIC validation error; (4) repeat up to max_attempts; (5) if attempts run out, raise/escalate.\n\n★ THREE PROPERTIES: (a) append the assistant turn VERBATIM (same rule as the agentic loop in Domain 1); (b) the follow-up names the specific failed fields;\n(c) retries use a FORCED tool call so response shape stays stable.\n\n★ GENERIC 'TRY AGAIN' NEVER HELPS. The model needs to know what was wrong: 'line_items sum to 940 but stated_total is 1040' beats 'that was wrong'.\n\nGUIDE'S CODE SHAPE: max_attempts parameter · forced extract_invoice tool · validate() function · is_recoverable() check that raises immediately on\nunrecoverable errors · final raise if attempts run out.\n\nEXAMPLE: attempt 1 returns tax_id in the wrong field. Validator: 'tax_id looks like a date; expected 9 digits'. Retry sends original document + the bad\noutput + that exact error. Attempt 2 fixes it.\n\nEXAM TELLS: 'extraction has format/structure errors' → retry with the specific error attached. 'just resend the same prompt' → wrong.","height":257.40000000000003,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":225,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":2490.8,"width":1118},{"isDeleted":false,"locked":false,"strokeColor":"#2457c5","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#f1f3f9","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-226","x":1190,"seed":227,"boundElements":null,"y":2446.8,"opacity":100,"height":355.72,"width":1150,"frameId":null,"strokeStyle":"solid","versionNonce":228},{"seed":230,"strokeStyle":"solid","id":"t-229","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"10 · 4.4 — WHEN RETRY WON'T HELP, SELF-CORRECTION SIGNALS, SYNTAX vs SEMANTIC","fontSize":18,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"10 · 4.4 — WHEN RETRY WON'T HELP, SELF-CORRECTION SIGNALS, SYNTAX vs SEMANTIC","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":18,"originalText":"10 · 4.4 — WHEN RETRY WON'T HELP, SELF-CORRECTION SIGNALS, SYNTAX vs SEMANTIC","height":24,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":231,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1206,"angle":0,"y":2458.8,"width":1118},{"seed":233,"strokeStyle":"solid","id":"t-232","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"RETRY FIXES: format and structure errors (wrong field names, misplaced values, line items that don't sum).\n★ RETRY DOES NOT FIX: information that is ABSENT FROM THE SOURCE. If an invoice has no tax ID, retrying pressures the model into HALLUCINATING one. The\nvalidator should detect 'absent in source' and STOP with a structured null + reason.\n\nSELF-CORRECTION SIGNALS TO PUT IN THE SCHEMA:\n• calculated_total next to stated_total — validator flags the gap; computing it makes the model examine every line item, often self-correcting.\n• conflict_detected booleans — per conflict family (header vs footer date, summary count vs item count). Turns ambiguity into a ROUTABLE signal.\n• detected_pattern (or rule_id) on every finding — group developer dismissals by it to find which category is noisy. Aggregate FP rate says THAT something\nis wrong; detected_pattern says WHAT.\n\nSYNTAX vs SEMANTIC: strict tool_use/schema eliminates SYNTAX errors (malformed JSON, missing required fields, wrong types). It does NOT eliminate SEMANTIC\nerrors (values that don't sum, dates outside the document range, plausible but wrong content). Validation-retry handles those.\n\nRUNNING-NOTES TIE-IN: regex normalization patches downstream symptoms; retry-with-feedback and examples fix the generation.\n\nEXAM TELLS: 'field missing from the document' → null + reason, don't retry. 'we added a schema but line items still wrong' → semantic error → validation +\nretry.","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"RETRY FIXES: format and structure errors (wrong field names, misplaced values, line items that don't sum).\n★ RETRY DOES NOT FIX: information that is ABSENT FROM THE SOURCE. If an invoice has no tax ID, retrying pressures the model into HALLUCINATING one. The\nvalidator should detect 'absent in source' and STOP with a structured null + reason.\n\nSELF-CORRECTION SIGNALS TO PUT IN THE SCHEMA:\n• calculated_total next to stated_total — validator flags the gap; computing it makes the model examine every line item, often self-correcting.\n• conflict_detected booleans — per conflict family (header vs footer date, summary count vs item count). Turns ambiguity into a ROUTABLE signal.\n• detected_pattern (or rule_id) on every finding — group developer dismissals by it to find which category is noisy. Aggregate FP rate says THAT something\nis wrong; detected_pattern says WHAT.\n\nSYNTAX vs SEMANTIC: strict tool_use/schema eliminates SYNTAX errors (malformed JSON, missing required fields, wrong types). It does NOT eliminate SEMANTIC\nerrors (values that don't sum, dates outside the document range, plausible but wrong content). Validation-retry handles those.\n\nRUNNING-NOTES TIE-IN: regex normalization patches downstream symptoms; retry-with-feedback and examples fix the generation.\n\nEXAM TELLS: 'field missing from the document' → null + reason, don't retry. 'we added a schema but line items still wrong' → semantic error → validation +\nretry.","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"RETRY FIXES: format and structure errors (wrong field names, misplaced values, line items that don't sum).\n★ RETRY DOES NOT FIX: information that is ABSENT FROM THE SOURCE. If an invoice has no tax ID, retrying pressures the model into HALLUCINATING one. The\nvalidator should detect 'absent in source' and STOP with a structured null + reason.\n\nSELF-CORRECTION SIGNALS TO PUT IN THE SCHEMA:\n• calculated_total next to stated_total — validator flags the gap; computing it makes the model examine every line item, often self-correcting.\n• conflict_detected booleans — per conflict family (header vs footer date, summary count vs item count). Turns ambiguity into a ROUTABLE signal.\n• detected_pattern (or rule_id) on every finding — group developer dismissals by it to find which category is noisy. Aggregate FP rate says THAT something\nis wrong; detected_pattern says WHAT.\n\nSYNTAX vs SEMANTIC: strict tool_use/schema eliminates SYNTAX errors (malformed JSON, missing required fields, wrong types). It does NOT eliminate SEMANTIC\nerrors (values that don't sum, dates outside the document range, plausible but wrong content). Validation-retry handles those.\n\nRUNNING-NOTES TIE-IN: regex normalization patches downstream symptoms; retry-with-feedback and examples fix the generation.\n\nEXAM TELLS: 'field missing from the document' → null + reason, don't retry. 'we added a schema but line items still wrong' → semantic error → validation +\nretry.","height":291.72,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":234,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1206,"angle":0,"y":2490.8,"width":1118},{"isDeleted":false,"locked":false,"strokeColor":"#2457c5","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#f1f3f9","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-235","x":0,"seed":236,"boundElements":null,"y":2830.5200000000004,"opacity":100,"height":304.24,"width":1150,"frameId":null,"strokeStyle":"solid","versionNonce":237},{"seed":239,"strokeStyle":"solid","id":"t-238","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"11 · 4.4 — THE PRECISION-TUNING WORKFLOW (END TO END)","fontSize":18,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"11 · 4.4 — THE PRECISION-TUNING WORKFLOW (END TO END)","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":18,"originalText":"11 · 4.4 — THE PRECISION-TUNING WORKFLOW (END TO END)","height":24,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":240,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":2842.5200000000004,"width":1118},{"seed":242,"strokeStyle":"solid","id":"t-241","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"1) BASELINE FP/FN PER CATEGORY. Run an eval set, group findings by detected_pattern, record precision AND recall per category — not just overall.\n2) REWRITE VAGUE INSTRUCTIONS for the top-FP categories as report-when / skip-when rules with code examples on both sides (4.1).\n3) ADD 2–4 FEW-SHOT EXAMPLES per ambiguous scenario, at least one contrast pair per noisy category, inside <examples> after the instructions, before the\nlive input (4.2).\n4) WRAP IN VALIDATION-RETRY. Force the schema with tool use; validate semantic constraints (calculated_total == stated_total; a quoted source line exists);\non failure append the specific error and retry once (4.4).\n5) TRACK detected_pattern AND DISMISSALS. Sort by FP rate weekly; temporarily disable any category above threshold while iterating.\n6) EVALUATE BEFORE AND AFTER every change with the Anthropic Console Evaluation tool or Promptfoo (code-graded, model-graded, classification evals).\n\nWHY ORDER MATTERS: you can't improve what you didn't measure per category. Changing prompts without an eval set is guessing.\n\nEXAMPLE: a reviewer has 35% FP overall. Per-category numbers show 'naming' is 70% FP, others are 10%. Fix/disable 'naming' only.\n\nEXAM TELLS: 'how to know which category is noisy' → detected_pattern + per-category FP. 'verify a prompt change helped' → eval before/after, not eyeballing.","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"1) BASELINE FP/FN PER CATEGORY. Run an eval set, group findings by detected_pattern, record precision AND recall per category — not just overall.\n2) REWRITE VAGUE INSTRUCTIONS for the top-FP categories as report-when / skip-when rules with code examples on both sides (4.1).\n3) ADD 2–4 FEW-SHOT EXAMPLES per ambiguous scenario, at least one contrast pair per noisy category, inside <examples> after the instructions, before the\nlive input (4.2).\n4) WRAP IN VALIDATION-RETRY. Force the schema with tool use; validate semantic constraints (calculated_total == stated_total; a quoted source line exists);\non failure append the specific error and retry once (4.4).\n5) TRACK detected_pattern AND DISMISSALS. Sort by FP rate weekly; temporarily disable any category above threshold while iterating.\n6) EVALUATE BEFORE AND AFTER every change with the Anthropic Console Evaluation tool or Promptfoo (code-graded, model-graded, classification evals).\n\nWHY ORDER MATTERS: you can't improve what you didn't measure per category. Changing prompts without an eval set is guessing.\n\nEXAMPLE: a reviewer has 35% FP overall. Per-category numbers show 'naming' is 70% FP, others are 10%. Fix/disable 'naming' only.\n\nEXAM TELLS: 'how to know which category is noisy' → detected_pattern + per-category FP. 'verify a prompt change helped' → eval before/after, not eyeballing.","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"1) BASELINE FP/FN PER CATEGORY. Run an eval set, group findings by detected_pattern, record precision AND recall per category — not just overall.\n2) REWRITE VAGUE INSTRUCTIONS for the top-FP categories as report-when / skip-when rules with code examples on both sides (4.1).\n3) ADD 2–4 FEW-SHOT EXAMPLES per ambiguous scenario, at least one contrast pair per noisy category, inside <examples> after the instructions, before the\nlive input (4.2).\n4) WRAP IN VALIDATION-RETRY. Force the schema with tool use; validate semantic constraints (calculated_total == stated_total; a quoted source line exists);\non failure append the specific error and retry once (4.4).\n5) TRACK detected_pattern AND DISMISSALS. Sort by FP rate weekly; temporarily disable any category above threshold while iterating.\n6) EVALUATE BEFORE AND AFTER every change with the Anthropic Console Evaluation tool or Promptfoo (code-graded, model-graded, classification evals).\n\nWHY ORDER MATTERS: you can't improve what you didn't measure per category. Changing prompts without an eval set is guessing.\n\nEXAMPLE: a reviewer has 35% FP overall. Per-category numbers show 'naming' is 70% FP, others are 10%. Fix/disable 'naming' only.\n\nEXAM TELLS: 'how to know which category is noisy' → detected_pattern + per-category FP. 'verify a prompt change helped' → eval before/after, not eyeballing.","height":240.24,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":243,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":2874.5200000000004,"width":1118},{"isDeleted":false,"locked":false,"strokeColor":"#2457c5","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#f1f3f9","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-244","x":1190,"seed":245,"boundElements":null,"y":2830.5200000000004,"opacity":100,"height":355.72,"width":1150,"frameId":null,"strokeStyle":"solid","versionNonce":246},{"seed":248,"strokeStyle":"solid","id":"t-247","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"12 · 4.5 — BATCH PROCESSING: WHAT IT IS, LIMITS, WHEN TO USE","fontSize":18,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"12 · 4.5 — BATCH PROCESSING: WHAT IT IS, LIMITS, WHEN TO USE","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":18,"originalText":"12 · 4.5 — BATCH PROCESSING: WHAT IT IS, LIMITS, WHEN TO USE","height":24,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":249,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1206,"angle":0,"y":2842.5200000000004,"width":1118},{"seed":251,"strokeStyle":"solid","id":"t-250","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"BENEFITS: 50% off input AND output tokens · processing within 24 HOURS · no latency SLA (most batches finish within an hour).\n\nLIMITS: up to 100,000 requests or 256 MB per batch (whichever first) · NO streaming · NO multi-turn tool execution inside a request · prompt caching is\nbest-effort (pair with a 1-hour cache for shared context) · results retained 29 days.\n\n★ GOOD FIT: non-blocking, self-contained, high-volume work — overnight reports, weekly audits, regression-test generation, bulk evaluations, 100k-document\nextraction.\n★ POOR FIT: pre-merge checks, chat, anything where a person is waiting, or where the model must call a tool and keep reasoning in the same request.\n\nTHE DISCRIMINATOR: is someone/something BLOCKED waiting on the answer? Yes → synchronous API. No → batch.\n\nEXAMPLE: a nightly tech-debt report over 80k files → batch (nobody waiting, 50% cheaper). A PR check that gates merge → synchronous.\n\nEXAM TRAPS: 'batch for the pre-merge check to save money' → wrong. 'fallback from batch to sync on timeout' → over-complex distractor. 'batch needs the tool\nloop' → no multi-turn tools in batch.\n\nCROSS-LINK: this is the same batch-vs-real-time call as Domain 3 panel 15.","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"BENEFITS: 50% off input AND output tokens · processing within 24 HOURS · no latency SLA (most batches finish within an hour).\n\nLIMITS: up to 100,000 requests or 256 MB per batch (whichever first) · NO streaming · NO multi-turn tool execution inside a request · prompt caching is\nbest-effort (pair with a 1-hour cache for shared context) · results retained 29 days.\n\n★ GOOD FIT: non-blocking, self-contained, high-volume work — overnight reports, weekly audits, regression-test generation, bulk evaluations, 100k-document\nextraction.\n★ POOR FIT: pre-merge checks, chat, anything where a person is waiting, or where the model must call a tool and keep reasoning in the same request.\n\nTHE DISCRIMINATOR: is someone/something BLOCKED waiting on the answer? Yes → synchronous API. No → batch.\n\nEXAMPLE: a nightly tech-debt report over 80k files → batch (nobody waiting, 50% cheaper). A PR check that gates merge → synchronous.\n\nEXAM TRAPS: 'batch for the pre-merge check to save money' → wrong. 'fallback from batch to sync on timeout' → over-complex distractor. 'batch needs the tool\nloop' → no multi-turn tools in batch.\n\nCROSS-LINK: this is the same batch-vs-real-time call as Domain 3 panel 15.","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"BENEFITS: 50% off input AND output tokens · processing within 24 HOURS · no latency SLA (most batches finish within an hour).\n\nLIMITS: up to 100,000 requests or 256 MB per batch (whichever first) · NO streaming · NO multi-turn tool execution inside a request · prompt caching is\nbest-effort (pair with a 1-hour cache for shared context) · results retained 29 days.\n\n★ GOOD FIT: non-blocking, self-contained, high-volume work — overnight reports, weekly audits, regression-test generation, bulk evaluations, 100k-document\nextraction.\n★ POOR FIT: pre-merge checks, chat, anything where a person is waiting, or where the model must call a tool and keep reasoning in the same request.\n\nTHE DISCRIMINATOR: is someone/something BLOCKED waiting on the answer? Yes → synchronous API. No → batch.\n\nEXAMPLE: a nightly tech-debt report over 80k files → batch (nobody waiting, 50% cheaper). A PR check that gates merge → synchronous.\n\nEXAM TRAPS: 'batch for the pre-merge check to save money' → wrong. 'fallback from batch to sync on timeout' → over-complex distractor. 'batch needs the tool\nloop' → no multi-turn tools in batch.\n\nCROSS-LINK: this is the same batch-vs-real-time call as Domain 3 panel 15.","height":291.72,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":252,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1206,"angle":0,"y":2874.5200000000004,"width":1118},{"isDeleted":false,"locked":false,"strokeColor":"#2457c5","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#f1f3f9","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-253","x":0,"seed":254,"boundElements":null,"y":3214.2400000000007,"opacity":100,"height":390.04,"width":1150,"frameId":null,"strokeStyle":"solid","versionNonce":255},{"seed":257,"strokeStyle":"solid","id":"t-256","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"13 · 4.5 — custom_id, FAILURE HANDLING, SLA MATH","fontSize":18,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"13 · 4.5 — custom_id, FAILURE HANDLING, SLA MATH","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":18,"originalText":"13 · 4.5 — custom_id, FAILURE HANDLING, SLA MATH","height":24,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":258,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":3226.2400000000007,"width":1118},{"seed":260,"strokeStyle":"solid","id":"t-259","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"custom_id: 1–64 characters, letters/digits/underscore/hyphen only. It is the ONLY way to match results to inputs because OUTPUT ORDER IS NOT GUARANTEED.\nEmbed enough metadata to find the source record (e.g., doc-18342-p3).\n\nRESULT TYPES: succeeded · errored · canceled · expired.\n\nFAILURE HANDLING: (1) partition results by type; (2) for errors — chunk oversized documents or fix invalid parameters; (3) RESUBMIT ONLY THE FAILED\ncustom_ids as a smaller batch; (4) for expired batches, resubmit smaller or off-peak.\n\nWORKED PATTERN: create the batch → poll until processing_status is ended → iterate results → store successful tool outputs → log failures by custom_id.\n\n★ SLA MATH: submission cadence + 24 hours must fit inside the SLA.\n• 30-hour SLA → submit every 4 hours (4 + 24 = 28 ≤ 30).\n• 26-hour SLA → submit every hour (1 + 24 = 25 ≤ 26).\n• 24-hour SLA → the Batches API alone CANNOT meet it (any wait + 24h > 24h).\n\nEXAMPLE: 5% of a 10k batch errored on oversized documents. Chunk those and resubmit just those IDs — don't rerun all 10k.\n\nEXAM TELLS: 'match results to requests' → custom_id, not position. 'some requests failed' → resubmit only failed IDs. 'SLA shorter than 24h' → batch alone\ndoesn't qualify.","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"custom_id: 1–64 characters, letters/digits/underscore/hyphen only. It is the ONLY way to match results to inputs because OUTPUT ORDER IS NOT GUARANTEED.\nEmbed enough metadata to find the source record (e.g., doc-18342-p3).\n\nRESULT TYPES: succeeded · errored · canceled · expired.\n\nFAILURE HANDLING: (1) partition results by type; (2) for errors — chunk oversized documents or fix invalid parameters; (3) RESUBMIT ONLY THE FAILED\ncustom_ids as a smaller batch; (4) for expired batches, resubmit smaller or off-peak.\n\nWORKED PATTERN: create the batch → poll until processing_status is ended → iterate results → store successful tool outputs → log failures by custom_id.\n\n★ SLA MATH: submission cadence + 24 hours must fit inside the SLA.\n• 30-hour SLA → submit every 4 hours (4 + 24 = 28 ≤ 30).\n• 26-hour SLA → submit every hour (1 + 24 = 25 ≤ 26).\n• 24-hour SLA → the Batches API alone CANNOT meet it (any wait + 24h > 24h).\n\nEXAMPLE: 5% of a 10k batch errored on oversized documents. Chunk those and resubmit just those IDs — don't rerun all 10k.\n\nEXAM TELLS: 'match results to requests' → custom_id, not position. 'some requests failed' → resubmit only failed IDs. 'SLA shorter than 24h' → batch alone\ndoesn't qualify.","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"custom_id: 1–64 characters, letters/digits/underscore/hyphen only. It is the ONLY way to match results to inputs because OUTPUT ORDER IS NOT GUARANTEED.\nEmbed enough metadata to find the source record (e.g., doc-18342-p3).\n\nRESULT TYPES: succeeded · errored · canceled · expired.\n\nFAILURE HANDLING: (1) partition results by type; (2) for errors — chunk oversized documents or fix invalid parameters; (3) RESUBMIT ONLY THE FAILED\ncustom_ids as a smaller batch; (4) for expired batches, resubmit smaller or off-peak.\n\nWORKED PATTERN: create the batch → poll until processing_status is ended → iterate results → store successful tool outputs → log failures by custom_id.\n\n★ SLA MATH: submission cadence + 24 hours must fit inside the SLA.\n• 30-hour SLA → submit every 4 hours (4 + 24 = 28 ≤ 30).\n• 26-hour SLA → submit every hour (1 + 24 = 25 ≤ 26).\n• 24-hour SLA → the Batches API alone CANNOT meet it (any wait + 24h > 24h).\n\nEXAMPLE: 5% of a 10k batch errored on oversized documents. Chunk those and resubmit just those IDs — don't rerun all 10k.\n\nEXAM TELLS: 'match results to requests' → custom_id, not position. 'some requests failed' → resubmit only failed IDs. 'SLA shorter than 24h' → batch alone\ndoesn't qualify.","height":326.04,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":261,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":3258.2400000000007,"width":1118},{"isDeleted":false,"locked":false,"strokeColor":"#2457c5","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#f1f3f9","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-262","x":1190,"seed":263,"boundElements":null,"y":3214.2400000000007,"opacity":100,"height":355.72,"width":1150,"frameId":null,"strokeStyle":"solid","versionNonce":264},{"seed":266,"strokeStyle":"solid","id":"t-265","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"14 · 4.6 — MULTI-INSTANCE & MULTI-PASS REVIEW: THE IDEAS","fontSize":18,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"14 · 4.6 — MULTI-INSTANCE & MULTI-PASS REVIEW: THE IDEAS","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":18,"originalText":"14 · 4.6 — MULTI-INSTANCE & MULTI-PASS REVIEW: THE IDEAS","height":24,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":267,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1206,"angle":0,"y":3226.2400000000007,"width":1118},{"seed":269,"strokeStyle":"solid","id":"t-268","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"★ SELF-REVIEW IS WEAK. The instance that generated the output still holds its reasoning and treats its past choices as premises. A FRESH instance with no\nprior commitments finds more.\n\nPARALLEL SPECIALISTS: several agents each with a distinct focus (logic, security, edge cases), then a VERIFICATION step filters false positives. (The guide\ncites Anthropic's Code Review as using this.)\n\n★ PER-FILE + INTEGRATION (Sample Question 12): for multi-file changes run ONE FOCUSED PASS PER FILE for local issues, then ONE CROSS-FILE INTEGRATION PASS\nfor data flow, API contracts and shared types. Each file gets equal attention and you avoid contradictory findings on identical patterns.\n\nHOW TO DECIDE WHICH PASS: can you see the bug in ONE file? → per-file. Only by comparing files (renamed function, changed signature, mismatched data shape)?\n→ integration.\n\nWHAT DOESN'T FIX ATTENTION DILUTION: a bigger context window. More tokens ≠ more attention per file.\n\nEXAMPLE: a 14-file PR gets shallow, inconsistent comments in one pass. Split: 14 per-file reviews + 1 integration review.\n\nEXAM TELLS: 'large PR, shallow/contradictory feedback' → per-file + integration. 'same session reviews its own code' → use an independent instance.","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"★ SELF-REVIEW IS WEAK. The instance that generated the output still holds its reasoning and treats its past choices as premises. A FRESH instance with no\nprior commitments finds more.\n\nPARALLEL SPECIALISTS: several agents each with a distinct focus (logic, security, edge cases), then a VERIFICATION step filters false positives. (The guide\ncites Anthropic's Code Review as using this.)\n\n★ PER-FILE + INTEGRATION (Sample Question 12): for multi-file changes run ONE FOCUSED PASS PER FILE for local issues, then ONE CROSS-FILE INTEGRATION PASS\nfor data flow, API contracts and shared types. Each file gets equal attention and you avoid contradictory findings on identical patterns.\n\nHOW TO DECIDE WHICH PASS: can you see the bug in ONE file? → per-file. Only by comparing files (renamed function, changed signature, mismatched data shape)?\n→ integration.\n\nWHAT DOESN'T FIX ATTENTION DILUTION: a bigger context window. More tokens ≠ more attention per file.\n\nEXAMPLE: a 14-file PR gets shallow, inconsistent comments in one pass. Split: 14 per-file reviews + 1 integration review.\n\nEXAM TELLS: 'large PR, shallow/contradictory feedback' → per-file + integration. 'same session reviews its own code' → use an independent instance.","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"★ SELF-REVIEW IS WEAK. The instance that generated the output still holds its reasoning and treats its past choices as premises. A FRESH instance with no\nprior commitments finds more.\n\nPARALLEL SPECIALISTS: several agents each with a distinct focus (logic, security, edge cases), then a VERIFICATION step filters false positives. (The guide\ncites Anthropic's Code Review as using this.)\n\n★ PER-FILE + INTEGRATION (Sample Question 12): for multi-file changes run ONE FOCUSED PASS PER FILE for local issues, then ONE CROSS-FILE INTEGRATION PASS\nfor data flow, API contracts and shared types. Each file gets equal attention and you avoid contradictory findings on identical patterns.\n\nHOW TO DECIDE WHICH PASS: can you see the bug in ONE file? → per-file. Only by comparing files (renamed function, changed signature, mismatched data shape)?\n→ integration.\n\nWHAT DOESN'T FIX ATTENTION DILUTION: a bigger context window. More tokens ≠ more attention per file.\n\nEXAMPLE: a 14-file PR gets shallow, inconsistent comments in one pass. Split: 14 per-file reviews + 1 integration review.\n\nEXAM TELLS: 'large PR, shallow/contradictory feedback' → per-file + integration. 'same session reviews its own code' → use an independent instance.","height":291.72,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":270,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1206,"angle":0,"y":3258.2400000000007,"width":1118},{"isDeleted":false,"locked":false,"strokeColor":"#2457c5","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#f1f3f9","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-271","x":0,"seed":272,"boundElements":null,"y":3632.2800000000007,"opacity":100,"height":355.72,"width":1150,"frameId":null,"strokeStyle":"solid","versionNonce":273},{"seed":275,"strokeStyle":"solid","id":"t-274","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"15 · 4.6 — INDEPENDENT REVIEWER, CONFIDENCE ROUTING & THE DECISION MATRIX","fontSize":18,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"15 · 4.6 — INDEPENDENT REVIEWER, CONFIDENCE ROUTING & THE DECISION MATRIX","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":18,"originalText":"15 · 4.6 — INDEPENDENT REVIEWER, CONFIDENCE ROUTING & THE DECISION MATRIX","height":24,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":276,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":3644.2800000000007,"width":1118},{"seed":278,"strokeStyle":"solid","id":"t-277","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"INDEPENDENT REVIEWER (high-stakes artifacts): one call GENERATES; a SEPARATE call with a NEW system prompt and NO generator transcript looks only for\ndefects.\n\nCONFIDENCE-ANNOTATED FINDINGS: each finding carries high/medium/low confidence plus a short rationale. ROUTE: high-confidence + high-severity → blocking\ncomment; low-confidence → triage queue or a tie-breaker pass.\n\nINTERMITTENT BUGS: three full passes with majority voting can suppress bugs that are caught only some of the time (the guide lists this as an exam focus).\n\nDECISION MATRIX (from the guide):\n• Blocking pre-merge check → seconds → per-file + integration → SYNC API + strict tool_use + multi-pass.\n• Overnight tech-debt report → hours → per-file + integration → BATCH + strict tool_use + multi-pass.\n• 100k-document extraction → overnight → sample QC → BATCH + forced tool_choice + self-validating fields.\n• Interactive chat with extraction → seconds → none → SYNC + forced tool_choice + nullable fields.\n• Regulatory document QC → minutes–hours → independent reviewer → sync or batch + generator/reviewer + confidence routing.\n• Weekly cross-repo audit → days → per-repo only → BATCH + tool_use, no integration pass.\n\nEXAM TELLS: 'high-stakes, needs unbiased check' → independent reviewer with no shared transcript.","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"INDEPENDENT REVIEWER (high-stakes artifacts): one call GENERATES; a SEPARATE call with a NEW system prompt and NO generator transcript looks only for\ndefects.\n\nCONFIDENCE-ANNOTATED FINDINGS: each finding carries high/medium/low confidence plus a short rationale. ROUTE: high-confidence + high-severity → blocking\ncomment; low-confidence → triage queue or a tie-breaker pass.\n\nINTERMITTENT BUGS: three full passes with majority voting can suppress bugs that are caught only some of the time (the guide lists this as an exam focus).\n\nDECISION MATRIX (from the guide):\n• Blocking pre-merge check → seconds → per-file + integration → SYNC API + strict tool_use + multi-pass.\n• Overnight tech-debt report → hours → per-file + integration → BATCH + strict tool_use + multi-pass.\n• 100k-document extraction → overnight → sample QC → BATCH + forced tool_choice + self-validating fields.\n• Interactive chat with extraction → seconds → none → SYNC + forced tool_choice + nullable fields.\n• Regulatory document QC → minutes–hours → independent reviewer → sync or batch + generator/reviewer + confidence routing.\n• Weekly cross-repo audit → days → per-repo only → BATCH + tool_use, no integration pass.\n\nEXAM TELLS: 'high-stakes, needs unbiased check' → independent reviewer with no shared transcript.","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"INDEPENDENT REVIEWER (high-stakes artifacts): one call GENERATES; a SEPARATE call with a NEW system prompt and NO generator transcript looks only for\ndefects.\n\nCONFIDENCE-ANNOTATED FINDINGS: each finding carries high/medium/low confidence plus a short rationale. ROUTE: high-confidence + high-severity → blocking\ncomment; low-confidence → triage queue or a tie-breaker pass.\n\nINTERMITTENT BUGS: three full passes with majority voting can suppress bugs that are caught only some of the time (the guide lists this as an exam focus).\n\nDECISION MATRIX (from the guide):\n• Blocking pre-merge check → seconds → per-file + integration → SYNC API + strict tool_use + multi-pass.\n• Overnight tech-debt report → hours → per-file + integration → BATCH + strict tool_use + multi-pass.\n• 100k-document extraction → overnight → sample QC → BATCH + forced tool_choice + self-validating fields.\n• Interactive chat with extraction → seconds → none → SYNC + forced tool_choice + nullable fields.\n• Regulatory document QC → minutes–hours → independent reviewer → sync or batch + generator/reviewer + confidence routing.\n• Weekly cross-repo audit → days → per-repo only → BATCH + tool_use, no integration pass.\n\nEXAM TELLS: 'high-stakes, needs unbiased check' → independent reviewer with no shared transcript.","height":291.72,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":279,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":3676.2800000000007,"width":1118},{"isDeleted":false,"locked":false,"strokeColor":"#2457c5","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#f1f3f9","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-280","x":1190,"seed":281,"boundElements":null,"y":3632.2800000000007,"opacity":100,"height":355.72,"width":1150,"frameId":null,"strokeStyle":"solid","versionNonce":282},{"seed":284,"strokeStyle":"solid","id":"t-283","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"16 · OTHER PROMPT TECHNIQUES THE GUIDE NAMES (LIGHT COVERAGE — VERIFY IN YOUR COURSE)","fontSize":18,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"16 · OTHER PROMPT TECHNIQUES THE GUIDE NAMES (LIGHT COVERAGE — VERIFY IN YOUR COURSE)","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":18,"originalText":"16 · OTHER PROMPT TECHNIQUES THE GUIDE NAMES (LIGHT COVERAGE — VERIFY IN YOUR COURSE)","height":24,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":285,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1206,"angle":0,"y":3644.2800000000007,"width":1118},{"seed":287,"strokeStyle":"solid","id":"t-286","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"The guide's references list these techniques but does not teach them in depth. Know the one-line purpose of each:\n• CLEAR AND DIRECT: say exactly what you want, with context and the audience/purpose.\n• XML TAGS: separate instructions, examples and data (<examples>, <input>, <document>) so the model doesn't confuse them.\n• SYSTEM PROMPTS: set role and standing rules for the whole conversation.\n• CHAIN-OF-THOUGHT / extended thinking: give the model room to reason before answering; with extended thinking, examples should show reasoning patterns.\n• PREFILL: start the assistant turn yourself (e.g., with '{') to steer format. (Check current model support — tool use / structured outputs are the\npreferred route for JSON.)\n• CHAIN PROMPTS: split a job into sequential prompts (ties to Domain 1 prompt chaining).\n• REDUCE HALLUCINATIONS: have the model quote source lines before answering; allow 'I don't know'.\n• EVALS: Console Evaluation tool or Promptfoo to test changes; code-graded, model-graded, classification.\n\nWARNING: this panel is thinner than 01–15 because the study guide treats these as references. If your course sidebar has dedicated subtopics here, tell me\nand I will expand.\n\nPRIORITY ORDER the docs give: clear and direct → multishot → chain-of-thought → XML tags → system prompts → prefill → chain prompts.\n\nEXAM TELLS: for exam questions, 4.1–4.6 above dominate; this panel is background.","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"The guide's references list these techniques but does not teach them in depth. Know the one-line purpose of each:\n• CLEAR AND DIRECT: say exactly what you want, with context and the audience/purpose.\n• XML TAGS: separate instructions, examples and data (<examples>, <input>, <document>) so the model doesn't confuse them.\n• SYSTEM PROMPTS: set role and standing rules for the whole conversation.\n• CHAIN-OF-THOUGHT / extended thinking: give the model room to reason before answering; with extended thinking, examples should show reasoning patterns.\n• PREFILL: start the assistant turn yourself (e.g., with '{') to steer format. (Check current model support — tool use / structured outputs are the\npreferred route for JSON.)\n• CHAIN PROMPTS: split a job into sequential prompts (ties to Domain 1 prompt chaining).\n• REDUCE HALLUCINATIONS: have the model quote source lines before answering; allow 'I don't know'.\n• EVALS: Console Evaluation tool or Promptfoo to test changes; code-graded, model-graded, classification.\n\nWARNING: this panel is thinner than 01–15 because the study guide treats these as references. If the official course has dedicated subtopics here, expand this panel.\n\nPRIORITY ORDER the docs give: clear and direct → multishot → chain-of-thought → XML tags → system prompts → prefill → chain prompts.\n\nEXAM TELLS: for exam questions, 4.1–4.6 above dominate; this panel is background.","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"The guide's references list these techniques but does not teach them in depth. Know the one-line purpose of each:\n• CLEAR AND DIRECT: say exactly what you want, with context and the audience/purpose.\n• XML TAGS: separate instructions, examples and data (<examples>, <input>, <document>) so the model doesn't confuse them.\n• SYSTEM PROMPTS: set role and standing rules for the whole conversation.\n• CHAIN-OF-THOUGHT / extended thinking: give the model room to reason before answering; with extended thinking, examples should show reasoning patterns.\n• PREFILL: start the assistant turn yourself (e.g., with '{') to steer format. (Check current model support — tool use / structured outputs are the\npreferred route for JSON.)\n• CHAIN PROMPTS: split a job into sequential prompts (ties to Domain 1 prompt chaining).\n• REDUCE HALLUCINATIONS: have the model quote source lines before answering; allow 'I don't know'.\n• EVALS: Console Evaluation tool or Promptfoo to test changes; code-graded, model-graded, classification.\n\nWARNING: this panel is thinner than 01–15 because the study guide treats these as references. If the official course has dedicated subtopics here, expand this panel.\n\nPRIORITY ORDER the docs give: clear and direct → multishot → chain-of-thought → XML tags → system prompts → prefill → chain prompts.\n\nEXAM TELLS: for exam questions, 4.1–4.6 above dominate; this panel is background.","height":291.72,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":288,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1206,"angle":0,"y":3676.2800000000007,"width":1118},{"seed":290,"strokeStyle":"solid","id":"t-289","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"THREE KINDS OF OUTPUT PROBLEM — AND THE FIX THAT ACTUALLY MATCHES EACH","fontSize":26,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"THREE KINDS OF OUTPUT PROBLEM — AND THE FIX THAT ACTUALLY MATCHES EACH","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":26,"originalText":"THREE KINDS OF OUTPUT PROBLEM — AND THE FIX THAT ACTUALLY MATCHES EACH","height":36,"link":null,"strokeColor":"#0f3d8a","fillStyle":"solid","groupIds":[],"versionNonce":291,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":0,"angle":0,"y":4041.000000000001,"width":2400},{"isDeleted":false,"locked":false,"strokeColor":"#2457c5","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#a5d8ff","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-292","x":0,"seed":293,"boundElements":null,"y":4089.000000000001,"opacity":100,"height":215.44,"width":745,"frameId":null,"strokeStyle":"solid","versionNonce":294},{"seed":296,"strokeStyle":"solid","id":"t-295","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"SYNTAX ERRORS — FIX: tool_use + STRICT SCHEMA","fontSize":15,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"SYNTAX ERRORS — FIX: tool_use + STRICT SCHEMA","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":15,"originalText":"SYNTAX ERRORS — FIX: tool_use + STRICT SCHEMA","height":21,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":297,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":4101.000000000001,"width":713},{"seed":299,"strokeStyle":"solid","id":"t-298","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"SYMPTOM: malformed JSON, prose around JSON, missing required fields, wrong types.\nFIX: force a tool with an input_schema; strict: true or output_config.format.\nGUARANTEES: parseable output with the right shape.\nDOES NOT: check meaning or arithmetic.\nTOOL CHOICE: any (unknown doc type), forced (known step).\nSCHEMA TIPS: nullable optionals, 'other'+detail, 'unclear'.\nEXAMPLE: 'respond with JSON' sometimes adds a preamble → use a tool.\nMISTAKE: more prompt wording.\nONE WORD: SHAPE","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"SYMPTOM: malformed JSON, prose around JSON, missing required fields, wrong types.\nFIX: force a tool with an input_schema; strict: true or output_config.format.\nGUARANTEES: parseable output with the right shape.\nDOES NOT: check meaning or arithmetic.\nTOOL CHOICE: any (unknown doc type), forced (known step).\nSCHEMA TIPS: nullable optionals, 'other'+detail, 'unclear'.\nEXAMPLE: 'respond with JSON' sometimes adds a preamble → use a tool.\nMISTAKE: more prompt wording.\nONE WORD: SHAPE","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"SYMPTOM: malformed JSON, prose around JSON, missing required fields, wrong types.\nFIX: force a tool with an input_schema; strict: true or output_config.format.\nGUARANTEES: parseable output with the right shape.\nDOES NOT: check meaning or arithmetic.\nTOOL CHOICE: any (unknown doc type), forced (known step).\nSCHEMA TIPS: nullable optionals, 'other'+detail, 'unclear'.\nEXAMPLE: 'respond with JSON' sometimes adds a preamble → use a tool.\nMISTAKE: more prompt wording.\nONE WORD: SHAPE","height":154.44,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":300,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":4130.000000000001,"width":713},{"isDeleted":false,"locked":false,"strokeColor":"#0f8a7c","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#b2f2bb","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-301","x":775,"seed":302,"boundElements":null,"y":4089.000000000001,"opacity":100,"height":215.44,"width":745,"frameId":null,"strokeStyle":"solid","versionNonce":303},{"seed":305,"strokeStyle":"solid","id":"t-304","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"SEMANTIC ERRORS — FIX: VALIDATE + RETRY WITH ERROR","fontSize":15,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"SEMANTIC ERRORS — FIX: VALIDATE + RETRY WITH ERROR","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":15,"originalText":"SEMANTIC ERRORS — FIX: VALIDATE + RETRY WITH ERROR","height":21,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":306,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":791,"angle":0,"y":4101.000000000001,"width":713},{"seed":308,"strokeStyle":"solid","id":"t-307","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"SYMPTOM: schema-valid but wrong — totals don't sum, dates impossible.\nFIX: validate in code; resend original + failed output + specific error.\nSIGNALS: calculated_total, conflict_detected, detected_pattern.\nSTOP WHEN: the info is absent from the source (return null + reason).\nLIMIT: max_attempts, then escalate.\nINDEPENDENT REVIEW: fresh instance for high stakes.\nEXAMPLE: line items sum 940 vs stated 1040.\nMISTAKE: 'try again' with no error; retrying missing data.\nONE WORD: MEANING","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"SYMPTOM: schema-valid but wrong — totals don't sum, dates impossible.\nFIX: validate in code; resend original + failed output + specific error.\nSIGNALS: calculated_total, conflict_detected, detected_pattern.\nSTOP WHEN: the info is absent from the source (return null + reason).\nLIMIT: max_attempts, then escalate.\nINDEPENDENT REVIEW: fresh instance for high stakes.\nEXAMPLE: line items sum 940 vs stated 1040.\nMISTAKE: 'try again' with no error; retrying missing data.\nONE WORD: MEANING","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"SYMPTOM: schema-valid but wrong — totals don't sum, dates impossible.\nFIX: validate in code; resend original + failed output + specific error.\nSIGNALS: calculated_total, conflict_detected, detected_pattern.\nSTOP WHEN: the info is absent from the source (return null + reason).\nLIMIT: max_attempts, then escalate.\nINDEPENDENT REVIEW: fresh instance for high stakes.\nEXAMPLE: line items sum 940 vs stated 1040.\nMISTAKE: 'try again' with no error; retrying missing data.\nONE WORD: MEANING","height":154.44,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":309,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":791,"angle":0,"y":4130.000000000001,"width":713},{"isDeleted":false,"locked":false,"strokeColor":"#8a4fd1","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#eebefa","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-310","x":1550,"seed":311,"boundElements":null,"y":4089.000000000001,"opacity":100,"height":232.6,"width":745,"frameId":null,"strokeStyle":"solid","versionNonce":312},{"seed":314,"strokeStyle":"solid","id":"t-313","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"JUDGMENT ERRORS — FIX: CRITERIA + FEW-SHOT","fontSize":15,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"JUDGMENT ERRORS — FIX: CRITERIA + FEW-SHOT","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":15,"originalText":"JUDGMENT ERRORS — FIX: CRITERIA + FEW-SHOT","height":21,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":315,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1566,"angle":0,"y":4101.000000000001,"width":713},{"seed":317,"strokeStyle":"solid","id":"t-316","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"SYMPTOM: false positives, inconsistent severity, wrong escalation, format drift.\nFIX: report-when/skip-when criteria; severity definitions; 2–4 examples with reasoning + a contrast\npair.\nMEASURE: per-category FP via detected_pattern; eval before/after.\nNOT FIXES: 'be conservative', confidence thresholds, temperature 0, bold text, regex cleanup.\nDISABLE: a 40%-FP category while rebuilding it.\nPLACEMENT: <examples> after criteria, before live input.\nEXAMPLE: nitpick flood → define what to skip.\nMISTAKE: adjectives instead of checkable rules.\nONE WORD: JUDGMENT","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"SYMPTOM: false positives, inconsistent severity, wrong escalation, format drift.\nFIX: report-when/skip-when criteria; severity definitions; 2–4 examples with reasoning + a contrast\npair.\nMEASURE: per-category FP via detected_pattern; eval before/after.\nNOT FIXES: 'be conservative', confidence thresholds, temperature 0, bold text, regex cleanup.\nDISABLE: a 40%-FP category while rebuilding it.\nPLACEMENT: <examples> after criteria, before live input.\nEXAMPLE: nitpick flood → define what to skip.\nMISTAKE: adjectives instead of checkable rules.\nONE WORD: JUDGMENT","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"SYMPTOM: false positives, inconsistent severity, wrong escalation, format drift.\nFIX: report-when/skip-when criteria; severity definitions; 2–4 examples with reasoning + a contrast\npair.\nMEASURE: per-category FP via detected_pattern; eval before/after.\nNOT FIXES: 'be conservative', confidence thresholds, temperature 0, bold text, regex cleanup.\nDISABLE: a 40%-FP category while rebuilding it.\nPLACEMENT: <examples> after criteria, before live input.\nEXAMPLE: nitpick flood → define what to skip.\nMISTAKE: adjectives instead of checkable rules.\nONE WORD: JUDGMENT","height":171.6,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":318,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1566,"angle":0,"y":4130.000000000001,"width":713},{"seed":320,"strokeStyle":"solid","id":"t-319","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"★ DISCRIMINATORS — WHEN TWO ANSWERS LOOK RIGHT, THIS DECIDES IT","fontSize":26,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"★ DISCRIMINATORS — WHEN TWO ANSWERS LOOK RIGHT, THIS DECIDES IT","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":26,"originalText":"★ DISCRIMINATORS — WHEN TWO ANSWERS LOOK RIGHT, THIS DECIDES IT","height":36,"link":null,"strokeColor":"#0f3d8a","fillStyle":"solid","groupIds":[],"versionNonce":321,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":0,"angle":0,"y":4351.600000000001,"width":2400},{"isDeleted":false,"locked":false,"strokeColor":"#b4303a","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#fff0f0","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-322","x":0,"seed":323,"boundElements":null,"y":4399.600000000001,"opacity":100,"height":251.76000000000002,"width":1150,"frameId":null,"strokeStyle":"solid","versionNonce":324},{"seed":326,"strokeStyle":"solid","id":"t-325","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"1 · EXPLICIT CRITERIA  vs  'BE CONSERVATIVE' / CONFIDENCE THRESHOLD","fontSize":17,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"1 · EXPLICIT CRITERIA  vs  'BE CONSERVATIVE' / CONFIDENCE THRESHOLD","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":17,"originalText":"1 · EXPLICIT CRITERIA  vs  'BE CONSERVATIVE' / CONFIDENCE THRESHOLD","height":23,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":327,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":4411.600000000001,"width":1118},{"seed":329,"strokeStyle":"solid","id":"t-328","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"DECIDING QUESTION: Does the instruction give the model something it can CHECK?\n\nLOOK FOR → CRITERIA: 'report only when X, skip Y', 'quote the line and name the rule', concrete lists. LOOK FOR → VAGUE: 'be conservative', 'high-confidence\nonly', 'be careful'.\nAdverbs and thresholds are not mechanically checkable.\n\nHOW TO DECIDE: Can the model verify compliance before answering? Yes → criteria. No → it's a vague nudge.\n\nEXAMPLE: 'Only report high-confidence findings' leaves FP unchanged; 'report only if you can quote the exact line and rule' cuts it.\n\nWHY THE TRAP IS WRONG: The model has no calibrated notion of 'high-confidence'; it reads it as style, not a test.","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"DECIDING QUESTION: Does the instruction give the model something it can CHECK?\n\nLOOK FOR → CRITERIA: 'report only when X, skip Y', 'quote the line and name the rule', concrete lists. LOOK FOR → VAGUE: 'be conservative', 'high-confidence\nonly', 'be careful'.\nAdverbs and thresholds are not mechanically checkable.\n\nHOW TO DECIDE: Can the model verify compliance before answering? Yes → criteria. No → it's a vague nudge.\n\nEXAMPLE: 'Only report high-confidence findings' leaves FP unchanged; 'report only if you can quote the exact line and rule' cuts it.\n\nWHY THE TRAP IS WRONG: The model has no calibrated notion of 'high-confidence'; it reads it as style, not a test.","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"DECIDING QUESTION: Does the instruction give the model something it can CHECK?\n\nLOOK FOR → CRITERIA: 'report only when X, skip Y', 'quote the line and name the rule', concrete lists. LOOK FOR → VAGUE: 'be conservative', 'high-confidence\nonly', 'be careful'.\nAdverbs and thresholds are not mechanically checkable.\n\nHOW TO DECIDE: Can the model verify compliance before answering? Yes → criteria. No → it's a vague nudge.\n\nEXAMPLE: 'Only report high-confidence findings' leaves FP unchanged; 'report only if you can quote the exact line and rule' cuts it.\n\nWHY THE TRAP IS WRONG: The model has no calibrated notion of 'high-confidence'; it reads it as style, not a test.","height":188.76000000000002,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":330,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":4442.600000000001,"width":1118},{"isDeleted":false,"locked":false,"strokeColor":"#b4303a","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#fff0f0","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-331","x":1190,"seed":332,"boundElements":null,"y":4399.600000000001,"opacity":100,"height":251.76000000000002,"width":1150,"frameId":null,"strokeStyle":"solid","versionNonce":333},{"seed":335,"strokeStyle":"solid","id":"t-334","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"2 · FEW-SHOT EXAMPLES  vs  LONGER INSTRUCTIONS","fontSize":17,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"2 · FEW-SHOT EXAMPLES  vs  LONGER INSTRUCTIONS","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":17,"originalText":"2 · FEW-SHOT EXAMPLES  vs  LONGER INSTRUCTIONS","height":23,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":336,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1206,"angle":0,"y":4411.600000000001,"width":1118},{"seed":338,"strokeStyle":"solid","id":"t-337","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"DECIDING QUESTION: Is the failure about AMBIGUITY or FORMAT that words haven't pinned down?\n\nLOOK FOR → FEW-SHOT: 'inconsistent format', 'ambiguous cases', 'varied layouts', 'already rewrote the prompt twice'. LOOK FOR → INSTRUCTIONS: a missing rule\nor criterion the model never heard.\nExamples show the pattern; criteria state the rule. Often you need both.\n\nHOW TO DECIDE: If the rule is clear but application is inconsistent → examples. If the rule is missing → criteria.\n\nEXAMPLE: Escalation decisions flip-flop on borderline cases: add 2–4 examples with reasoning, including a contrast pair.\n\nWHY THE TRAP IS WRONG: Writing more adjectives doesn't add a demonstration.","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"DECIDING QUESTION: Is the failure about AMBIGUITY or FORMAT that words haven't pinned down?\n\nLOOK FOR → FEW-SHOT: 'inconsistent format', 'ambiguous cases', 'varied layouts', 'already rewrote the prompt twice'. LOOK FOR → INSTRUCTIONS: a missing rule\nor criterion the model never heard.\nExamples show the pattern; criteria state the rule. Often you need both.\n\nHOW TO DECIDE: If the rule is clear but application is inconsistent → examples. If the rule is missing → criteria.\n\nEXAMPLE: Escalation decisions flip-flop on borderline cases: add 2–4 examples with reasoning, including a contrast pair.\n\nWHY THE TRAP IS WRONG: Writing more adjectives doesn't add a demonstration.","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"DECIDING QUESTION: Is the failure about AMBIGUITY or FORMAT that words haven't pinned down?\n\nLOOK FOR → FEW-SHOT: 'inconsistent format', 'ambiguous cases', 'varied layouts', 'already rewrote the prompt twice'. LOOK FOR → INSTRUCTIONS: a missing rule\nor criterion the model never heard.\nExamples show the pattern; criteria state the rule. Often you need both.\n\nHOW TO DECIDE: If the rule is clear but application is inconsistent → examples. If the rule is missing → criteria.\n\nEXAMPLE: Escalation decisions flip-flop on borderline cases: add 2–4 examples with reasoning, including a contrast pair.\n\nWHY THE TRAP IS WRONG: Writing more adjectives doesn't add a demonstration.","height":188.76000000000002,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":339,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1206,"angle":0,"y":4442.600000000001,"width":1118},{"isDeleted":false,"locked":false,"strokeColor":"#b4303a","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#fff0f0","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-340","x":0,"seed":341,"boundElements":null,"y":4675.3600000000015,"opacity":100,"height":234.6,"width":1150,"frameId":null,"strokeStyle":"solid","versionNonce":342},{"seed":344,"strokeStyle":"solid","id":"t-343","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"3 · 2–4 EXAMPLES  vs  1 OR 10","fontSize":17,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"3 · 2–4 EXAMPLES  vs  1 OR 10","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":17,"originalText":"3 · 2–4 EXAMPLES  vs  1 OR 10","height":23,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":345,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":4687.3600000000015,"width":1118},{"seed":347,"strokeStyle":"solid","id":"t-346","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"DECIDING QUESTION: How many examples establish a pattern without overfitting?\n\nLOOK FOR → 2–4: the textbook answer. LOOK FOR → TOO FEW: 'one example'. LOOK FOR → TOO MANY: 'ten examples', 'every edge case'.\nOne example doesn't establish a pattern. Past ~4 you waste tokens and the model latches onto surface features.\n\nHOW TO DECIDE: Pick targeted ones: misbehavior cases from your eval set + a contrast pair.\n\nEXAMPLE: Reviewer over-flags: 3 examples — two real issues, one labeled not_a_finding with similar surface.\n\nWHY THE TRAP IS WRONG: Dumping 10 examples invites overfitting to incidental details.","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"DECIDING QUESTION: How many examples establish a pattern without overfitting?\n\nLOOK FOR → 2–4: the textbook answer. LOOK FOR → TOO FEW: 'one example'. LOOK FOR → TOO MANY: 'ten examples', 'every edge case'.\nOne example doesn't establish a pattern. Past ~4 you waste tokens and the model latches onto surface features.\n\nHOW TO DECIDE: Pick targeted ones: misbehavior cases from your eval set + a contrast pair.\n\nEXAMPLE: Reviewer over-flags: 3 examples — two real issues, one labeled not_a_finding with similar surface.\n\nWHY THE TRAP IS WRONG: Dumping 10 examples invites overfitting to incidental details.","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"DECIDING QUESTION: How many examples establish a pattern without overfitting?\n\nLOOK FOR → 2–4: the textbook answer. LOOK FOR → TOO FEW: 'one example'. LOOK FOR → TOO MANY: 'ten examples', 'every edge case'.\nOne example doesn't establish a pattern. Past ~4 you waste tokens and the model latches onto surface features.\n\nHOW TO DECIDE: Pick targeted ones: misbehavior cases from your eval set + a contrast pair.\n\nEXAMPLE: Reviewer over-flags: 3 examples — two real issues, one labeled not_a_finding with similar surface.\n\nWHY THE TRAP IS WRONG: Dumping 10 examples invites overfitting to incidental details.","height":171.6,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":348,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":4718.3600000000015,"width":1118},{"isDeleted":false,"locked":false,"strokeColor":"#b4303a","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#fff0f0","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-349","x":1190,"seed":350,"boundElements":null,"y":4675.3600000000015,"opacity":100,"height":251.76000000000002,"width":1150,"frameId":null,"strokeStyle":"solid","versionNonce":351},{"seed":353,"strokeStyle":"solid","id":"t-352","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"4 · tool_use + SCHEMA  vs  'RESPOND WITH JSON' PROMPT","fontSize":17,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"4 · tool_use + SCHEMA  vs  'RESPOND WITH JSON' PROMPT","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":17,"originalText":"4 · tool_use + SCHEMA  vs  'RESPOND WITH JSON' PROMPT","height":23,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":354,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1206,"angle":0,"y":4687.3600000000015,"width":1118},{"seed":356,"strokeStyle":"solid","id":"t-355","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"DECIDING QUESTION: How reliable must the output shape be?\n\nLOOK FOR → TOOL_USE: 'occasional parse errors', 'prose before the JSON', 'pipeline needs guaranteed shape'. LOOK FOR → PROMPT-ONLY: 'respond only with\nJSON'.\nPrompting for JSON is probabilistic; a forced tool with a schema (strict) is constrained.\n\nHOW TO DECIDE: Machine-consumed output → tool_use or output_config.format.\n\nEXAMPLE: Downstream script crashes on the odd markdown fence → switch to forced tool call with strict schema.\n\nWHY THE TRAP IS WRONG: Prompt-only JSON is the exam's standard distractor.","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"DECIDING QUESTION: How reliable must the output shape be?\n\nLOOK FOR → TOOL_USE: 'occasional parse errors', 'prose before the JSON', 'pipeline needs guaranteed shape'. LOOK FOR → PROMPT-ONLY: 'respond only with\nJSON'.\nPrompting for JSON is probabilistic; a forced tool with a schema (strict) is constrained.\n\nHOW TO DECIDE: Machine-consumed output → tool_use or output_config.format.\n\nEXAMPLE: Downstream script crashes on the odd markdown fence → switch to forced tool call with strict schema.\n\nWHY THE TRAP IS WRONG: Prompt-only JSON is the exam's standard distractor.","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"DECIDING QUESTION: How reliable must the output shape be?\n\nLOOK FOR → TOOL_USE: 'occasional parse errors', 'prose before the JSON', 'pipeline needs guaranteed shape'. LOOK FOR → PROMPT-ONLY: 'respond only with\nJSON'.\nPrompting for JSON is probabilistic; a forced tool with a schema (strict) is constrained.\n\nHOW TO DECIDE: Machine-consumed output → tool_use or output_config.format.\n\nEXAMPLE: Downstream script crashes on the odd markdown fence → switch to forced tool call with strict schema.\n\nWHY THE TRAP IS WRONG: Prompt-only JSON is the exam's standard distractor.","height":188.76000000000002,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":357,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1206,"angle":0,"y":4718.3600000000015,"width":1118},{"isDeleted":false,"locked":false,"strokeColor":"#b4303a","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#fff0f0","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-358","x":0,"seed":359,"boundElements":null,"y":4951.120000000002,"opacity":100,"height":251.76000000000002,"width":1150,"frameId":null,"strokeStyle":"solid","versionNonce":360},{"seed":362,"strokeStyle":"solid","id":"t-361","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"5 · SCHEMA VALID  vs  VALUE CORRECT","fontSize":17,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"5 · SCHEMA VALID  vs  VALUE CORRECT","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":17,"originalText":"5 · SCHEMA VALID  vs  VALUE CORRECT","height":23,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":363,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":4963.120000000002,"width":1118},{"seed":365,"strokeStyle":"solid","id":"t-364","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"DECIDING QUESTION: Is the problem SYNTAX or SEMANTICS?\n\nLOOK FOR → SYNTAX: malformed JSON, missing fields, wrong types. LOOK FOR → SEMANTIC: totals don't sum, wrong field populated, impossible dates, 'schema\nadded but still wrong'.\nSchemas guarantee parseability; they don't do arithmetic or truth.\n\nHOW TO DECIDE: Syntax → strict tool_use. Semantic → validate in code + retry-with-error, self-validating fields, or independent reviewer.\n\nEXAMPLE: A strict invoice schema passes, but line items total 940 vs stated 1040 → add calculated_total and a retry loop.\n\nWHY THE TRAP IS WRONG: Making the schema stricter cannot detect an arithmetic mismatch.","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"DECIDING QUESTION: Is the problem SYNTAX or SEMANTICS?\n\nLOOK FOR → SYNTAX: malformed JSON, missing fields, wrong types. LOOK FOR → SEMANTIC: totals don't sum, wrong field populated, impossible dates, 'schema\nadded but still wrong'.\nSchemas guarantee parseability; they don't do arithmetic or truth.\n\nHOW TO DECIDE: Syntax → strict tool_use. Semantic → validate in code + retry-with-error, self-validating fields, or independent reviewer.\n\nEXAMPLE: A strict invoice schema passes, but line items total 940 vs stated 1040 → add calculated_total and a retry loop.\n\nWHY THE TRAP IS WRONG: Making the schema stricter cannot detect an arithmetic mismatch.","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"DECIDING QUESTION: Is the problem SYNTAX or SEMANTICS?\n\nLOOK FOR → SYNTAX: malformed JSON, missing fields, wrong types. LOOK FOR → SEMANTIC: totals don't sum, wrong field populated, impossible dates, 'schema\nadded but still wrong'.\nSchemas guarantee parseability; they don't do arithmetic or truth.\n\nHOW TO DECIDE: Syntax → strict tool_use. Semantic → validate in code + retry-with-error, self-validating fields, or independent reviewer.\n\nEXAMPLE: A strict invoice schema passes, but line items total 940 vs stated 1040 → add calculated_total and a retry loop.\n\nWHY THE TRAP IS WRONG: Making the schema stricter cannot detect an arithmetic mismatch.","height":188.76000000000002,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":366,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":4994.120000000002,"width":1118},{"isDeleted":false,"locked":false,"strokeColor":"#b4303a","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#fff0f0","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-367","x":1190,"seed":368,"boundElements":null,"y":4951.120000000002,"opacity":100,"height":251.76000000000002,"width":1150,"frameId":null,"strokeStyle":"solid","versionNonce":369},{"seed":371,"strokeStyle":"solid","id":"t-370","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"6 · tool_choice: auto  vs  any  vs  forced","fontSize":17,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"6 · tool_choice: auto  vs  any  vs  forced","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":17,"originalText":"6 · tool_choice: auto  vs  any  vs  forced","height":23,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":372,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1206,"angle":0,"y":4963.120000000002,"width":1118},{"seed":374,"strokeStyle":"solid","id":"t-373","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"DECIDING QUESTION: Is a tool call required, and do you know which tool?\n\nLOOK FOR → AUTO: text answers are fine. LOOK FOR → ANY: 'document type unknown', several extraction tools. LOOK FOR → FORCED: 'must run extract_invoice\nfirst', retry loop.\nauto may skip tools; any must call one; forced must call that one.\n\nHOW TO DECIDE: Required? no → auto. Required + unknown which → any. Required + known → forced.\n\nEXAMPLE: Mixed batch of invoices/receipts/contracts → any; after classification → forced.\n\nWHY THE TRAP IS WRONG: auto lets the model reply in prose and break the pipeline.","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"DECIDING QUESTION: Is a tool call required, and do you know which tool?\n\nLOOK FOR → AUTO: text answers are fine. LOOK FOR → ANY: 'document type unknown', several extraction tools. LOOK FOR → FORCED: 'must run extract_invoice\nfirst', retry loop.\nauto may skip tools; any must call one; forced must call that one.\n\nHOW TO DECIDE: Required? no → auto. Required + unknown which → any. Required + known → forced.\n\nEXAMPLE: Mixed batch of invoices/receipts/contracts → any; after classification → forced.\n\nWHY THE TRAP IS WRONG: auto lets the model reply in prose and break the pipeline.","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"DECIDING QUESTION: Is a tool call required, and do you know which tool?\n\nLOOK FOR → AUTO: text answers are fine. LOOK FOR → ANY: 'document type unknown', several extraction tools. LOOK FOR → FORCED: 'must run extract_invoice\nfirst', retry loop.\nauto may skip tools; any must call one; forced must call that one.\n\nHOW TO DECIDE: Required? no → auto. Required + unknown which → any. Required + known → forced.\n\nEXAMPLE: Mixed batch of invoices/receipts/contracts → any; after classification → forced.\n\nWHY THE TRAP IS WRONG: auto lets the model reply in prose and break the pipeline.","height":188.76000000000002,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":375,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1206,"angle":0,"y":4994.120000000002,"width":1118},{"isDeleted":false,"locked":false,"strokeColor":"#b4303a","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#fff0f0","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-376","x":0,"seed":377,"boundElements":null,"y":5226.880000000002,"opacity":100,"height":234.6,"width":1150,"frameId":null,"strokeStyle":"solid","versionNonce":378},{"seed":380,"strokeStyle":"solid","id":"t-379","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"7 · REQUIRED FIELD  vs  NULLABLE FIELD","fontSize":17,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"7 · REQUIRED FIELD  vs  NULLABLE FIELD","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":17,"originalText":"7 · REQUIRED FIELD  vs  NULLABLE FIELD","height":23,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":381,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":5238.880000000002,"width":1118},{"seed":383,"strokeStyle":"solid","id":"t-382","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"DECIDING QUESTION: What should happen when the source lacks the data?\n\nLOOK FOR → NULLABLE: 'fabricated tax ID', 'invented values for missing data'. LOOK FOR → REQUIRED: the field is always present by construction.\nRequired + missing source data = the model invents something.\n\nHOW TO DECIDE: Could the document legitimately lack it? Yes → nullable.\n\nEXAMPLE: tax_id required → model hallucinates 123-45-6789 when absent. Make it [\"string\",\"null\"].\n\nWHY THE TRAP IS WRONG: 'Add a stricter prompt: never guess' is advice; a nullable schema removes the pressure.","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"DECIDING QUESTION: What should happen when the source lacks the data?\n\nLOOK FOR → NULLABLE: 'fabricated tax ID', 'invented values for missing data'. LOOK FOR → REQUIRED: the field is always present by construction.\nRequired + missing source data = the model invents something.\n\nHOW TO DECIDE: Could the document legitimately lack it? Yes → nullable.\n\nEXAMPLE: tax_id required → model hallucinates 123-45-6789 when absent. Make it [\"string\",\"null\"].\n\nWHY THE TRAP IS WRONG: 'Add a stricter prompt: never guess' is advice; a nullable schema removes the pressure.","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"DECIDING QUESTION: What should happen when the source lacks the data?\n\nLOOK FOR → NULLABLE: 'fabricated tax ID', 'invented values for missing data'. LOOK FOR → REQUIRED: the field is always present by construction.\nRequired + missing source data = the model invents something.\n\nHOW TO DECIDE: Could the document legitimately lack it? Yes → nullable.\n\nEXAMPLE: tax_id required → model hallucinates 123-45-6789 when absent. Make it [\"string\",\"null\"].\n\nWHY THE TRAP IS WRONG: 'Add a stricter prompt: never guess' is advice; a nullable schema removes the pressure.","height":171.6,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":384,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":5269.880000000002,"width":1118},{"isDeleted":false,"locked":false,"strokeColor":"#b4303a","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#fff0f0","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-385","x":1190,"seed":386,"boundElements":null,"y":5226.880000000002,"opacity":100,"height":234.6,"width":1150,"frameId":null,"strokeStyle":"solid","versionNonce":387},{"seed":389,"strokeStyle":"solid","id":"t-388","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"8 · CLOSED ENUM  vs  ENUM + 'other' + DETAIL","fontSize":17,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"8 · CLOSED ENUM  vs  ENUM + 'other' + DETAIL","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":17,"originalText":"8 · CLOSED ENUM  vs  ENUM + 'other' + DETAIL","height":23,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":390,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1206,"angle":0,"y":5238.880000000002,"width":1118},{"seed":392,"strokeStyle":"solid","id":"t-391","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"DECIDING QUESTION: Will new categories appear later?\n\nLOOK FOR → other+detail: 'new categories keep appearing', 'forced into wrong bucket'. LOOK FOR → closed: truly fixed sets.\nA closed list forces wrong picks for unseen cases.\n\nHOW TO DECIDE: If the domain evolves → add 'other' with a detail string; add 'unclear' for low confidence.\n\nEXAMPLE: Support tickets get a new type; with a closed enum they're mislabeled 'billing'. 'other' + detail captures it.\n\nWHY THE TRAP IS WRONG: Retraining or longer prompts don't fix the structural cause.","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"DECIDING QUESTION: Will new categories appear later?\n\nLOOK FOR → other+detail: 'new categories keep appearing', 'forced into wrong bucket'. LOOK FOR → closed: truly fixed sets.\nA closed list forces wrong picks for unseen cases.\n\nHOW TO DECIDE: If the domain evolves → add 'other' with a detail string; add 'unclear' for low confidence.\n\nEXAMPLE: Support tickets get a new type; with a closed enum they're mislabeled 'billing'. 'other' + detail captures it.\n\nWHY THE TRAP IS WRONG: Retraining or longer prompts don't fix the structural cause.","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"DECIDING QUESTION: Will new categories appear later?\n\nLOOK FOR → other+detail: 'new categories keep appearing', 'forced into wrong bucket'. LOOK FOR → closed: truly fixed sets.\nA closed list forces wrong picks for unseen cases.\n\nHOW TO DECIDE: If the domain evolves → add 'other' with a detail string; add 'unclear' for low confidence.\n\nEXAMPLE: Support tickets get a new type; with a closed enum they're mislabeled 'billing'. 'other' + detail captures it.\n\nWHY THE TRAP IS WRONG: Retraining or longer prompts don't fix the structural cause.","height":171.6,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":393,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1206,"angle":0,"y":5269.880000000002,"width":1118},{"isDeleted":false,"locked":false,"strokeColor":"#b4303a","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#fff0f0","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-394","x":0,"seed":395,"boundElements":null,"y":5485.480000000002,"opacity":100,"height":251.76000000000002,"width":1150,"frameId":null,"strokeStyle":"solid","versionNonce":396},{"seed":398,"strokeStyle":"solid","id":"t-397","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"9 · RETRY WITH ERROR  vs  JUST RETRY  vs  DON'T RETRY","fontSize":17,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"9 · RETRY WITH ERROR  vs  JUST RETRY  vs  DON'T RETRY","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":17,"originalText":"9 · RETRY WITH ERROR  vs  JUST RETRY  vs  DON'T RETRY","height":23,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":399,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":5497.480000000002,"width":1118},{"seed":401,"strokeStyle":"solid","id":"t-400","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"DECIDING QUESTION: Why did it fail, and is the answer in the source?\n\nLOOK FOR → RETRY WITH ERROR: format/structure/sum errors. LOOK FOR → DON'T RETRY: 'information absent from the document'. LOOK FOR → BLIND RETRY: 'try\nagain' with no feedback.\nSpecific error feedback helps; blind retry doesn't; retry on missing data forces hallucination.\n\nHOW TO DECIDE: Is the value present in the source? Yes → retry with the specific error. No → return null + reason.\n\nEXAMPLE: Invoice has no tax ID → validator marks absent_in_source and stops; no retries.\n\nWHY THE TRAP IS WRONG: Retrying invites invention to satisfy the schema.","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"DECIDING QUESTION: Why did it fail, and is the answer in the source?\n\nLOOK FOR → RETRY WITH ERROR: format/structure/sum errors. LOOK FOR → DON'T RETRY: 'information absent from the document'. LOOK FOR → BLIND RETRY: 'try\nagain' with no feedback.\nSpecific error feedback helps; blind retry doesn't; retry on missing data forces hallucination.\n\nHOW TO DECIDE: Is the value present in the source? Yes → retry with the specific error. No → return null + reason.\n\nEXAMPLE: Invoice has no tax ID → validator marks absent_in_source and stops; no retries.\n\nWHY THE TRAP IS WRONG: Retrying invites invention to satisfy the schema.","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"DECIDING QUESTION: Why did it fail, and is the answer in the source?\n\nLOOK FOR → RETRY WITH ERROR: format/structure/sum errors. LOOK FOR → DON'T RETRY: 'information absent from the document'. LOOK FOR → BLIND RETRY: 'try\nagain' with no feedback.\nSpecific error feedback helps; blind retry doesn't; retry on missing data forces hallucination.\n\nHOW TO DECIDE: Is the value present in the source? Yes → retry with the specific error. No → return null + reason.\n\nEXAMPLE: Invoice has no tax ID → validator marks absent_in_source and stops; no retries.\n\nWHY THE TRAP IS WRONG: Retrying invites invention to satisfy the schema.","height":188.76000000000002,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":402,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":5528.480000000002,"width":1118},{"isDeleted":false,"locked":false,"strokeColor":"#b4303a","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#fff0f0","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-403","x":1190,"seed":404,"boundElements":null,"y":5485.480000000002,"opacity":100,"height":251.76000000000002,"width":1150,"frameId":null,"strokeStyle":"solid","versionNonce":405},{"seed":407,"strokeStyle":"solid","id":"t-406","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"10 · calculated_total / conflict_detected / detected_pattern","fontSize":17,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"10 · calculated_total / conflict_detected / detected_pattern","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":17,"originalText":"10 · calculated_total / conflict_detected / detected_pattern","height":23,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":408,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1206,"angle":0,"y":5497.480000000002,"width":1118},{"seed":410,"strokeStyle":"solid","id":"t-409","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"DECIDING QUESTION: Which self-correction signal fits?\n\nLOOK FOR → calculated_total: numbers must reconcile. LOOK FOR → conflict_detected: sections disagree (header vs footer). LOOK FOR → detected_pattern: which\ncategory is noisy.\nEach turns a hidden problem into a measurable/routable field.\n\nHOW TO DECIDE: Arithmetic → calculated vs stated. Disagreeing sections → conflict boolean. FP analytics → detected_pattern.\n\nEXAMPLE: Overall FP 30% — detected_pattern shows naming is 70%, others 8%.\n\nWHY THE TRAP IS WRONG: Aggregate FP shows THAT something is wrong, not WHAT.","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"DECIDING QUESTION: Which self-correction signal fits?\n\nLOOK FOR → calculated_total: numbers must reconcile. LOOK FOR → conflict_detected: sections disagree (header vs footer). LOOK FOR → detected_pattern: which\ncategory is noisy.\nEach turns a hidden problem into a measurable/routable field.\n\nHOW TO DECIDE: Arithmetic → calculated vs stated. Disagreeing sections → conflict boolean. FP analytics → detected_pattern.\n\nEXAMPLE: Overall FP 30% — detected_pattern shows naming is 70%, others 8%.\n\nWHY THE TRAP IS WRONG: Aggregate FP shows THAT something is wrong, not WHAT.","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"DECIDING QUESTION: Which self-correction signal fits?\n\nLOOK FOR → calculated_total: numbers must reconcile. LOOK FOR → conflict_detected: sections disagree (header vs footer). LOOK FOR → detected_pattern: which\ncategory is noisy.\nEach turns a hidden problem into a measurable/routable field.\n\nHOW TO DECIDE: Arithmetic → calculated vs stated. Disagreeing sections → conflict boolean. FP analytics → detected_pattern.\n\nEXAMPLE: Overall FP 30% — detected_pattern shows naming is 70%, others 8%.\n\nWHY THE TRAP IS WRONG: Aggregate FP shows THAT something is wrong, not WHAT.","height":188.76000000000002,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":411,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1206,"angle":0,"y":5528.480000000002,"width":1118},{"isDeleted":false,"locked":false,"strokeColor":"#b4303a","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#fff0f0","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-412","x":0,"seed":413,"boundElements":null,"y":5761.2400000000025,"opacity":100,"height":251.76000000000002,"width":1150,"frameId":null,"strokeStyle":"solid","versionNonce":414},{"seed":416,"strokeStyle":"solid","id":"t-415","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"11 · SYNC API  vs  BATCHES API","fontSize":17,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"11 · SYNC API  vs  BATCHES API","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":17,"originalText":"11 · SYNC API  vs  BATCHES API","height":23,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":417,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":5773.2400000000025,"width":1118},{"seed":419,"strokeStyle":"solid","id":"t-418","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"DECIDING QUESTION: Is anyone blocked waiting?\n\nLOOK FOR → SYNC: 'pre-merge check', 'chat', 'user waiting', 'tool loop needed'. LOOK FOR → BATCH: 'overnight', 'weekly audit', 'bulk', 'cost matters more\nthan speed'.\nBatch = 50% cheaper but up to 24h and no streaming or multi-turn tools.\n\nHOW TO DECIDE: Blocked? yes → sync. No → batch.\n\nEXAMPLE: Nightly tech-debt report over thousands of files → batch; PR gate → sync.\n\nWHY THE TRAP IS WRONG: Batch for a merge gate can hold developers for hours.","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"DECIDING QUESTION: Is anyone blocked waiting?\n\nLOOK FOR → SYNC: 'pre-merge check', 'chat', 'user waiting', 'tool loop needed'. LOOK FOR → BATCH: 'overnight', 'weekly audit', 'bulk', 'cost matters more\nthan speed'.\nBatch = 50% cheaper but up to 24h and no streaming or multi-turn tools.\n\nHOW TO DECIDE: Blocked? yes → sync. No → batch.\n\nEXAMPLE: Nightly tech-debt report over thousands of files → batch; PR gate → sync.\n\nWHY THE TRAP IS WRONG: Batch for a merge gate can hold developers for hours.","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"DECIDING QUESTION: Is anyone blocked waiting?\n\nLOOK FOR → SYNC: 'pre-merge check', 'chat', 'user waiting', 'tool loop needed'. LOOK FOR → BATCH: 'overnight', 'weekly audit', 'bulk', 'cost matters more\nthan speed'.\nBatch = 50% cheaper but up to 24h and no streaming or multi-turn tools.\n\nHOW TO DECIDE: Blocked? yes → sync. No → batch.\n\nEXAMPLE: Nightly tech-debt report over thousands of files → batch; PR gate → sync.\n\nWHY THE TRAP IS WRONG: Batch for a merge gate can hold developers for hours.","height":188.76000000000002,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":420,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":5804.2400000000025,"width":1118},{"isDeleted":false,"locked":false,"strokeColor":"#b4303a","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#fff0f0","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-421","x":1190,"seed":422,"boundElements":null,"y":5761.2400000000025,"opacity":100,"height":234.6,"width":1150,"frameId":null,"strokeStyle":"solid","versionNonce":423},{"seed":425,"strokeStyle":"solid","id":"t-424","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"12 · custom_id  vs  RESULT ORDER","fontSize":17,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"12 · custom_id  vs  RESULT ORDER","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":17,"originalText":"12 · custom_id  vs  RESULT ORDER","height":23,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":426,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1206,"angle":0,"y":5773.2400000000025,"width":1118},{"seed":428,"strokeStyle":"solid","id":"t-427","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"DECIDING QUESTION: How do you match results to requests?\n\nLOOK FOR → custom_id: 'match results', 'which document failed'. LOOK FOR → ORDER: assuming results come back in submission order.\nOutput order isn't guaranteed.\n\nHOW TO DECIDE: Always set a unique custom_id (1–64 chars, letters/digits/_/-) carrying lookup metadata.\n\nEXAMPLE: Two documents fail validation; custom_id tells you which source records to re-run.\n\nWHY THE TRAP IS WRONG: Positional matching silently mislabels results.","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"DECIDING QUESTION: How do you match results to requests?\n\nLOOK FOR → custom_id: 'match results', 'which document failed'. LOOK FOR → ORDER: assuming results come back in submission order.\nOutput order isn't guaranteed.\n\nHOW TO DECIDE: Always set a unique custom_id (1–64 chars, letters/digits/_/-) carrying lookup metadata.\n\nEXAMPLE: Two documents fail validation; custom_id tells you which source records to re-run.\n\nWHY THE TRAP IS WRONG: Positional matching silently mislabels results.","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"DECIDING QUESTION: How do you match results to requests?\n\nLOOK FOR → custom_id: 'match results', 'which document failed'. LOOK FOR → ORDER: assuming results come back in submission order.\nOutput order isn't guaranteed.\n\nHOW TO DECIDE: Always set a unique custom_id (1–64 chars, letters/digits/_/-) carrying lookup metadata.\n\nEXAMPLE: Two documents fail validation; custom_id tells you which source records to re-run.\n\nWHY THE TRAP IS WRONG: Positional matching silently mislabels results.","height":171.6,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":429,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1206,"angle":0,"y":5804.2400000000025,"width":1118},{"isDeleted":false,"locked":false,"strokeColor":"#b4303a","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#fff0f0","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-430","x":0,"seed":431,"boundElements":null,"y":6037.000000000003,"opacity":100,"height":234.6,"width":1150,"frameId":null,"strokeStyle":"solid","versionNonce":432},{"seed":434,"strokeStyle":"solid","id":"t-433","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"13 · RESUBMIT ALL  vs  RESUBMIT FAILED custom_ids","fontSize":17,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"13 · RESUBMIT ALL  vs  RESUBMIT FAILED custom_ids","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":17,"originalText":"13 · RESUBMIT ALL  vs  RESUBMIT FAILED custom_ids","height":23,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":435,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":6049.000000000003,"width":1118},{"seed":437,"strokeStyle":"solid","id":"t-436","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"DECIDING QUESTION: What do you do after partial batch failure?\n\nLOOK FOR → FAILED ONLY: 'few errored', 'oversized documents'. LOOK FOR → ALL: wasteful rerun.\nSucceeded results are already valid and paid for.\n\nHOW TO DECIDE: Partition by succeeded/errored/canceled/expired; fix cause (chunk, fix params); resubmit only failures (smaller; off-peak if expired).\n\nEXAMPLE: 500 of 10,000 errored on size → chunk those docs and resubmit 500.\n\nWHY THE TRAP IS WRONG: Rerunning everything doubles cost for no gain.","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"DECIDING QUESTION: What do you do after partial batch failure?\n\nLOOK FOR → FAILED ONLY: 'few errored', 'oversized documents'. LOOK FOR → ALL: wasteful rerun.\nSucceeded results are already valid and paid for.\n\nHOW TO DECIDE: Partition by succeeded/errored/canceled/expired; fix cause (chunk, fix params); resubmit only failures (smaller; off-peak if expired).\n\nEXAMPLE: 500 of 10,000 errored on size → chunk those docs and resubmit 500.\n\nWHY THE TRAP IS WRONG: Rerunning everything doubles cost for no gain.","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"DECIDING QUESTION: What do you do after partial batch failure?\n\nLOOK FOR → FAILED ONLY: 'few errored', 'oversized documents'. LOOK FOR → ALL: wasteful rerun.\nSucceeded results are already valid and paid for.\n\nHOW TO DECIDE: Partition by succeeded/errored/canceled/expired; fix cause (chunk, fix params); resubmit only failures (smaller; off-peak if expired).\n\nEXAMPLE: 500 of 10,000 errored on size → chunk those docs and resubmit 500.\n\nWHY THE TRAP IS WRONG: Rerunning everything doubles cost for no gain.","height":171.6,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":438,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":6080.000000000003,"width":1118},{"isDeleted":false,"locked":false,"strokeColor":"#b4303a","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#fff0f0","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-439","x":1190,"seed":440,"boundElements":null,"y":6037.000000000003,"opacity":100,"height":234.6,"width":1150,"frameId":null,"strokeStyle":"solid","versionNonce":441},{"seed":443,"strokeStyle":"solid","id":"t-442","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"14 · SLA MATH: WHEN BATCH CAN'T MEET AN SLA","fontSize":17,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"14 · SLA MATH: WHEN BATCH CAN'T MEET AN SLA","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":17,"originalText":"14 · SLA MATH: WHEN BATCH CAN'T MEET AN SLA","height":23,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":444,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1206,"angle":0,"y":6049.000000000003,"width":1118},{"seed":446,"strokeStyle":"solid","id":"t-445","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"DECIDING QUESTION: Does submission cadence + 24h fit the SLA?\n\nLOOK FOR → FITS: 30h SLA with 4h cadence (28). LOOK FOR → NEVER FITS: 24h SLA.\nA batch can take up to 24h from submission.\n\nHOW TO DECIDE: cadence + 24 ≤ SLA? If not, batch alone fails.\n\nEXAMPLE: 26h SLA → hourly submits (25). 24h SLA → need sync API.\n\nWHY THE TRAP IS WRONG: A faster cadence can't beat the 24h processing window.","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"DECIDING QUESTION: Does submission cadence + 24h fit the SLA?\n\nLOOK FOR → FITS: 30h SLA with 4h cadence (28). LOOK FOR → NEVER FITS: 24h SLA.\nA batch can take up to 24h from submission.\n\nHOW TO DECIDE: cadence + 24 ≤ SLA? If not, batch alone fails.\n\nEXAMPLE: 26h SLA → hourly submits (25). 24h SLA → need sync API.\n\nWHY THE TRAP IS WRONG: A faster cadence can't beat the 24h processing window.","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"DECIDING QUESTION: Does submission cadence + 24h fit the SLA?\n\nLOOK FOR → FITS: 30h SLA with 4h cadence (28). LOOK FOR → NEVER FITS: 24h SLA.\nA batch can take up to 24h from submission.\n\nHOW TO DECIDE: cadence + 24 ≤ SLA? If not, batch alone fails.\n\nEXAMPLE: 26h SLA → hourly submits (25). 24h SLA → need sync API.\n\nWHY THE TRAP IS WRONG: A faster cadence can't beat the 24h processing window.","height":171.6,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":447,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1206,"angle":0,"y":6080.000000000003,"width":1118},{"isDeleted":false,"locked":false,"strokeColor":"#b4303a","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#fff0f0","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-448","x":0,"seed":449,"boundElements":null,"y":6295.600000000003,"opacity":100,"height":234.6,"width":1150,"frameId":null,"strokeStyle":"solid","versionNonce":450},{"seed":452,"strokeStyle":"solid","id":"t-451","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"15 · SELF-REVIEW  vs  INDEPENDENT REVIEWER","fontSize":17,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"15 · SELF-REVIEW  vs  INDEPENDENT REVIEWER","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":17,"originalText":"15 · SELF-REVIEW  vs  INDEPENDENT REVIEWER","height":23,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":453,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":6307.600000000003,"width":1118},{"seed":455,"strokeStyle":"solid","id":"t-454","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"DECIDING QUESTION: Does the reviewer share the generator's reasoning?\n\nLOOK FOR → INDEPENDENT: 'high-stakes', 'bias toward own decisions', 'regulatory QC'. LOOK FOR → SELF: same session asked to double-check.\nThe generator treats its prior choices as premises.\n\nHOW TO DECIDE: Fresh instance, new system prompt, only the artifact (no transcript) → independent.\n\nEXAMPLE: Code-generation session approves its own PR; a separate reviewer call finds bugs.\n\nWHY THE TRAP IS WRONG: Extended-thinking or 'review again' in the same session still carries the same commitments.","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"DECIDING QUESTION: Does the reviewer share the generator's reasoning?\n\nLOOK FOR → INDEPENDENT: 'high-stakes', 'bias toward own decisions', 'regulatory QC'. LOOK FOR → SELF: same session asked to double-check.\nThe generator treats its prior choices as premises.\n\nHOW TO DECIDE: Fresh instance, new system prompt, only the artifact (no transcript) → independent.\n\nEXAMPLE: Code-generation session approves its own PR; a separate reviewer call finds bugs.\n\nWHY THE TRAP IS WRONG: Extended-thinking or 'review again' in the same session still carries the same commitments.","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"DECIDING QUESTION: Does the reviewer share the generator's reasoning?\n\nLOOK FOR → INDEPENDENT: 'high-stakes', 'bias toward own decisions', 'regulatory QC'. LOOK FOR → SELF: same session asked to double-check.\nThe generator treats its prior choices as premises.\n\nHOW TO DECIDE: Fresh instance, new system prompt, only the artifact (no transcript) → independent.\n\nEXAMPLE: Code-generation session approves its own PR; a separate reviewer call finds bugs.\n\nWHY THE TRAP IS WRONG: Extended-thinking or 'review again' in the same session still carries the same commitments.","height":171.6,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":456,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":6338.600000000003,"width":1118},{"isDeleted":false,"locked":false,"strokeColor":"#b4303a","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#fff0f0","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-457","x":1190,"seed":458,"boundElements":null,"y":6295.600000000003,"opacity":100,"height":251.76000000000002,"width":1150,"frameId":null,"strokeStyle":"solid","versionNonce":459},{"seed":461,"strokeStyle":"solid","id":"t-460","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"16 · PER-FILE PASS  vs  INTEGRATION PASS","fontSize":17,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"16 · PER-FILE PASS  vs  INTEGRATION PASS","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":17,"originalText":"16 · PER-FILE PASS  vs  INTEGRATION PASS","height":23,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":462,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1206,"angle":0,"y":6307.600000000003,"width":1118},{"seed":464,"strokeStyle":"solid","id":"t-463","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"DECIDING QUESTION: Can you see the issue in ONE file?\n\nLOOK FOR → PER-FILE: logic bug, missing null check inside a file. LOOK FOR → INTEGRATION: renamed function, changed signature, data-shape mismatch, API\ncontract.\nCross-file bugs only exist between files.\n\nHOW TO DECIDE: One file enough → per-file. Needs comparison → integration. Large PR → run both.\n\nEXAMPLE: Function renamed in a.ts while b.ts still calls the old name → integration pass.\n\nWHY THE TRAP IS WRONG: A single huge pass dilutes attention; a bigger context window doesn't fix it.","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"DECIDING QUESTION: Can you see the issue in ONE file?\n\nLOOK FOR → PER-FILE: logic bug, missing null check inside a file. LOOK FOR → INTEGRATION: renamed function, changed signature, data-shape mismatch, API\ncontract.\nCross-file bugs only exist between files.\n\nHOW TO DECIDE: One file enough → per-file. Needs comparison → integration. Large PR → run both.\n\nEXAMPLE: Function renamed in a.ts while b.ts still calls the old name → integration pass.\n\nWHY THE TRAP IS WRONG: A single huge pass dilutes attention; a bigger context window doesn't fix it.","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"DECIDING QUESTION: Can you see the issue in ONE file?\n\nLOOK FOR → PER-FILE: logic bug, missing null check inside a file. LOOK FOR → INTEGRATION: renamed function, changed signature, data-shape mismatch, API\ncontract.\nCross-file bugs only exist between files.\n\nHOW TO DECIDE: One file enough → per-file. Needs comparison → integration. Large PR → run both.\n\nEXAMPLE: Function renamed in a.ts while b.ts still calls the old name → integration pass.\n\nWHY THE TRAP IS WRONG: A single huge pass dilutes attention; a bigger context window doesn't fix it.","height":188.76000000000002,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":465,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1206,"angle":0,"y":6338.600000000003,"width":1118},{"isDeleted":false,"locked":false,"strokeColor":"#b4303a","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#fff0f0","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-466","x":0,"seed":467,"boundElements":null,"y":6571.360000000003,"opacity":100,"height":234.6,"width":1150,"frameId":null,"strokeStyle":"solid","versionNonce":468},{"seed":470,"strokeStyle":"solid","id":"t-469","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"17 · FIX THE NOISY CATEGORY  vs  KEEP IT RUNNING","fontSize":17,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"17 · FIX THE NOISY CATEGORY  vs  KEEP IT RUNNING","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":17,"originalText":"17 · FIX THE NOISY CATEGORY  vs  KEEP IT RUNNING","height":23,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":471,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":6583.360000000003,"width":1118},{"seed":473,"strokeStyle":"solid","id":"t-472","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"DECIDING QUESTION: What if one category has a ~40% false-positive rate?\n\nLOOK FOR → DISABLE-THEN-REBUILD: 'developers ignoring everything', one noisy category. LOOK FOR → KEEP: low-FP categories.\nOne noisy category erodes trust in all categories.\n\nHOW TO DECIDE: Disable it, rebuild with criteria + examples offline, re-enable once precision clears the bar.\n\nEXAMPLE: Naming nitpicks 70% FP → remove from live prompt; keep security findings on.\n\nWHY THE TRAP IS WRONG: Letting it run drags down acceptance of real findings.","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"DECIDING QUESTION: What if one category has a ~40% false-positive rate?\n\nLOOK FOR → DISABLE-THEN-REBUILD: 'developers ignoring everything', one noisy category. LOOK FOR → KEEP: low-FP categories.\nOne noisy category erodes trust in all categories.\n\nHOW TO DECIDE: Disable it, rebuild with criteria + examples offline, re-enable once precision clears the bar.\n\nEXAMPLE: Naming nitpicks 70% FP → remove from live prompt; keep security findings on.\n\nWHY THE TRAP IS WRONG: Letting it run drags down acceptance of real findings.","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"DECIDING QUESTION: What if one category has a ~40% false-positive rate?\n\nLOOK FOR → DISABLE-THEN-REBUILD: 'developers ignoring everything', one noisy category. LOOK FOR → KEEP: low-FP categories.\nOne noisy category erodes trust in all categories.\n\nHOW TO DECIDE: Disable it, rebuild with criteria + examples offline, re-enable once precision clears the bar.\n\nEXAMPLE: Naming nitpicks 70% FP → remove from live prompt; keep security findings on.\n\nWHY THE TRAP IS WRONG: Letting it run drags down acceptance of real findings.","height":171.6,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":474,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":6614.360000000003,"width":1118},{"isDeleted":false,"locked":false,"strokeColor":"#b4303a","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#fff0f0","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-475","x":1190,"seed":476,"boundElements":null,"y":6571.360000000003,"opacity":100,"height":251.76000000000002,"width":1150,"frameId":null,"strokeStyle":"solid","versionNonce":477},{"seed":479,"strokeStyle":"solid","id":"t-478","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"18 · TEMPERATURE 0 / REGEX CLEANUP  vs  FEW-SHOT FORMAT DEMO","fontSize":17,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"18 · TEMPERATURE 0 / REGEX CLEANUP  vs  FEW-SHOT FORMAT DEMO","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":17,"originalText":"18 · TEMPERATURE 0 / REGEX CLEANUP  vs  FEW-SHOT FORMAT DEMO","height":23,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":480,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1206,"angle":0,"y":6583.360000000003,"width":1118},{"seed":482,"strokeStyle":"solid","id":"t-481","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"DECIDING QUESTION: Is it a randomness problem or an under-specified-format problem? (running notes)\n\nLOOK FOR → FEW-SHOT: 'inline citations on one doc, footnotes on another', 'format varies by document'. LOOK FOR → TRAPS: 'set temperature to 0', 'add regex\nnormalization'.\nTemperature controls word randomness, not which format counts as valid; regex patches symptoms and needs a new pattern per variant.\n\nHOW TO DECIDE: Show the exact target format in 2–4 examples (upstream fix).\n\nEXAMPLE: Citations vary in format at temp 0 → add one example per citation style, demonstrating the target.\n\nWHY THE TRAP IS WRONG: Temperature 0 narrows sampling, not the definition of 'correct format'.","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"DECIDING QUESTION: Is it a randomness problem or an under-specified-format problem? (running notes)\n\nLOOK FOR → FEW-SHOT: 'inline citations on one doc, footnotes on another', 'format varies by document'. LOOK FOR → TRAPS: 'set temperature to 0', 'add regex\nnormalization'.\nTemperature controls word randomness, not which format counts as valid; regex patches symptoms and needs a new pattern per variant.\n\nHOW TO DECIDE: Show the exact target format in 2–4 examples (upstream fix).\n\nEXAMPLE: Citations vary in format at temp 0 → add one example per citation style, demonstrating the target.\n\nWHY THE TRAP IS WRONG: Temperature 0 narrows sampling, not the definition of 'correct format'.","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"DECIDING QUESTION: Is it a randomness problem or an under-specified-format problem? (running notes)\n\nLOOK FOR → FEW-SHOT: 'inline citations on one doc, footnotes on another', 'format varies by document'. LOOK FOR → TRAPS: 'set temperature to 0', 'add regex\nnormalization'.\nTemperature controls word randomness, not which format counts as valid; regex patches symptoms and needs a new pattern per variant.\n\nHOW TO DECIDE: Show the exact target format in 2–4 examples (upstream fix).\n\nEXAMPLE: Citations vary in format at temp 0 → add one example per citation style, demonstrating the target.\n\nWHY THE TRAP IS WRONG: Temperature 0 narrows sampling, not the definition of 'correct format'.","height":188.76000000000002,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":483,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1206,"angle":0,"y":6614.360000000003,"width":1118},{"isDeleted":false,"locked":false,"strokeColor":"#b4303a","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#fff0f0","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-484","x":0,"seed":485,"boundElements":null,"y":6847.1200000000035,"opacity":100,"height":234.6,"width":1150,"frameId":null,"strokeStyle":"solid","versionNonce":486},{"seed":488,"strokeStyle":"solid","id":"t-487","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"19 · tool_use strict  vs  output_config.format","fontSize":17,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"19 · tool_use strict  vs  output_config.format","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":17,"originalText":"19 · tool_use strict  vs  output_config.format","height":23,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":489,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":6859.1200000000035,"width":1118},{"seed":491,"strokeStyle":"solid","id":"t-490","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"DECIDING QUESTION: Do you want a real tool or just structured text?\n\nLOOK FOR → tool_use: the model also acts/chooses among tools. LOOK FOR → output_config.format: pure structured output, no tool needed.\nBoth give schema-guaranteed output with the same JSON Schema subset and the same semantic limits.\n\nHOW TO DECIDE: Need the model to choose among actions → tool. Just need a shape → Structured Outputs.\n\nEXAMPLE: Classification-only response → output_config.format avoids a 'fake tool'.\n\nWHY THE TRAP IS WRONG: Neither fixes semantic errors.","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"DECIDING QUESTION: Do you want a real tool or just structured text?\n\nLOOK FOR → tool_use: the model also acts/chooses among tools. LOOK FOR → output_config.format: pure structured output, no tool needed.\nBoth give schema-guaranteed output with the same JSON Schema subset and the same semantic limits.\n\nHOW TO DECIDE: Need the model to choose among actions → tool. Just need a shape → Structured Outputs.\n\nEXAMPLE: Classification-only response → output_config.format avoids a 'fake tool'.\n\nWHY THE TRAP IS WRONG: Neither fixes semantic errors.","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"DECIDING QUESTION: Do you want a real tool or just structured text?\n\nLOOK FOR → tool_use: the model also acts/chooses among tools. LOOK FOR → output_config.format: pure structured output, no tool needed.\nBoth give schema-guaranteed output with the same JSON Schema subset and the same semantic limits.\n\nHOW TO DECIDE: Need the model to choose among actions → tool. Just need a shape → Structured Outputs.\n\nEXAMPLE: Classification-only response → output_config.format avoids a 'fake tool'.\n\nWHY THE TRAP IS WRONG: Neither fixes semantic errors.","height":171.6,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":492,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":16,"angle":0,"y":6890.1200000000035,"width":1118},{"isDeleted":false,"locked":false,"strokeColor":"#b4303a","link":null,"roughness":1,"groupIds":[],"backgroundColor":"#fff0f0","angle":0,"fillStyle":"solid","strokeWidth":1,"version":1,"roundness":{"type":3},"type":"rectangle","updated":1792537462555,"id":"r-493","x":1190,"seed":494,"boundElements":null,"y":6847.1200000000035,"opacity":100,"height":251.76000000000002,"width":1150,"frameId":null,"strokeStyle":"solid","versionNonce":495},{"seed":497,"strokeStyle":"solid","id":"t-496","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"20 · SYSTEM-PROMPT RULE  vs  FEW-SHOT + SCHEMA FOR ESCALATION","fontSize":17,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"20 · SYSTEM-PROMPT RULE  vs  FEW-SHOT + SCHEMA FOR ESCALATION","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":17,"originalText":"20 · SYSTEM-PROMPT RULE  vs  FEW-SHOT + SCHEMA FOR ESCALATION","height":23,"link":null,"strokeColor":"#0f172a","fillStyle":"solid","groupIds":[],"versionNonce":498,"textAlign":"left","fontFamily":2,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":1206,"angle":0,"y":6859.1200000000035,"width":1118},{"seed":500,"strokeStyle":"solid","id":"t-499","strokeWidth":1,"roughness":1,"isDeleted":false,"rawText":"DECIDING QUESTION: What fixes inconsistent escalation decisions? (Sample Q3)\n\nLOOK FOR → CORRECT: explicit escalation criteria + few-shot with reasoning. LOOK FOR → DISTRACTORS: self-reported confidence scores, a separate classifier\nmodel, sentiment analysis.\nThe gap is unclear boundaries, not missing signals.\n\nHOW TO DECIDE: Define when to escalate vs resolve (policy exception, value over $X, >2 prior contacts) and show examples.\n\nEXAMPLE: Insurance agent escalates unevenly → criteria + examples lifts first-contact resolution.\n\nWHY THE TRAP IS WRONG: Confidence scores are not calibrated; classifiers/sentiment add machinery without fixing the criteria.","fontSize":13,"opacity":100,"verticalAlign":"top","updated":1792537462555,"locked":false,"text":"DECIDING QUESTION: What fixes inconsistent escalation decisions? (Sample Q3)\n\nLOOK FOR → CORRECT: explicit escalation criteria + few-shot with reasoning. LOOK FOR → DISTRACTORS: self-reported confidence scores, a separate classifier\nmodel, sentiment analysis.\nThe gap is unclear boundaries, not missing signals.\n\nHOW TO DECIDE: Define when to escalate vs resolve (policy exception, value over $X, >2 prior contacts) and show examples.\n\nEXAMPLE: Insurance agent escalates unevenly → criteria + examples lifts first-contact resolution.\n\nWHY THE TRAP IS WRONG: Confidence scores are not calibrated; classifiers/sentiment add machinery without fixing the criteria.","version":1,"type":"text","backgroundColor":"transparent","roundness":null,"containerId":null,"baseline":13,"originalText":"DECIDING QUESTION: What fixes inconsistent escalation decisions? (Sample Q3)\n\nLOOK FOR → CORRECT: explicit escalation criteria + few-shot with reasoning. LOOK FOR → DISTRACTORS: self-reported confidence scores, a separate classifier\nmodel, sentiment analysis.\nThe gap is unclear boundaries, not missing signals.\n\nHOW TO DECIDE: Define when to escalate vs resolve (policy exception, value over $X, >2 prior contacts) and show examples.\n\nEXAMPLE: Insurance agent escalates unevenly → criteria + examples lifts first-contact resolution.\n\nWHY THE TRAP IS WRONG: Confidence scores are not calibrated; classifiers/sentiment add machinery without fixing the criteria.","height":188.76000000000002,"link":null,"strokeColor":"#2b2b2b","fillStyle":"solid","groupIds":[],"versionNonce":501,"textAlign":"l